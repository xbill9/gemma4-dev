# local-ollama-1650ti-2b-q4_0 — source of truth. Committed on purpose.
#
# The directory name describes; this file decides. Never copy a slot value into
# a command line — read it from here (root CLAUDE.md).
#
# The file is named tpu.env in every rig in this tree including the ones with no
# TPU in them. It is a naming wart kept for consistency, not a claim.

# ---------------------------------------------------------------------------
# Model. THE SLOT IS AN OLLAMA TAG, NOT A HUB ID, and that is a weaker claim
# than the llama.cpp sibling's MODEL_PATH.
#
# `gemma4:e2b-it-qat` is Google's QAT Q4_0 GGUF RE-CONTAINERED: Ollama strips
# the GGUF's embedded chat template, re-hashes, and serves the tensors under its
# own renderer. MEASURED here 2026-09-04 — the projector blob arrived at exactly
# 986,833,312 B, matching what gpu-ollama-g5g-2b-q4_0 read off the registry
# manifest and 352 B short of Google's own file.
#
# DO NOT point this at ~/models/.../gemma-4-E2B_q4_0-it.gguf through a Modelfile.
# It would make this a llama.cpp rig wearing an Ollama name and delete the only
# thing the A/B against the sibling can see.
# WHAT THIS RIG SERVES: the PROJECTOR-FREE variant. Built by `make text-only`
# from modelfiles/text-only.Modelfile, which is `ollama show --modelfile` of the
# stock tag with the second FROM removed and nothing else changed -- same model
# blob by digest, same RENDERER/PARSER gemma4, same three sampling parameters.
#
# WHY, MEASURED 2026-09-04 on this card:
#
#   stock tag       2762 MiB resident, capabilities: completion vision audio tools thinking
#   text-only       1612 MiB resident, capabilities: completion tools thinking
#                   -1150 MiB, and 6 MiB BELOW the llama.cpp sibling's 1618
#
# It is not only the encoder. With the projector loaded the daemon also asked
# llama-server for 2048 tokens/slot when told 1024; without it, 1024 was honoured
# -- so at 32 slots the stock tag cost an extra 192 MiB of KV on top of the
# 1154 MiB encoder, and did not fit at all (26/36 layers offloaded, 512 MiB of KV
# on the host). The text-only variant runs 32 slots entirely in VRAM at 2106 MiB.
MODEL_NAME=gemma4:e2b-it-qat-text

# The upstream tag it is derived from, and the one `make pull` fetches. Keep it
# on disk: it is the artifact gpu-ollama-g5g-2b-q4_0 serves, so it is the
# reference for any cross-rig comparison against that rig. The model blob is
# shared between the two, so keeping both costs 986 MB (the projector), not 4.3 GB.
MODEL_STOCK_TAG=gemma4:e2b-it-qat

# The plain `gemma4:e2b` tag is a DIFFERENT artifact — one 7.162 GB layer with no
# projector. Recorded so nobody "simplifies" the tag and changes the weights.
MODEL_TAG_ALTERNATIVES=gemma4:e2b
QUANTIZATION=q4_0

# ---------------------------------------------------------------------------
# Hardware. MEASURED from the driver 2026-09-04. This is a hard ceiling, not a
# quota: there is no bigger machine type to ask for.
ACCELERATOR_TYPE="NVIDIA GeForce GTX 1650 Ti with Max-Q Design"
COMPUTE_CAPABILITY=7.5
VRAM_TOTAL_MIB=4096
NVIDIA_DRIVER=610.57.04
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ---------------------------------------------------------------------------
# Runtime. THERE IS NO BUILD ON THIS RIG — that is the asymmetry against
# local-llamacpp-1650ti-2b-q4_0, which compiles llama.cpp at a pinned commit.
OLLAMA_BIN=/home/xbill/.local/bin/ollama
OLLAMA_VERSION=0.33.2

# PIN THE CUDA VARIANT. The bundle ships cuda_v12 and cuda_v13 and Ollama picks
# between them BY DRIVER VERSION. 610.57.04 is a CUDA 13 driver, so unpinned it
# selects cuda_v13 — which on the arm64 bundle was measured to be PTX-only for
# sm_75, meaning every kernel is JIT-compiled at load. That works and it makes
# warm-up a property of the deployment while recording it as a property of the
# engine.
#
# UNVERIFIED ON THIS x86_64 BUNDLE: the fatbin walk behind that claim was done on
# gpu-ollama-g5g-2b-q4_0's linux-arm64 tarball. Pinned here on the sibling's
# reasoning and because the llama.cpp sibling builds native sm_75, which is what
# makes the pair comparable. Confirm from the daemon log, which names the library
# it loaded.
OLLAMA_LLM_LIBRARY=cuda_v12

# THERE IS NO N_GPU_LAYERS HERE and its absence is real, not an oversight.
# llama-server takes --n-gpu-layers; Ollama decides the offload itself from its
# own VRAM estimate and exposes only OLLAMA_GPU_OVERHEAD as a nudge. On a 4096
# MiB card that is the single largest behavioural difference from the sibling:
# partial offload cannot be prevented by configuration here, only DETECTED —
# which is what verify_model_resident does.

# ---------------------------------------------------------------------------
# Endpoint. Known before the process starts; there is no discovery chain to walk
# and hardcoding it is correct here (NAMING.md, "`local` is the absence of a
# control plane").
#
# Ollama's own default is 11434. Pinned to 8000 to match the g5g sibling so one
# sweep command works against both — and deliberately NOT 8080, which is the
# llama.cpp local rig's port, so the pair can be up at once.
HOST=127.0.0.1
PORT=8000
ENDPOINT=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Serving shape.
#
# CONTEXT IS PER-SEQUENCE HERE AND PER-SERVER IN THE SIBLING. llama.cpp SPLITS
# --ctx-size across --parallel slots; Ollama MULTIPLIES OLLAMA_CONTEXT_LENGTH by
# OLLAMA_NUM_PARALLEL. Same total, opposite convention, and nothing announces it.
# The sibling's concurrency server was `-c 32768 --parallel 32` = 1024 tok/slot,
# so the equivalent here is 1024 x 32, NOT 32768 x 32.
#
# AND THE MULTIPLY HAS A FLOOR THAT APPLIES ONLY TO MULTIMODAL MODELS.
# MEASURED 2026-09-04 from the child's command line in run/ollama.log:
#
#   model        asked        llama-server got     per slot
#   stock        1024 x 1     -c 2048  -np 1       2048   <- raised
#   stock        1536 x 1     -c 2048  -np 1       2048   <- raised
#   stock        8192 x 1     -c 8192  -np 1       8192   <- above the floor
#   text-only    1024 x 1     -c 1024  -np 1       1024   <- honoured
#   text-only    1536 x 1     -c 1536  -np 1       1536   <- honoured
#   text-only    1024 x 32    -c 32768 -np 32      1024   <- honoured
#
# A projector-carrying model gets a 2048-token minimum per slot; a text-only one
# is honoured exactly. 8192 clears the floor either way, which is why the context
# sweep never saw it. This is why the stock tag could not hold 32 slots on this
# card: 2048/slot doubled the non-SWA KV, and with the 1154 MiB encoder on top the
# daemon offloaded only 26/36 layers and put 512 MiB of KV in host RAM.
#
# MODEL_NAME is projector-free, so the values below are taken literally. Still
# read the child's -c off the log rather than predicting it.
OLLAMA_CONTEXT_LENGTH=8192 NUM_PARALLEL=1   -> llama-server -c 8192  -np 1
#   OLLAMA_CONTEXT_LENGTH=1024 NUM_PARALLEL=32  -> llama-server -c 65536 -np 32
#   OLLAMA_CONTEXT_LENGTH=1024 NUM_PARALLEL=8   -> llama-server -c 16384 -np 8
#
# 65536 is 2048 x 32, not 1024 x 32: the requested 1024 was RAISED to 2048 per
# slot. So you cannot ask this daemon for the sibling's 1024-token slots at all,
# and at NUM_PARALLEL=32 the doubled KV that follows does not fit a 4096 MiB card:
# only 26/36 layers were offloaded and 512 MiB of 768 MiB of KV went to host RAM.
# NUM_PARALLEL=8 fits (36/36 layers, 2900 MiB). The floor read 2048 at both np
# values tried; it has NOT been characterised across requested context lengths.
# Read the child's -c off the log rather than predicting it.
#
# Ollama's own default is 0, meaning "4k/32k/256k depending on VRAM" — an
# unpinned rig gets a different context on different hardware silently.
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=1

# KEEP THE MODEL LOADED. Ollama unloads after 5 minutes idle by default, so a
# sweep that pauses between cells pays a full reload and records it as latency.
# Negative means forever. No sibling needs this: llama-server, vLLM and our own
# JAX and PyTorch servers hold the weights for the life of the process.
OLLAMA_KEEP_ALIVE=-1

# Where the blob store lives. 4.3 GB for this tag.
OLLAMA_MODELS=/home/xbill/.ollama/models
