# gpu-vllm-t4-embed2 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (root CLAUDE.md, @NAMING.md). Committed
# on purpose and NOT gitignored. A real environment variable always wins over it.
#
# STATUS 2026-10-07: SERVING AND MEASURED, once. vLLM 0.31.1rc1.dev63+gd169c5a90
# serves EmbeddingGemma 2 on /v1/embeddings at float32, text + image, matching
# sentence-transformers 6.1.0 to 1-cos <= 7.0e-9.
# `benchmarks/runs/2026-10-07-first-serve-t4/REPORT.md` holds every number below
# that says MEASURED.
#
# FORKED 2026-10-07 FROM `gpu-vllm-t4-2b`, and the T4 and host facts are that
# rig's (same VM, same GPU). Read its tpu.env for the three filesystems, the two
# interpreters and the swapfile. This file carries what differs.

# --- Model -------------------------------------------------------------------
# EmbeddingGemma 2 (released 2026-10-06): a bidirectional, Gemma 4-derived
# multimodal EMBEDDING model, `EmbeddingGemma2Model`. 768-d output, mean pooling,
# L2 normalised, Matryoshka-trained at 512/256/128, 8,192-token context. Text
# encoder 24 layers, hidden 512, sliding window 512 with every sixth layer full
# attention (head_dim 256 sliding / 512 full, 1 KV head on the full layers). Vision
# tower 167.8M, audio tower 305.6M, text 271.0M (vLLM PR #60254).
#
# Slot 4 is `embed2`: the checkpoint has no Gemma 4 size (@NAMING.md slot 4).
MODEL_NAME=google/embeddinggemma-2
# Pinned to the snapshot the 2026-10-07 run measured. Blank to follow `main`.
MODEL_REVISION=914f7f89142e33e77833254d9c9b90c3cef7303b
# One bf16 safetensors file, MEASURED from the Hub 2026-10-07 (x-linked-size).
MODEL_SAFETENSORS_BYTES=1488915288
EMBEDDING_DIM=768

# --- Hardware ------------------------------------------------------------------
# The T4 `gpu-vllm-t4-2b` MEASURED 2026-09-17: SM 7.5, 15360 MiB, driver 615.71.09.
# Shared with the generative T4 rigs: one GPU, one port, one server at a time.
ACCELERATOR_TYPE=nvidia-tesla-t4
CHIP_COUNT=1
COMPUTE_CAPABILITY=7.5
GPU_TOTAL_MIB=15360
TENSOR_PARALLEL_SIZE=1

HOST_PLATFORM=gce
HOST_MACHINE_TYPE=n1-standard-2
HOST_ZONE=us-west2-b
HOST_VCPU=2
HOST_RAM_TOTAL_BYTES=7797587968

# --- Serving -------------------------------------------------------------------
# float32, and NOT for the reason the generative siblings avoid bf16. Google:
# float16 is incompatible with this model. Turing has no bf16 datapath, and vLLM
# casts bf16 to fp16 on SM 7.5 without failing, so `bfloat16` here would quietly
# serve the forbidden dtype. float32 doubles the weights (1.03 GiB text only,
# 1.63 GiB with vision, MEASURED) and is still nowhere near the 15 GiB.
#
# float32 IS ALSO WHAT BREAKS THE ATTENTION KERNEL, see
# patch_triton_encoder_turing.py: the 512-wide layers fit no fp32 Triton tile on
# this part, so that one kernel runs in fp16 with fp32 accumulation. Parity says
# that costs nothing measurable (1-cos <= 7.0e-9 end to end).
DTYPE=float32

RUNNER=pooling
MAX_MODEL_LEN=8192

# Vision on, audio and video off. MEASURED 2026-10-07: image embeddings serve and
# rank correctly against text queries (evidence/matryoshka-and-vision.txt); image
# PARITY against sentence-transformers is UNMEASURED (the reference does not fit
# in host RAM beside the server). Audio is untried: it needs the vllm[audio]
# extras, which the lock does not include. Video is untried. Set image to 0 for a
# text-only server: 96 s to healthy instead of 177 s and ~0.6 GiB less.
LIMIT_MM_PER_PROMPT={"image":1,"audio":0,"video":0}

# config.json declares no Matryoshka sizes, so without this vLLM rejects every
# `dimensions` request ("does not support Matryoshka embeddings"). Listing the
# four sizes Google recommends (rather than `is_matryoshka: true`, which admits
# any 1..768) makes an untrained size a loud 400. MEASURED: dimensions=256 equals
# the renormalised 256-prefix of the full vector to 4e-8.
HF_OVERRIDES={"matryoshka_dimensions":[768,512,256,128]}

# The trained task prefixes (`task: search result | query: `, `title: none |
# text: `) are NOT set here: each ends in a space, and the Makefile's
# `include tpu.env` + `export` would hand any quotes to the environment, where
# they beat dotenv. They are model facts, so they live in server.py.

# NOT SET, deliberately: GPU_MEMORY_UTILIZATION, KV_CACHE_DTYPE, MAX_NUM_SEQS and
# TURING_SMEM_BUDGET. There is no KV cache — encoder-only layers have no KV spec —
# and the engine MEASURED ~2 GB of device memory in use with vision on. The
# sibling's smem budget belongs to the decoder kernel, which never runs here.

# --- Endpoint ------------------------------------------------------------------
# Same port as the generative T4 rigs: they cannot run at the same time anyway
# (one GPU), and `server_status` reports the served model id so a healthy :8000
# is never mistaken for this model.
HOST=127.0.0.1
PORT=8000
ENDPOINT=http://127.0.0.1:8000

# --- Install: this rig's OWN user base -----------------------------------------
# /usr/bin/python3.13 with PYTHONUSERBASE on /opt1, as in the sibling — but a
# DIFFERENT user base. `/opt1/pyuser` holds the generative rigs' vLLM 0.29.0 with
# their decoder clamp applied. This model needs vLLM support that is in no
# release (`02b83919aa`, 2026-10-06) and transformers >= 5.19.0, and upgrading
# /opt1/pyuser to get them would break both siblings and revert their patch.
# A relocated PYTHONUSERBASE is still not a virtualenv (root CLAUDE.md).
PYTHON_BIN=/usr/bin/python3.13
PYTHONUSERBASE=/opt1/pyuser-embed2
PIP_CACHE_DIR=/opt1/pipcache
TMPDIR=/opt1/tmp

# INSTALLED 2026-10-07 from a uv-resolved lock (pip's own resolver backtracked
# through every filelock and httpx2 release for 20+ minutes and was killed):
#   vllm 0.31.1rc1.dev63+gd169c5a90 (per-commit wheel), torch 2.13.0+cu130,
#   transformers 5.19.0, triton 3.7.1, sentence-transformers 6.1.0
# The lock is benchmarks/runs/2026-10-07-first-serve-t4/evidence/requirements-lock.txt.
# THE NIGHTLY INDEX LISTS ONLY ITS NEWEST WHEEL, so a `vllm==<nightly version>`
# pin stops resolving within hours. Pin the per-commit URL, as the lock does.
VLLM_PIP_SPEC=https://wheels.vllm.ai/d169c5a90354233d2acec687aec201971fa135fb/vllm-0.31.1rc1.dev63%2Bgd169c5a90-cp38-abi3-manylinux_2_28_x86_64.whl

CUDA_DRIVER_VERSION=615.71.09
