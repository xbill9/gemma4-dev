# gpu-litertlm-g6-2b-int248 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md). Committed on purpose and NOT
# gitignored. Override a value on the make command line; render_config.py honours os.environ.
#
# ADDED 2026-11-05, forked from local-litertlm-3050oem-2b-int248 for the G6 serving-engine flight.
# Slots 1 and 3 differ; the file, LiteRT-LM version and settings are the 3050 rig's. NOTHING BELOW IS
# MEASURED ON THE L4 YET. Instance: gpu-pytorch-g6-2b-q4w4a16's create_g6_instance.

# ── Model (the 3050 rig's file, by hash) ─────────────────────────────────────
MODEL_NAME=litert-community/gemma-4-E2B-it-litert-lm
MODEL_FILE=gemma-4-E2B-it.litertlm
MODEL_HF_REVISION=cbb97a3e73fd566bd089ca762461458c78ed4761
MODEL_PATH=/opt/models/litert/gemma-4-E2B-it.litertlm
MODEL_SHA256=181938105e0eefd105961417e8da75903eacda102c4fce9ce90f50b97139a63c
QUANTIZATION=int248
MODEL_ID=gemma-4-e2b
LITERT_LM_DIR=/opt/cache/gpu-litertlm-g6-2b-int248

# ── Hardware ─────────────────────────────────────────────────────────────────
# LiteRT-LM reaches an NVIDIA card through WebGPU (Dawn) on Vulkan, not CUDA (measured on the 3050).
# It needs libvulkan1 and the NVIDIA Vulkan ICD. UNVERIFIED on the DLAMI: whether its driver install
# ships nvidia_icd.json and whether a headless L4 enumerates a Vulkan device. `make vulkan` checks
# both before the first serve.
INSTANCE_TYPE=g6.2xlarge
AWS_REGION=us-east-1
ACCELERATOR_TYPE="NVIDIA L4"
COMPUTE_CAPABILITY=8.9
VRAM_TOTAL_MIB=23034
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# The instance's system python3 (Ubuntu 26.04: 3.14), user site, the same interpreter as the vLLM and
# SGLang G6 rigs. protobuf >= 6.31.1 (requirements.txt), as on the 3050.
LITERT_LM_VERSION=0.19.0
PROTOBUF_VERSION=7.36.2
PYTHON=/usr/bin/python3

# ── Serving (the 3050 rig's values) ──────────────────────────────────────────
HOST=127.0.0.1
PORT=9379
ENDPOINT=http://127.0.0.1:9379
BACKEND=gpu
CACHE=disk
# The built-in MTP drafter. The flight runs it both ways (litert-int248 off, litert-int248-d on).
SPECULATIVE_DECODING=on
MAX_NUM_TOKENS=
