# gpu-sglang-t4-2b-q4_0 — SGLang on the Tesla T4 (GCE n1-standard-2), Gemma 4 E2B QAT Q4_0 grid in 16-bit storage.
# Forked 2026-11-05 from local-sglang-3050oem-2b-q4w4a16emb4 for the T4 engine comparison; same SGLang version
# and patches plus patches/turing-smem.diff. Comments below describe the 3050 rig unless they say otherwise.
# Source of truth for serve.py and the Makefile; a real environment variable wins over this file.

# ── Checkpoint ──────────────────────────────────────────────────────────────
# NOT the 3050 rig's W4A16 checkpoint: SGLang 0.5.23's JIT Marlin (sglang/kernels/jit/csrc/gemm/marlin) compiles to
# empty kernels below sm_80 (`#if __CUDA_ARCH__ < 800`) and its WNA16 scheme refuses capability < 80. Google's
# QAT export stores the same Q4_0-grid values in bf16 (served float16 here): same weights by value, 16-bit
# storage, 9.6 GB. Multimodal checkpoint (Gemma4ForConditionalGeneration).
MODEL_NAME=google/gemma-4-E2B-it-qat-q4_0-unquantized
MODEL_REVISION=6befbaca7398925921802abd1f277b495b78b738
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
ACCELERATOR_TYPE="Tesla T4"
COMPUTE_CAPABILITY=7.5
VRAM_TOTAL_MIB=15360

# ── Stack ────────────────────────────────────────────────────────────────────
# sglang 0.5.23 ships cp311-cp313 wheels only; the system python is 3.14. make install installs the cp313
# wheel retagged for cp314 with --no-deps (its five Rust extensions are cp313 builds and stay unloaded on
# the HTTP path), then only the requirements that are missing, also --no-deps. Installed packages keep
# their versions over sglang's pins (transformers 5.16.1, compressed-tensors 0.17.0, openai 3.43.0, ...).
SGLANG_VERSION=0.5.23
SGLANG_KERNEL_VERSION=0.4.10
TORCH_VERSION=2.14.0+cu130

# ── This host (MEASURED 2026-11-05) ──────────────────────────────────────────
# sglang 0.5.23 cp313 wheel (native for 3.13, no retag) --no-deps into the user base vLLM 0.33 uses; it pins
# torch 2.14.1 and runs on the 2.14.0 vLLM pins. Only additions, no version changed
# (/opt1/tmp/freeze-{before,after}-sglang-2026-11-05.txt).
# sglang-kernel ships sm_90/sm_100 builds only; on sm_75 its norm ops fall through to FlashInfer's JIT, which
# compiles with nvcc from CUDA_HOME and needs curand_kernel.h. The /opt1/cuda-13.4 toolkit has no curand
# headers, and the pip nvidia/cu13/include set is CUDA 13.0 and clashes with 13.4's, so CPATH points at a
# directory holding symlinks to only the curand headers from that set.
PYTHON_BIN=/usr/bin/python3.13
PYTHONUSERBASE=/opt1/pyuser-engines
CUDA_HOME=/opt1/cuda-13.4
CPATH=/opt1/cuda-extra-include
# Turing has no bfloat16.
DTYPE=float16

# ── Serving ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8030
ENDPOINT=http://127.0.0.1:8030
# T4: 0.88, not the 3050 rig's 0.80. With 10 GB of 16-bit weights, 0.80 leaves a 18,210-token full-attention
# cache and no room for the drafter (SWA pool cap error); 0.88 held 104,831 without it (2026-11-05).
MEM_FRACTION_STATIC=0.88
CONTEXT_LENGTH=16384
MAX_RUNNING_REQUESTS=64
TOOL_CALL_PARSER=gemma4
REASONING_PARSER=gemma4
# true = no radix (prefix) cache, so a repeated prompt is read in full
DISABLE_RADIX_CACHE=true
# true = decode CUDA graphs only. Prefill graph capture refuses Gemma 4's KV-shared layers (layers 15-34
# reuse an earlier layer's attention id: "invalid or duplicate attention layer_id: 13").
DISABLE_PREFILL_CUDA_GRAPH=true
# Decode graphs up to MAX_RUNNING_REQUESTS. Unset, SGLang sizes them from card memory and captures only
# 1, 2, 4 and 8 on this card, so 16-64 requests would run without graphs.
CUDA_GRAPH_MAX_BS_DECODE=64
# Empty = no drafter. Google's assistant through --speculative-algorithm NEXTN (SGLang promotes it to
# FROZEN_KV_MTP for Gemma4AssistantForCausalLM).
SPECULATIVE_MODEL=
SPECULATIVE_NUM_STEPS=2
