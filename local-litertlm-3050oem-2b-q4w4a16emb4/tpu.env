# local-litertlm-3050oem-2b-q4w4a16emb4 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md). Committed on
# purpose and NOT gitignored. Override a value on the make command line.
#
# ADDED 2026-11-02, the sister of local-litertlm-3050oem-2b-int248: same card, runtime
# and serving path; slot 5 is the only slot that differs. That rig serves Google's own
# .litertlm (int2/int4/int8, one scale per row); this one serves a .litertlm built here
# that holds the QAT Q4_0 grid exactly.

# ── Model ────────────────────────────────────────────────────────────────────
# Built locally by build.sh, not downloaded: there is no published artifact.
#  1. QAT_SOURCE converted by litert-torch 0.10.0 with int4 blocks of 32 and GPU
#     composites (q/k/v and gate/up fused).
#  2. Every int4 tensor (214; 5,030,936,576 codes) overwritten with REPACK_SOURCE's
#     codes (-8..7) and fp16 scales by repack_litertlm.py, re-read and checked equal.
#     The converter's own codes (-7..7, scale max|w|/7) differed in 6.6-18.0% per tensor.
#  3. Bundled with the tokenizer and LLM metadata taken from TOKENIZER_FROM.
# MODEL_SHA256 is the 2026-11-02 build; a rebuild with the same tools should match it
# (UNVERIFIED: the build has run once).
MODEL_NAME=local:gemma-4-E2B-it-qat-q4_0-w4a16-emb4.litertlm
MODEL_PATH=/home/xbill/models/litert/gemma-4-E2B-it-qat-q4_0-w4a16-emb4.litertlm
MODEL_SHA256=c880dac6f1e7a6f72a222bf4192fc3267c13e8c3278fabaecefedfcc488da8bb
QUANTIZATION=q4w4a16emb4

QAT_SOURCE=google/gemma-4-E2B-it-qat-q4_0-unquantized
QAT_SOURCE_REVISION=6befbaca7398925921802abd1f277b495b78b738
REPACK_SOURCE=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text-emb4
REPACK_SOURCE_REVISION=db715f83da4f13289761d7c45f4d19ceac84695d
TOKENIZER_FROM=/home/xbill/models/litert/gemma-4-E2B-it.litertlm
TOKENIZER_FROM_SHA256=181938105e0eefd105961417e8da75903eacda102c4fce9ce90f50b97139a63c

# Build tools and intermediates (~10 GB; the export peaks near 45 GB of RAM on this 46 GB host).
CONVERTER_DIR=/home/xbill/.cache/local-litertlm-3050oem-2b-q4w4a16emb4/litert-torch-0.10.0
BUILD_DIR=/home/xbill/.cache/local-litertlm-3050oem-2b-q4w4a16emb4/build

MODEL_ID=gemma-4-e2b-q4exact
LITERT_LM_DIR=/home/xbill/.cache/local-litertlm-3050oem-2b-q4w4a16emb4

# ── Hardware ─────────────────────────────────────────────────────────────────
# Same card and host as local-litertlm-3050oem-2b-int248; WebGPU on Vulkan.
ACCELERATOR_TYPE="NVIDIA GeForce RTX 3050 OEM"
COMPUTE_CAPABILITY=8.6
VRAM_TOTAL_MIB=8192
NVIDIA_DRIVER=615.78.08
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
LITERT_LM_VERSION=0.19.0
PROTOBUF_VERSION=7.36.2

# ── Serving ──────────────────────────────────────────────────────────────────
# 9380, not 9379, so this and the int248 rig can be told apart (both fit on the card).
HOST=127.0.0.1
PORT=9380
ENDPOINT=http://127.0.0.1:9380
BACKEND=gpu
CACHE=disk
# The build has no drafter section.
SPECULATIVE_DECODING=off
MAX_NUM_TOKENS=
