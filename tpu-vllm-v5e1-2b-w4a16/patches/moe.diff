+            f"'{prefix}' is not supported in the JAX path.")
+
+
+def _wna16_moe_method(scheme, weight_quant, ct,
+                      prefix: str) -> WNA16FusedMoEMethod:
+    _check_w4a16_layout(scheme, weight_quant, ct, prefix)
+    group_size = weight_quant.group_size
