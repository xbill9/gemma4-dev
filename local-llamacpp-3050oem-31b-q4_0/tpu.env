# local-llamacpp-3050oem-31b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# FORKED 2026-10-18 from local-llamacpp-3050oem-26b-q4_0, its 26B A4B sister on the same
# card, host and llama.cpp binary. Slot 4 is the only slot that differs. Every serving
# value below was measured on this rig in benchmarks/runs/2026-10-18-first-light-3050oem.

# ── Model ────────────────────────────────────────────────────────────────────
# Google's 31B QAT GGUF, unmodified: google/gemma-4-31B-it-qat-q4_0-gguf at revision
# 59dde24573e7e61570dba08b18a2e1fe246955ed. 17,651,001,568 B; SHA-256 matches the Hub's LFS oid.
# Dense: 60 layers of 257-287 MiB (15,716 MiB, Q4_0) plus token_embd 1,102 MiB (Q6_K), F32
# norms (gguf-layout.txt). Text only: the mmproj file is not loaded.
MODEL_NAME=google/gemma-4-31B-it-qat-q4_0-gguf
MODEL_PATH=/home/xbill/models/gemma-4-31B-it-qat-q4_0-gguf/gemma-4-31B_q4_0-it.gguf
MODEL_SHA256=179cfb99212709597eae5929112cfca677e1bbf566178b479ae1da0c4772874b

# Slot 5: every weight matrix Q4_0 except token_embd (Q6_K), as for the 26B sister.
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED-STATIC 2026-10-13, `nvidia-smi --query-gpu=name,compute_cap,memory.total,
# memory.free,driver_version,pci.device_id`: PCI 10de:2508, GA106. Ampere, sm_86,
# with tensor cores (the parent's TU117 has none). Host: ASUS X99-A, i7-5820K
# (6C/12T Haswell-E, AVX2, no AVX-512), 46 GiB RAM, hostname `gpu`.
ACCELERATOR_TYPE="NVIDIA GeForce RTX 3050 OEM"
COMPUTE_CAPABILITY=8.6
VRAM_TOTAL_MIB=8192
VRAM_FREE_MIB=7875
NVIDIA_DRIVER=615.78.08
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# Cloned fresh 2026-10-13 and built with `make build`: GGML_CUDA=ON, CUDA_ARCH=86,
# GGML_NATIVE=ON, Release, FORCE_MMQ off. gcc 16.2.0, CUDA 13.4 (V13.4.92) at
# /usr/local/cuda, which is NOT on PATH by default on this host. The checkout was
# fast-forwarded and rebuilt 2026-10-16 11:32 (reflog); every 31B measurement is on
# that build.
LLAMA_CPP_DIR=/home/xbill/llama.cpp
LLAMA_CPP_COMMIT=7182ef71e
LLAMA_SERVER_BIN=/home/xbill/llama.cpp/build/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# The endpoint is not discovered. It is known before the process starts, which
# is the one place CLAUDE.md's "never hardcode an endpoint" rule does not apply
# — there is no QR -> node -> external IP chain here to walk.
#
# HOST=0.0.0.0 since 2026-10-13: listen on every interface so the LAN can reach
# it (eno1 is 192.168.0.156). No auth and no firewall on this host, so anyone on
# the LAN can use it. ENDPOINT stays on loopback: it is what the Makefile, the
# MCP server and sweep.py call, and 127.0.0.1 reaches a 0.0.0.0 listener.
HOST=0.0.0.0
PORT=8080
ENDPOINT=http://127.0.0.1:8080

# The 31B is dense: N_GPU_LAYERS of its 60 layers go on the card and the rest run on the CPU.
# Every token reads every layer, so the CPU side sets the speed.
# MEASURED 2026-10-18 (first-light run, bench-ngl*.md; llama-bench pp512/tg64, -t 6, no drafter):
# -ngl   0      12     16     18     20     22     24
# tg64   1.68   2.13   2.30   2.39   2.52   2.62   out of memory (554 MiB compute buffer)
# pp512  116    133    141    145    149    154
# Each layer on the card is worth about 0.05 tok/s.
# Largest -c that loads (fit-draft.txt, fit.txt): with the drafter, -ngl 20 16384 f16 / 32768
# q4_0 (q8_0 32768 fails), -ngl 16 65536 q4_0, -ngl 12 131072 q4_0; without it, -ngl 20 65536,
# -ngl 16 131072, -ngl 10 262144 (n_ctx_train), all q4_0.
# 20 at 32768: the fastest generation that fits beside the drafter.
N_GPU_LAYERS=20
CONTEXT_SIZE=32768

# Empty: the 31B has no experts. Kept so the Makefile and server.py match the 26B sister.
N_CPU_MOE=

# q4_0: the 12B sister's finding (answers level with f16 there). UNMEASURED for answer quality
# on the 31B. f16 holds 16384 beside the drafter.
KV_CACHE_TYPE=q4_0

FLASH_ATTENTION=1

METRICS=1

# MEASURED 2026-10-18 at -ngl 22 (bench-threads.md, tg64): -t 4 / 6 / 8 / 12 = 2.09 / 2.62 / 2.66 /
# 2.63 tok/s. Prompt reading level (153-154).
THREADS=8
THREADS_BATCH=12

# MEASURED 2026-10-18 (bench-ub*.md, pp2048, -b 2048): -ub 512 at -ngl 20 145 tok/s; -ub 1024 at
# -ngl 16 195 (-ngl 20 fails); -ub 2048 at -ngl 12 238. A bigger -ub reads prompts up to 1.64x
# faster but its compute buffer pushes layers off the card (2.62 -> 2.13 tok/s generation). Not set:
# llama.cpp's default 512. Pass -ub 2048 with N_GPU_LAYERS=12 for long documents.

PARALLEL_SLOTS=1

REASONING=off

GGML_CUDA_FORCE_MMQ=OFF

OVERRIDE_TENSORS=

# ── Speculative decoding ─────────────────────────────────────────────────────
# Google's drafter for this checkpoint, google/gemma-4-31B-it-qat-q4_0-unquantized-assistant
# (revision 96d4c8ca3cb38c107a8478587878124895d1e844, 4 layers of width 1024, bf16 on its 4-bit
# QAT grid), stored as exact Q4_0 by the 12B sister's gguf_exact.py: 279,956,288 B against
# 514,706,240 for llama.cpp's Q8_0 conversion. Published 2026-10-18 at SPEC_DRAFT_HF, revision
# below; the Hub's SHA-256 matches SPEC_DRAFT_SHA256.
# MEASURED 2026-10-18 (ab-ngl20/, -ngl 20, -c 8192 f16, six prompts, greedy x1, 128 tokens):
# no drafter 2.5 tok/s; 1 / 2 / 3 / 4 drafted tokens 1.585x / 1.211x / 1.373x / 1.085x (4.0 / 3.1 /
# 3.5 / 2.7), acceptance 0.757 / 0.655 / 0.558 / 0.485. +362 MiB VRAM. 1 token gains 1.47-1.71x on
# every prompt. Checking more drafted tokens at once costs the CPU-side target more than it saves.
SPEC_DRAFT_MODEL=/home/xbill/models/gemma-4-31B-it-qat-assistant/gemma-4-31B-it-qat-assistant-q4_0-exact.gguf
SPEC_DRAFT_SHA256=1c9b4c3530ae856b24882fda7b660d65e3cdb04da147f34f8139cafb4cff6fba
SPEC_DRAFT_HF=xbill9/gemma-4-31B-it-qat-assistant-q4_0-exact-gguf
SPEC_DRAFT_HF_REVISION=f1c0932ac0ef30e7855c3368d2ac914d35615afa
SPEC_DRAFT_N_MAX=1
