# gpu-vllm-g6-2b-q4w4a16emb4 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md, "The name is a claim").
# Committed on purpose and deliberately NOT gitignored. A real environment variable wins over it
# in serve.py; on the make command line, `make serve MAX_NUM_SEQS=8` wins.
#
# ADDED 2026-11-05, forked from local-vllm-3050oem-2b-q4w4a16emb4 for the G6 serving-engine flight
# (the 3050 flight moved onto one NVIDIA L4). Slot 1 and slot 3 differ; the checkpoint, revision,
# vLLM version and serving flags are the 3050 rig's. NOTHING BELOW IS MEASURED ON THE L4 YET.
# The instance is gpu-pytorch-g6-2b-q4w4a16's (create_g6_instance); this rig provisions nothing.

# ── Model ────────────────────────────────────────────────────────────────────
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text-emb4
MODEL_REVISION=db715f83da4f13289761d7c45f4d19ceac84695d
QUANTIZATION=q4w4a16emb4

# ── Hardware ─────────────────────────────────────────────────────────────────
# g6.2xlarge: 8 vCPUs, 32,768 MiB RAM, one L4 with 22,888 MiB (EC2 DescribeInstanceTypes, 2026-11-05).
# gpu-llamacpp-g6-2b-q4_0 read 23,034 MiB total from nvidia-smi on 2026-10-26.
INSTANCE_TYPE=g6.2xlarge
AWS_REGION=us-east-1
ACCELERATOR_TYPE="NVIDIA L4"
COMPUTE_CAPABILITY=8.9
VRAM_TOTAL_MIB=23034
TENSOR_PARALLEL_SIZE=1

# ── Software ─────────────────────────────────────────────────────────────────
# The instance's system python3 (Ubuntu 26.04: 3.14, as on the 3050 host), user site. NOT the DLAMI's
# torch venv (/opt/torch-g6-q4/PYTHON_BIN), which keeps torch 2.13 for gpu-pytorch-g6-2b-q4w4a16.
# Unlike the 3050 host there is no system torch here, so `make install` lets vLLM bring its own pinned
# torch==2.14.0 from PyPI. UNVERIFIED: which CUDA that wheel is built for and whether driver 595.112.07
# (CUDA 13.2, read on 2026-10-26) runs it; `make check` answers it before the first serve.
VLLM_VERSION=0.33.0
TORCH_VERSION=2.14.0
PYTHON=/usr/bin/python3

# ── Serving (the 3050 rig's values) ──────────────────────────────────────────
# 0.85 of 23,034 MiB is ~19.1 GiB against the 3050's ~6.8; the KV pool is far larger. Kept at the 3050
# value so the two flights serve with the same flags; the card is dedicated (one engine at a time).
HOST=127.0.0.1
PORT=8010
ENDPOINT=http://127.0.0.1:8010
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=64
LANGUAGE_MODEL_ONLY=true
TOOL_CALL_PARSER=gemma4
REASONING_PARSER=gemma4
# Empty = no drafter. The flight's drafter arm is the W4A16 repack of Google's QAT assistant, built on the
# instance by `make drafter` (repack/repack_drafter.py, as on the 3050) into DRAFTER_DIR.
SPECULATIVE_MODEL=
NUM_SPECULATIVE_TOKENS=2
DRAFTER_SOURCE=google/gemma-4-E2B-it-qat-q4_0-unquantized-assistant
DRAFTER_SOURCE_REVISION=ebc7e1a211354561464cb82ed6d886792138dcb6
DRAFTER_DIR=/opt/models/gemma-4-E2B-it-qat-q4_0-w4a16-ct-assistant
