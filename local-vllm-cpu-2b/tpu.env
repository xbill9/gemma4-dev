# local-vllm-cpu-2b — source of truth. Committed on purpose.
#
# The directory name describes; this file decides. Never copy a slot value into
# a command line (root CLAUDE.md). `tpu.env` is the filename every rig in this
# tree uses, including the ones with no TPU in them — a wart kept for
# consistency, not a claim.

# ---------------------------------------------------------------------------
# Model. A Hub id, and it must be a SAFETENSORS repo.
#
# vLLM CANNOT LOAD A GGUF, on any platform slot. Verified 2026-09-02 against a
# stock vLLM 0.26.0 CUDA install: no gguf module under
# model_executor/layers/quantization/, and 31 entries in QUANTIZATION_METHODS
# with no `gguf` among them (@QUANTIZATION.md). So the 3.35 GB q4_0 GGUF already
# on this machine at ~/models/ is NOT usable here, and the sibling rigs
# local-llamacpp-1650ti-2b-q4_0 and local-ollama-1650ti-2b-q4_0 cannot lend this
# rig their artifact. It needs its own 10.25 GB download.
MODEL_NAME=google/gemma-4-E2B-it

# MEASURED 2026-09-04 from the Hub (HEAD, x-linked-size), ungated:
#   google/gemma-4-E2B-it                    model.safetensors  10,246,621,918 B
# Of that, 0.951 GB is the vision+audio towers — 476 M params, MEASURED from the
# projector blob (audio 305 M, vision 167 M). Text-only would be ~9.30 GB, which
# matches local-jax-cpu-2b's dense `ple0` figure of 9.257 GB.
MODEL_SAFETENSORS_BYTES=10246621918
MODEL_TOWERS_BYTES=951000000

# THE QUANTIZED ROUTE, AND IT IS THE LARGEST LEVER THIS RIG HAS.
# `compressed-tensors` / `pack-quantized`, 4-bit int, group size 32, symmetric,
# ungated. MEASURED from the Hub 2026-09-04.
#
# IT SAVES 19%, NOT 75%, and the reason is in the checkpoint's own `ignore`
# list: the vision tower and the embeddings stay bf16, so only the linear layers
# are packed. 10.25 -> 8.32 GB. @MODELS.md records the resident figure as
# 8.15 GB and it is right. A `weights / 4` estimate under-predicts by ~3x and is
# exactly the error that produced an earlier, wrong "~2.9 GB" claim in this rig.
#
# Set MODEL_NAME to this to serve it; the budget is ~2 GB cheaper.
MODEL_W4A16_NAME=google/gemma-4-E2B-it-qat-w4a16-ct
MODEL_W4A16_BYTES=8316306646

# ---------------------------------------------------------------------------
# Hardware. There is no accelerator. That is the point of the rig.
ACCELERATOR_TYPE=none
CHIP_COUNT=0
TENSOR_PARALLEL_SIZE=1

# MEASURED on this host 2026-09-04.
#
# THE CPU HAS NO AVX512, AND THAT IS LESS OF A PROBLEM THAN FIRST WRITTEN.
# Corrected 2026-09-04 against vLLM's own source:
#   - `cmake/cpu_extension.cmake` carries first-class CXX_COMPILE_FLAGS_AVX2
#     beside the AVX512 set and dispatches between them. AVX2 is a supported
#     target, not a hack. The only hard x86 requirement is gcc/g++ >= 12.3;
#     this host has 14.2.
#   - `CpuPlatform.supported_dtypes` returns [bfloat16, float16, float32] for
#     x86 UNCONDITIONALLY. There is NO fp32 upcast. AVX512-BF16 governs how fast
#     a bf16 datapath is, not how many bytes the weights occupy.
# What remains true: there is no published CPU wheel (wheels.vllm.ai/cpu -> 404,
# and the PyPI `vllm` wheel is the CUDA build), so this is a source build.
HOST_CPU="Intel(R) Core(TM) i7-10750H CPU @ 2.60GHz"
HOST_CPU_CORES=6
HOST_CPU_THREADS=12
HOST_ISA=avx2,f16c
HOST_HAS_AVX512=0
HOST_RAM_TOTAL_BYTES=16420000000

# ---------------------------------------------------------------------------
# Serving shape.
#
# MAX_MODEL_LEN is small on purpose: it trims the KV pool, which is the only
# term on this host that configuration can move. It does NOT move the weights,
# and the weights are what does not fit. See `check_host_capacity`.
DTYPE=bfloat16
MAX_MODEL_LEN=2048
MAX_NUM_SEQS=1

# vLLM CPU's KV pool, in GiB. ITS DEFAULT IS 4, which is larger than the entire
# headroom this host has after weights. Set explicitly so it is a decision.
VLLM_CPU_KVCACHE_SPACE=1

# Pin the worker threads to the physical cores, not the SMT siblings. 6 physical
# cores; hyperthreads share execution units and hurt a memory-bound decode.
VLLM_CPU_OMP_THREADS_BIND=0-5
OMP_NUM_THREADS=6

# ---------------------------------------------------------------------------
# Endpoint. Known before the process starts; there is no discovery chain here
# (@NAMING.md, "`local` is the absence of a control plane").
#
# 8000 is taken by local-ollama-1650ti-2b-q4_0 and 8080 by
# local-llamacpp-1650ti-2b-q4_0. 8001 so all three can be up at once — they do
# not contend for the GPU, since this one does not use it.
HOST=127.0.0.1
PORT=8001
ENDPOINT=http://127.0.0.1:8001

# ---------------------------------------------------------------------------
# Install. THERE IS NO WORKING INSTALL YET and `make install` will not create
# one from PyPI — the wheel there is the CUDA build. A CPU vLLM is a source
# build:
#
#   git clone https://github.com/vllm-project/vllm && cd vllm
#   VLLM_TARGET_DEVICE=cpu VLLM_CPU_DISABLE_AVX512=1 pip install -e .
#
# Do not run that before `check_host_capacity` says the result could serve. On
# this host, as of 2026-09-04, it says it could not.
VLLM_VERSION=
VLLM_TARGET_DEVICE=cpu
VLLM_CPU_DISABLE_AVX512=1
