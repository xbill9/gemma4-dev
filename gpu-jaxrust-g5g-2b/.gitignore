# Models and large files
gemma-4-*/
gemma-*/
*.safetensors
*.bin
*.tar.gz
*.pth
*.onnx

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.tox/
.coverage
.coverage.*
.cache
coverage.xml
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / IDE
.DS_Store
.vscode/
.idea/

# Local MCP registration (generated by init.sh / project-setup.sh)
.mcp.json

# Local env config (non-secret, but machine-specific)
.env

# Live AWS credentials written by save-aws-creds.sh (mode 0600).
# save-aws-creds.sh refuses to write anywhere inside a git work tree that is not
# ignored, so removing this line does not just risk a leak — it breaks the script.
.aws_creds

# Build artifacts
dist/

# Rust (rust-mcp/). Cargo.lock IS committed — this is a binary crate, so a pinned
# lockfile is the point. Only target/ is ignored; it holds a ~39 MB binary.
rust-mcp/target/

# NOTE: tpu.env is NOT ignored. It is the rig's source of truth and is committed
# on purpose — never add *.env here.

# Rust build artifacts (the crate under rust/)
rust/target/
