# gpu-llamacpp-g5g-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# STATUS: THIS RIG HAS SERVED NOTHING. Scaffolded 2026-09-02 from
# `gpu-pytorch-g5g-2b` — same hardware, same host, runtime swapped from PyTorch +
# transformers to llama.cpp, and the weights swapped from fp16 safetensors to the
# Q4_0 GGUF. `benchmarks/` is deliberately EMPTY: the sibling's four runs were
# deleted rather than left for `benchmarks/rollup.py` to count against this rig,
# following the `tpu-vllm-v5p1-2b` precedent. Every number in a comment here was
# measured on a sibling or derived from the artifact, and says which.
#
# THIS FILE WAS REWRITTEN, NOT PATCHED, and that is the point. The PyTorch fork
# inherited QUANT_MODE / PLE_BITS / INT8_LM_HEAD / KV_CACHE_DTYPE / DTYPE from
# the JAX rig and carried them for a month as keys nothing read — its own
# CLAUDE.md ended up having to say "they are inert here and must not be
# re-plumbed into this command on the strength of existing". A key present in an
# env file reads as a supported knob. None of those keys appear below.
#
# WHY THIS RIG EXISTS: it is the only rig in the monorepo serving 4-bit weights
# on a GPU, because every other route is closed. Verified 2026-09-02 and written
# up in the root QUANTIZATION.md:
#   * vLLM 0.26.0 has no `gguf` module at all — CUDA build or TPU.
#   * No GGUF reader exists anywhere in the JAX ecosystem.
#   * transformers 5.12.1 reads it, dequantizes to fp32 (9.4 GB host transient on
#     one tensor) and silently drops 35 `layer_scalar` tensors.
#
# ITS SIBLING IS `gpu-ollama-g5g-2b-q4_0`, same silicon, same weights, same
# engine — Ollama links llama.cpp. The four ways they still differ are in
# CLAUDE.md and they are not cosmetic.

# --- Model -------------------------------------------------------------------
# TWO KEYS, NOT ONE. A GGUF repo can hold several quantisations plus a projector,
# so naming the repo alone would leave llama-server to pick — and slot 5 of this
# rig's directory name is a claim about WHICH FILE.
#
# Verified on the Hub 2026-09-02: ungated (gated=False), 508k downloads.
#   gemma-4-E2B_q4_0-it.gguf      3,349,516,256 B  sha256 fa401b55…
#   gemma-4-E2B-it-mmproj.gguf      986,833,664 B  sha256 021059cc…
#
# GGUF v3, arch `gemma4`, 541 tensors, 49 KV pairs. Dtype histogram:
# Q4_0 x275, F32 x263, Q6_K x2, F16 x1.
MODEL_NAME=google/gemma-4-E2B-it-qat-q4_0-gguf
MODEL_FILE=gemma-4-E2B_q4_0-it.gguf

# THESE ARE THE SAME QAT WEIGHTS the TPU rigs serve unpacked, proven rather than
# assumed: four F32 norm tensors read out of the GGUF are BIT-IDENTICAL to the
# bf16 tensors in `-qat-q4_0-unquantized` (blk.0.attn_norm == layers.0.
# input_layernorm, both 9.375 / 7.9375 / 10.6875, mean +10.67993). So this file
# is the native packing of a release QUANTIZATION.md already characterises as
# QAT values on a Q4_0 grid at group size 32.

# The vision/audio projector, EMPTY on purpose. This rig serves text, and loading
# it costs ~1 GB of the budget the Q4_0 packing exists to free. Set it only for a
# multimodal run, and say so in that run's REPORT.md.
MMPROJ_FILE=

# --- Hardware ----------------------------------------------------------------
INSTANCE_TYPE=g5g.2xlarge
AWS_REGION=us-east-1

# g5g.2xlarge: 1x NVIDIA T4G (Turing, SM 7.5, 15360 MiB), Graviton2, 16 GiB RAM.
# HARDWARE.md: quote 277 GB/s of measured streaming read, NOT the 320.1 GB/s
# theoretical peak.

# --- What Q4_0 actually buys, and what it does not ---------------------------
# DERIVED from the file's own tensor table (QUANTIZATION.md has the working),
# against the PyTorch sibling's MEASURED fp16 figures:
#
#                        fp16 (measured)   Q4_0 (derived)
#   streamed / step         4.514 GB          1.407 GB     3.2x less
#   resident               10.209 GB          3.35  GB     frees ~6.9 GB
#   bandwidth ceiling      61.4 tok/s       197   tok/s
#   MEASURED               10.88 tok/s          —
#
# **DO NOT TURN THE CEILING INTO A PREDICTION.** Decode at B=1 on this silicon is
# launch-bound, not bandwidth-bound: ~5,650 kernel launches per step at 1-3 us on
# a chip with 5-10 us launch overhead. The two controlled experiments in
# QUANTIZATION.md are what a bandwidth cut actually buys — `ple_bits=4` removed
# 3.505 GB for **0.0%**, `int8_lm_head` removed 11.9% of streamed bytes for
# **+2.3%**. THE WIN HERE IS RESIDENCY, and residency is what pays for batching.

# --- Serving -----------------------------------------------------------------
SERVICE_NAME=llamacpp-g5g
HF_SECRET_ID=vllm/hf-token
LLAMA_PORT=8000
APP_DIR=/opt/llamacpp-g5g

# Context BOUND, not a padded buffer. llama.cpp allocates a KV cache of exactly
# this size at startup; nothing recompiles per shape, so raising it is cheap.
#
# E2B's KV is ~18 KiB/token (MODELS.md), so 4096 tokens is ~74 MiB against a
# 14.07 GB budget. **NEVER SIZE THIS RIG'S CONTEXT FROM KV ARITHMETIC** — the
# JAX sibling advertised MAX_MODEL_LEN=8192 while 5,120 tokens OOMed, because
# what binds is prefill temporaries, not KV.
CONTEXT_SIZE=4096

# Parallel decode slots. llama.cpp SPLITS CONTEXT_SIZE across them, so raising
# this divides per-sequence context rather than adding memory.
#
# 1 to match every sibling's single-stream baseline — the only configuration the
# family's existing numbers can be compared against. Batching is the obvious next
# experiment (the PyTorch sibling measured 7.84x at B=8 for 0.258 GB, and this
# rig has ~6.9 GB more headroom than it did), but raise this IN A RUN WHOSE
# REPORT SAYS SO. A default change here silently invalidates every comparison.
PARALLEL_SLOTS=1

# Offload every layer; 999 is llama.cpp's idiom for "all of them". A PARTIAL
# offload is this rig's second silent-slowness failure after a CPU-only build:
# the server starts, answers correctly, and runs several times slower.
N_GPU_LAYERS=999

# --- Build -------------------------------------------------------------------
# llama.cpp publishes NO prebuilt Linux aarch64 CUDA binary. VERIFIED against
# release b10760 (2026-09-02): the arm64 Linux assets are `-bin-ubuntu-arm64`
# (CPU) and `-bin-ubuntu-vulkan-arm64`; every `-cuda-` Linux asset is x64, and
# the only arm64 CUDA build targets Windows. So this rig compiles.
#
# That is the main asymmetry against the Ollama sibling, which ships a working
# aarch64 CUDA bundle with native sm_75 SASS already in it. Having both rigs is
# how that asymmetry gets measured instead of argued about.
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp

# PINNED, NOT `master`. llama.cpp cuts several releases a day (b10754..b10760 all
# landed on 2026-09-02). An unpinned build makes the engine a moving variable
# across two runs meant to differ only in what is being measured. Bump this
# deliberately and record the bump in the run's REPORT.md.
LLAMA_CPP_REF=b10760

# T4G is SM 7.5 and it is the ONLY target. Pinned rather than left to llama.cpp's
# default arch list for two reasons, the second of which is about measurement: a
# narrow list builds far faster on a Graviton2, and a broad list can leave the
# device on a JIT'd PTX path whose warm-up would be recorded as a property of the
# engine. The Ollama sibling meets this from the other side — its cuda_v13 bundle
# carries PTX for every arch and native SASS for none.
CUDA_ARCH=75
BUILD_DIR=/opt/llamacpp-build

# --- AMI ---------------------------------------------------------------------
# THE FULL DLAMI, NOT THE BASE DRIVER IMAGE, and the reason INVERTED at the fork.
# The siblings pick the base image because they never use the DLAMI's PyTorch.
# This rig compiles CUDA code, so it needs `nvcc` — which ships with the CUDA
# TOOLKIT in the full DLAMI and is absent from the driver-only base image.
#
# Repointing this at a base image fails LOUDLY (install_runtime probes for nvcc
# and exits 1) rather than silently, but loud still costs a launch. apt's
# `nvidia-cuda-toolkit` is not a substitute: it installs a toolkit unrelated to
# the driver on the box, trading a clear failure for a silent-wrongness path.
DLAMI_SSM_PARAMETER=/aws/service/deeplearning/ami/arm64/oss-nvidia-driver-gpu-pytorch-2.12-ubuntu-24.04/latest/ami-id
DLAMI_NAME=Deep Learning ARM64 AMI OSS Nvidia Driver GPU PyTorch*Ubuntu*

# --- Storage -----------------------------------------------------------------
# The checkpoint (3.35 GB), the llama.cpp checkout and its build tree share this
# volume. Smaller than the siblings' load but with a build added.
#
# Throughput is set EXPLICITLY because gp3's default is 125 MiB/s and the
# sibling's two dominant load stages sat ON that number rather than near it —
# the signature of a volume ceiling, not of CPU or network. 500 MiB/s is ~4x
# baseline and still under g5g.2xlarge's own EBS ceiling ("up to" 4.75 Gbps
# ~= 593 MB/s). gp3 also requires throughput <= IOPS * 0.25 MiB/s, which 6000
# IOPS satisfies.
ROOT_VOLUME_GB=100
ROOT_VOLUME_THROUGHPUT_MBPS=500
ROOT_VOLUME_IOPS=6000
