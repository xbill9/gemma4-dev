# gpu-jax-g5g-2b — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: mcp-run.sh exports only unset keys, Makefiles
# use ?=, and dotenv does not overwrite.
#
# STATUS: this rig has served. First serve 2026-08-19 (benchmarks/runs/
# 2026-08-19-first-serve-g5g), and again 2026-08-21 on the CUDA 13 / Python 3.14
# stack. Values marked MEASURED were taken on G5g hardware -- by this rig where
# the run is named, otherwise by the sibling vLLM rig, in which case they
# describe the *chip* and so carry over. Values marked PREDICTED have never been
# run. Do not quote a PREDICTED number as a result.

# --- Model -------------------------------------------------------------------
# The reference instruction-tuned release, so the rig name carries no encoding
# slot. MODELS.md: 10.2 GB / 9.5 GiB of bf16 weights, 18 KiB/token of KV.
#
# Deliberately NOT the -qat-w4a16-ct export the TPU JAX rig serves. Two reasons,
# and the second is the load-bearing one:
#   1. The dense model fits: 9.5 GiB of weights in 15360 MiB of device memory.
#   2. The fused W4A16 Pallas kernel CANNOT run on Turing. On GPU, Pallas lowers
#      through Triton and its tiles become shared memory, which Turing caps at
#      64 KiB per block; the kernel needs 550 KiB - 1.1 MiB at this model's
#      shapes. check_w4a16_fits_scoped_memory() in ports/gemma4/jax_e_model.py
#      computes this and refuses at startup. Serving w4a16 here would silently
#      fall back to dequantize-then-matmul: 4x the weight traffic of the fused
#      path AND the dense model's memory, the worst of both.
MODEL_NAME=google/gemma-4-E2B-it

# auto reads the mode off the checkpoint name (w4a16 if the name says so, else
# fp16). Pinned to fp16 here because the checkpoint above is dense.
QUANT_MODE=fp16

# --- Hardware ----------------------------------------------------------------
# The hardware slot is `g5g` — the EC2 instance family, by the carve-out in
# NAMING.md. G5g is the only Graviton+GPU family AWS ships, so the family name
# pins the Graviton2 host and the T4G GPU together, which is the pairing that
# actually determines whether anything runs here. The GPU on its own is a T4G;
# that spelling collides with the t4g.* burstable CPU instances.
INSTANCE_TYPE=g5g.2xlarge
AWS_REGION=us-east-1

#   size           GPUs  GPU mem  vCPU  RAM
#   g5g.xlarge      1     16 GB     4    8 GB
#   g5g.2xlarge     1     16 GB     8   16 GB   <- default
#   g5g.4xlarge     1     16 GB    16   32 GB
#   g5g.8xlarge     1     16 GB    32   64 GB
#   g5g.16xlarge    2     32 GB    64  128 GB
#   g5g.metal       2     32 GB    64  128 GB

# One T4G on every size except 16xlarge/metal. Topology, not a sharding choice.
# NOTE: unlike the vLLM rig, nothing here shards across two GPUs yet — the JAX
# engine is single-device (jax.devices()[0]). On 16xlarge the second T4G idles.
TENSOR_PARALLEL_SIZE=1

# --- Turing (SM 7.5) constraints ---------------------------------------------
# MEASURED on hardware 2026-08-12 by the sibling vLLM rig. These are properties
# of the chip, so they hold here too.
#
# T4G is Turing and has no bf16 datapath. It is not a hard failure: XLA accepts
# bfloat16 and emulates it through fp32 conversions, so the numbers come out
# right while every matmul quietly pays a conversion. float16 is what actually
# executes on Turing tensor cores.
#
# jax_e_model.py decides this from the live device's compute capability rather
# than from this file — anything below SM 8.0 gets float16. The value here is
# the override, and setting it to bfloat16 would emulate rather than fail.
DTYPE=float16

# Turing has no fp8 either, so the fp8 KV cache the L4 rigs enable is
# unavailable; resolve_cache_dtype() raises rather than silently downgrading.
# `auto` follows the compute dtype, so this resolves to float16 on a T4G.
# int8 is the supported way to halve KV here — it carries a per-row scale.
KV_CACHE_DTYPE=auto

# MEASURED: 15360 MiB total on a G5g, not the nominal 16 GB.
#
# This is JAX's preallocation knob, not vLLM's GPU_MEMORY_UTILIZATION — they are
# not the same thing and the number is not transferable. JAX preallocates this
# fraction of device memory at first use; what is left over is NOT a KV pool
# managed by an engine, because this engine allocates its KV cache as ordinary
# JAX arrays inside that fraction.
XLA_PYTHON_CLIENT_MEM_FRACTION=0.90

# PREDICTED, never run. 9.5 GiB of weights + 18 KiB/token of KV in 15360 MiB
# leaves roughly 4.3 GiB for KV, which is about 250k tokens — but the JAX engine
# allocates a static per-sequence cache rather than a shared pool, so the real
# ceiling is MAX_MODEL_LEN x MAX_NUM_SEQS, not a token budget. Measure it.
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=1

# --- Serving -----------------------------------------------------------------
JAX_PORT=8000
SERVICE_NAME=jax-g5g
HF_SECRET_ID=vllm/hf-token

# --- JAX runtime -------------------------------------------------------------
# The whole reason this rig exists. The vLLM path on this hardware needs a
# from-source build for SM 7.5 (~67 min) plus a CUDA toolkit, plus Rust, plus an
# unlanded patch to Triton's attention kernel. JAX needs none of it:
#
#   * jaxlib, jax-cuda12-plugin and jax-cuda12-pjrt all publish
#     manylinux_2_27_aarch64 wheels. VERIFIED 2026-08-18 against PyPI.
#   * The plugin's arch tables contain sm_75 and its floor is SM 6.0
#     ("device not supported (request SM60+)"). VERIFIED by inspecting
#     jax_cuda12_pjrt 0.11.1's xla_cuda_plugin.so.
#   * Every CUDA dependency (cublas, cudnn, cuda-runtime, cusolver, nvcc)
#     publishes aarch64 wheels, so pip supplies CUDA and the DLAMI only has to
#     supply the driver. VERIFIED 2026-08-18 against PyPI.
#
# That list is about installability, which is not the same as "it serves" --
# but the serving question is now settled independently: MEASURED 2026-08-19 and
# again 2026-08-21. See benchmarks/runs/.
# cuda13, not cuda12. The DLAMI driver is 580.126.09 and nvidia-smi reports
# CUDA Version: 13.0, so the newer line is supported by the driver we get.
#
# MEASURED 2026-08-21 on i-08639f402a3c3e76b -- installed, booted and served,
# not merely resolved. Every version the 2026-08-20 `pip install --dry-run`
# predicted came true exactly: nvidia-cublas 13.6.1.10, nvidia-cuda-runtime
# 13.3.29, nvidia-cuda-nvcc 13.3.73, alongside jax/jaxlib 0.11.1 and
# jax-cuda13-{pjrt,plugin} 0.11.1 against driver 580.126.09.
#
# verify_gpu_arch reported compute capability 7.5 and `fp16 matmul ok: True`, and
# the endpoint then served at 12.4 tok/s decode -- indistinguishable from the
# 12.5 tok/s the CUDA 12 / Python 3.12 stack recorded on 2026-08-19. This bump
# buys currency, NOT speed; do not cite it as a performance change.
#
# GOTCHA: NVIDIA dropped the -cuXX suffix for the CUDA 13 line, so the real
# packages are `nvidia-cublas`, `nvidia-cuda-runtime`, `nvidia-cusolver`.
# `nvidia-cublas-cu13` still exists on PyPI as a 0.0.1 stub reading
# "DEPRECATED: Use nvidia-cublas instead" -- which looks exactly like "CUDA 13 is
# unpublished for aarch64" if you check the suffixed name and stop there. cudnn
# and nccl are the exceptions and kept theirs (nvidia-cudnn-cu13).
JAX_PIP_SPEC=jax[cuda13]

# 3.14, the newest stable CPython. NOT 3.12, whose bugfix window closed
# 2025-04-02 -- it has been security-only for over a year, and an interpreter off
# bugfix support is exactly the pin that turns into debugging time later.
# NOT 3.15 either: deadsnakes offers only 3.15.0~rc1, and a release candidate
# buys the same risk this preference exists to avoid.
#
# Every dependency has aarch64 wheels at cp314: jaxlib and both CUDA plugins
# publish cp312/313/314/315 manylinux_2_27_aarch64, and safetensors/tokenizers
# ship cp310-abi3, which is forward-compatible (they LOOK cp310-only in a naive
# scan of the wheel tags). VERIFIED against PyPI 2026-08-20.
JAX_PYTHON_VERSION=3.14

# Skips recompilation on restart. The TPU rig measures ~17s saved; unmeasured here.
JAX_COMPILATION_CACHE_DIR=/opt/jax-cache

# --- AMI ---------------------------------------------------------------------
# ARM64 GPU DLAMI. Two independent requirements:
#   1. arm64 — the x86_64 DLAMI the legacy tips-tree rigs hardcode
#      (ami-012ba162b9cd2729c) cannot boot on Graviton2 at all.
#   2. NVIDIA driver — AWS also ships ARM64 DLAMIs built for Graviton CPU
#      inference. Those boot fine on a G5g and simply have no GPU, which reads
#      as a broken runtime rather than a wrong AMI.
# The SSM public parameter pins both, so it is preferred over a name filter.
#
# Unlike the vLLM rig there is no prebuilt AMI here and none is needed: the
# install is a pip install, not a compile, so a stock DLAMI is the right base.
DLAMI_SSM_PARAMETER=/aws/service/deeplearning/ami/arm64/oss-nvidia-driver-gpu-pytorch-2.7-ubuntu-22.04/latest/ami-id

# Fallback for describe-images. Narrower than a bare "Deep Learning*ARM64*"
# on purpose: it requires the driver in the name.
DLAMI_NAME=Deep Learning ARM64 AMI*Nvidia Driver*Ubuntu*
