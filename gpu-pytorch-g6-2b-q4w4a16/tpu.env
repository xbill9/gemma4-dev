# gpu-pytorch-g6-2b-q4w4a16 — source of truth for this rig. A real environment variable wins over it.
#
# Gemma 4 E2B, Google's QAT 4-bit weights, through the PyTorch int4 engine of
# local-pytorch-1650ti-2b-q4w4a16, on one NVIDIA L4 in an EC2 G6 instance.
# The provisioning keys below are inherited from gpu-pytorch-g6-2b (dense bf16,
# stock transformers, same instance family); read that rig's tpu.env for the
# measurements behind the AMI and interpreter choices.

# --- Model ------------------------------------------------------------------
# Decoder linears. Every int4 code equals Google's QAT grid (NAMING.md slot 5, q4w4a16).
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text
MODEL_REVISION=315aec06cff196fd6479aa2669bf9379b0d0268a
# embed_tokens, the per-layer table and lm_head, int4 on the same grid.
VOCAB_TABLES=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text-emb4
VOCAB_TABLES_REVISION=db715f83da4f13289761d7c45f4d19ceac84695d
# The checkpoint ids above are pinned in e2b_engine.py (TEXT, EMB4); MODEL_NAME here
# labels metrics and requests and is not forwarded to the server. The revisions
# record what the 1650 Ti rig measured; the engine fetches the repos' main.
QUANT_MODE=q4w4a16
PLE_BITS=4
INT8_LM_HEAD=0

# --- Hardware -----------------------------------------------------------------
INSTANCE_TYPE=g6.2xlarge
AWS_REGION=us-east-1
ACCELERATOR_TYPE=NVIDIA L4
COMPUTE_CAPABILITY=8.9
TENSOR_PARALLEL_SIZE=1

# --- Serving --------------------------------------------------------------------
# float16 is fixed in e2b_engine.py on every GPU; this key documents it.
DTYPE=float16
# Prompt reads: auto times an fp16 and an fp32 GEMM at start-up and keeps the faster.
PREFILL_DTYPE=auto
KV_CACHE_DTYPE=auto
# Full Gemma 4 context. The 1650 Ti fits it in 3,471 MiB peak; the L4 has 23034 MiB.
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=1
SERVICE_NAME=torch-g6-q4
HF_SECRET_ID=vllm/hf-token

# --- AMI and runtime (from gpu-pytorch-g6-2b) ------------------------------------
DLAMI_SSM_PARAMETER=/aws/service/deeplearning/ami/x86_64/oss-nvidia-driver-gpu-pytorch-2.13-ubuntu-26.04/latest/ami-id
DLAMI_NAME=Deep Learning OSS Nvidia Driver AMI GPU PyTorch*Ubuntu*
# torch (and triton) come from the DLAMI. Pinned to what the engine was measured
# with: it replaces transformers' Gemma 4 attention forward and removes the
# compressed-tensors decompress hook, both internals.
TORCH_PIP_SPEC=transformers==5.16.1 compressed-tensors==0.17.0 accelerate==1.14.0
# Seeds candidate names only; install.sh probes for the interpreter that imports torch.
TORCH_PYTHON_VERSION=3.14
TORCH_PORT=8000
