# local-llamacpp-1650ti-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
# `1650ti` is for humans; llama.cpp never sees it, and CUDA_VISIBLE_DEVICES below
# is the value that actually selects the card.
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# The file is named tpu.env for consistency with every sibling. There is no TPU
# here and there is no cloud here.
#
# STATUS 2026-09-03: FIRST LIGHT. This rig serves. llama-server loads the model
# at -ngl 99 and answers on 127.0.0.1:8080; llama-bench measures 73.74 tok/s
# decode and 340.39 t/s prefill at -fa 1. VRAM MEASURED at 1618 MiB of 4096.
# See benchmarks/runs/2026-09-03-first-light-1650ti/.
#
# WHY THIS RIG EXISTS: it is the first `local` rig in the tree — no control
# plane, no capacity to find, no endpoint to discover, nothing billed. See
# NAMING.md, "`local` is the absence of a control plane".

# ── Model ────────────────────────────────────────────────────────────────────
# MODEL_NAME is the upstream artifact; MODEL_PATH is what llama.cpp opens. They
# are separate because the GGUF lives outside the git work tree on purpose (a
# 3.3 GB blob in a rig directory would be committed by accident sooner or later).
MODEL_NAME=google/gemma-4-E2B-it-qat-q4_0-gguf
MODEL_PATH=/home/xbill/models/gemma-4-E2B-it-qat-q4_0/gemma-4-E2B_q4_0-it.gguf

# Slot 5 of the directory name. Reads off MODEL_NAME, not off the file's
# dominant tensor type — which is Q6_K, not Q4_0. See CLAUDE.md, "The file is
# only 32% Q4_0".
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED-STATIC 2026-09-03, `nvidia-smi --query-gpu=name,compute_cap,memory.total`.
ACCELERATOR_TYPE="NVIDIA GeForce GTX 1650 Ti with Max-Q Design"
COMPUTE_CAPABILITY=7.5
VRAM_TOTAL_MIB=4096
VRAM_FREE_MIB=3724
NVIDIA_DRIVER=610.57.04
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# HEAD at build time, MEASURED-STATIC 2026-09-03.
LLAMA_CPP_DIR=/home/xbill/llama.cpp
LLAMA_CPP_COMMIT=95ef7fc
LLAMA_SERVER_BIN=/home/xbill/llama.cpp/build/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# The endpoint is not discovered. It is known before the process starts, which
# is the one place CLAUDE.md's "never hardcode an endpoint" rule does not apply
# — there is no QR -> node -> external IP chain here to walk.
HOST=127.0.0.1
PORT=8080
ENDPOINT=http://127.0.0.1:8080

# N_GPU_LAYERS=99 offloads all 35 blocks. PREDICTED to fit with room to spare:
# only 1.31 GiB of the 3.10 GiB of tensor data has to be resident, because
# per_layer_token_embd (1.93 GB, 58% of the file) is created with
# TENSOR_READ_LAZY in llama.cpp's src/models/gemma4.cpp:53 and is served by
# GET_ROWS out of the mmap. Do NOT lower this "to be safe" without measuring —
# see CLAUDE.md.
N_GPU_LAYERS=99

# 18 KiB/token at f16 (MODELS.md, "KV cost: 18 KiB/token at bf16"), so 8192
# tokens is ~144 MiB. Consistent with the 1618 MiB measured total.
CONTEXT_SIZE=8192
#
# f16, and NOT q8_0. MEASURED 2026-09-03: quantizing the KV cache is a LOSS on
# this card — q8_0 on either K or V costs ~12% of decode (73.7 -> 65) and 20-40%
# of prefill (340 -> 202-268). There are no tensor cores here and the KV is only
# ~144 MiB, so the dequant work buys memory that is not scarce. Do not "optimize"
# this to q8_0 without re-running the sweep.
KV_CACHE_TYPE=f16

# MEASURED 2026-09-03: +4.8% decode (70.39 -> 73.74), prefill unchanged.
FLASH_ATTENTION=1

# MEASURED 2026-09-03: thread count does not matter (73.75 / 73.08 / 72.97 at
# t=4/6/8) — decode is GPU-bound. 4 is marginally best and leaves cores free.
THREADS=4

# Concurrency is the largest lever here by a wide margin. MEASURED 2026-09-03,
# aggregate decode: B=1 73.33, B=2 121.31, B=4 168.37, B=8 223.75, B=16 238.41,
# B=64 277.61 — 3.8x end to end, and 3.05x of it arrives by B=8. Prefill is flat
# at ~355 t/s across the whole range, so batching does nothing for that path.
#
# 1 is the right default because this rig's normal use is one interactive
# session, and per-stream falls hard: 73.33 -> 27.97 at B=8 -> 4.34 at B=64.
# Raise it deliberately, in a run whose REPORT.md says so.
#
# NOTE llama.cpp SPLITS --ctx-size ACROSS SLOTS. --parallel 16 at -c 16384 is
# 1024 tokens per sequence, not 16384. Memory is not the constraint: that
# configuration measured 1818 MiB of 4096, leaving 1903 MiB free.
PARALLEL_SLOTS=1

# NOT adopted, and tested rather than assumed. llama.cpp warns at init that this
# card lacks tensor cores and suggests CMAKE_CUDA_ARCHITECTURES=61-virtual;80-virtual
# with GGML_CUDA_FORCE_MMQ. A FORCE_MMQ build at arch=75 measured pp512 337.61 /
# tg128 73.04 against the stock build's 340.33 / 73.75 — marginally WORSE. The
# build lives at ~/llama.cpp/build-mmq if you want to re-test; LLAMA_SERVER_BIN
# above deliberately still points at the stock build.
GGML_CUDA_FORCE_MMQ=OFF
