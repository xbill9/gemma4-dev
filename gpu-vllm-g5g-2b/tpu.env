# gpu-vllm-g5g-2b — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: mcp-run.sh exports only unset keys, Makefiles
# use ?=, and dotenv does not overwrite.

# --- Model -------------------------------------------------------------------
# Reference instruction-tuned release, so the rig name carries no encoding slot.
# MODELS.md: 10.2 GB / 9.5 GiB of bf16 weights, 8.97 GiB measured on device,
# 18 KiB/token of KV. That fits a 16 GB T4G with room for a real KV pool, which
# is why this rig serves the reference build rather than a QAT export.
MODEL_NAME=google/gemma-4-E2B-it

# --- Hardware ----------------------------------------------------------------
# The hardware slot is `g5g` — the EC2 instance family, by the carve-out in
# NAMING.md. G5g is the only Graviton+GPU family AWS ships, so the family name
# pins the Graviton2 host and the T4G GPU together, which is the pairing that
# actually determines whether anything runs here. The GPU on its own is a T4G;
# that spelling collides with the t4g.* burstable CPU instances.
INSTANCE_TYPE=g5g.2xlarge
AWS_REGION=us-east-1

# g5g.xlarge is deliberately NOT the default: it has 8 GB of system RAM, and
# staging 9.5 GiB of weights through host memory before they reach the GPU does
# not fit. 2xlarge is the smallest size with 16 GB.
#
#   size           GPUs  GPU mem  vCPU  RAM
#   g5g.xlarge      1     16 GB     4    8 GB   <- too little host RAM
#   g5g.2xlarge     1     16 GB     8   16 GB   <- default
#   g5g.4xlarge     1     16 GB    16   32 GB
#   g5g.8xlarge     1     16 GB    32   64 GB
#   g5g.16xlarge    2     32 GB    64  128 GB
#   g5g.metal       2     32 GB    64  128 GB

# One T4G on every size except 16xlarge/metal. Topology, not a sharding choice.
TENSOR_PARALLEL_SIZE=1

# --- Turing (SM 7.5) constraints ---------------------------------------------
# All values below were measured on hardware 2026-08-12; see
# benchmarks/runs/2026-08-12-first-serve-g5g/.
#
# T4G is Turing and has no bf16 *datapath*. It is not a hard failure, as this
# file previously claimed: PyTorch runs bf16 by upconverting, and vLLM logs
# `Casting torch.bfloat16 to torch.float16` and proceeds. float16 is still the
# right setting — it is what actually executes — but the reason is the missing
# datapath, not a refusal.
DTYPE=float16

# Turing has no fp8 either, so the fp8 KV cache the L4 rigs enable is
# unavailable. `auto` keeps KV at the model dtype.
KV_CACHE_DTYPE=auto

# NOTE: there is deliberately no VLLM_ATTENTION_BACKEND here. It was set to
# XFORMERS on the assumption that FlashAttention needs SM 8.0+ and XFORMERS is
# the Turing fallback. Measured: vLLM v0.27 does not recognize the variable at
# all ("Unknown vLLM environment variable detected"), and it *forces*
# TRITON_ATTN for Gemma 4 regardless, because the model's head dims are
# heterogeneous (sliding 256 / global 512) and only FA4 or Triton handle that.
# Setting it does nothing; leaving it here would be dead config.

# Measured: 15360 MiB total, 13501 MiB in use while serving. At 0.90 the KV
# pool came out at 2.95 GiB = 329,579 tokens (20.12x concurrency at 16k ctx).
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=8

# --- Serving -----------------------------------------------------------------
VLLM_PORT=8000
SERVICE_NAME=vllm-g5g
HF_SECRET_ID=vllm/hf-token

# The published arm64 image, used ONLY by serving="stock" to reproduce the
# SM 7.5 gap on real hardware. It cannot serve this model — see docs/.
VLLM_STOCK_IMAGE=vllm/vllm-openai:v0.27.1

# The locally built Turing-capable arm64 image that serving="build" produces.
VLLM_IMAGE=vllm-openai:v0.27.1-sm75-arm64

# Passed as --build-arg torch_cuda_arch_list. The vLLM Dockerfile takes this as
# a documented ARG; the release pipeline overrides it per platform, and the
# arm64 override is what drops 7.5.
TORCH_CUDA_ARCH_LIST=7.5

# Minimum vLLM for Gemma 4 on this rig. Measured: v0.26.0 dies with
# AmbiguousGlobalPerLayerAttributeError against current transformers, because
# Gemma 4's head_dim is per-layer. The per_layer_config handling that fixes it
# landed in v0.27.2rc0. Do not pin below this.
VLLM_REF=v0.27.2rc0

# Build host only. The build needs a CUDA toolkit, which the PyTorch DLAMI does
# NOT ship (driver + torch only), plus Rust for vLLM's vllm-rs frontend.
CUDA_TOOLKIT_PACKAGE=cuda-toolkit-13-2

# ARM64 GPU DLAMI. Two independent requirements:
#   1. arm64 — the x86_64 DLAMI the legacy tips-tree rigs hardcode
#      (ami-012ba162b9cd2729c) cannot boot on Graviton2 at all.
#   2. NVIDIA driver — AWS also ships ARM64 DLAMIs built for Graviton CPU
#      inference. Those boot fine on a G5g and simply have no GPU, which reads
#      as a broken container rather than a wrong AMI.
# The SSM public parameter pins both, so it is preferred over a name filter.
DLAMI_SSM_PARAMETER=/aws/service/deeplearning/ami/arm64/oss-nvidia-driver-gpu-pytorch-2.7-ubuntu-22.04/latest/ami-id

# Fallback for describe-images. Narrower than a bare "Deep Learning*ARM64*"
# on purpose: it requires the driver in the name.
DLAMI_NAME=Deep Learning ARM64 AMI*Nvidia Driver*Ubuntu*
