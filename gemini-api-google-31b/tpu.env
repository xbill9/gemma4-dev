# gemini-api-google-31b — Gemma 4 (Gemma 4 31B IT) through the Gemini API, beside the five Gemini rigs.
#
# Nothing here provisions anything: the Gemini API is Google's hosted service. This file names the
# endpoint and the model; the key is read from ~/gemini.key. A real environment variable wins.
#
# Read 2026-11-14 from GET /v1beta/models/gemma-4-31b-it and one request per thinking level:
#   displayName          Gemma 4 31B IT
#   outputTokenLimit     32768
#   thinking             true
#   reasoning_effort     minimal accepted (0 thinking tokens); none and low rejected
#   no reasoning_effort  thinks without bound: 2,045 thinking tokens and no answer at max_tokens 2048
#   price                free tier only ("Not available" on the paid tier, pricing page 2026-11-14)
#   serving stack        not disclosed  -> slot 2 is api
#   hardware             not disclosed  -> slot 3 is google

GEMINI_OPENAI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_API_KEY_FILE=~/gemini.key
MODEL_NAME=gemma-4-31b-it
LOWEST_REASONING_EFFORT=minimal
MAX_OUTPUT_TOKENS=32768
PLATFORM_NOTE="Gemini API (hosted, OpenAI-compatible endpoint)"
RUNTIME_NOTE="not disclosed"
HARDWARE_NOTE="not disclosed"
