# gpu-mistralrs-g6-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md, "The name is a claim").
# Committed on purpose and deliberately NOT gitignored. A real environment variable wins over it.
#
# ADDED 2026-11-05, forked from local-mistralrs-3050oem-2b-q4_0 for the G6 serving-engine flight.
# Serves the SAME exact Q4_0 GGUF as gpu-llamacpp-g6-2b-q4_0 (by path and hash), so on this instance
# slot 2 is the only slot that differs from that rig. NOTHING BELOW IS MEASURED ON THE L4 YET.
# Instance: gpu-pytorch-g6-2b-q4w4a16's create_g6_instance; gpu-llamacpp-g6-2b-q4_0's `make toolkit
# download` must run first (CUDA 13.1 compiler, the GGUF).

# ── Model ────────────────────────────────────────────────────────────────────
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-exact-gguf
MODEL_PATH=/opt/models/e2b/gemma-4-E2B-it-q4_0-exact.gguf
MODEL_SHA256=419db9a6bf3bc15d770c85ccf9216827aa88c64fe8f3d72fbe5674f48efe2dc8
QUANTIZATION=q4_0
# mistral.rs always loads a projector for the gemma4 GGUF architecture. Google's file, the 3050 rig's hash.
MMPROJ_HF=google/gemma-4-E2B-it-qat-q4_0-gguf
MMPROJ_HF_FILE=gemma-4-E2B-it-mmproj.gguf
MMPROJ_HF_REVISION=675cff42a74c774d6cb76f76d8eacb49b48c9b93
MMPROJ_PATH=/opt/models/e2b-mmproj/gemma-4-E2B-it-mmproj.gguf
MMPROJ_SHA256=021059cce659fe7f9170d5599761d7bbaf644b798dab9503aca30dc43e6beb14

# ── Hardware ─────────────────────────────────────────────────────────────────
INSTANCE_TYPE=g6.2xlarge
AWS_REGION=us-east-1
ACCELERATOR_TYPE="NVIDIA L4"
COMPUTE_CAPABILITY=8.9
VRAM_TOTAL_MIB=23034

# ── Software ─────────────────────────────────────────────────────────────────
# Built from source at the v0.9.5 tag (the 3050 rig's commit) with the toolkit gpu-llamacpp-g6-2b-q4_0
# installs (CUDA 13.1; the driver supports 13.2). Rust from rustup (`make rust`).
MISTRALRS_SRC=/opt/mistralrs/mistral.rs
MISTRALRS_VERSION=v0.9.5
MISTRALRS_COMMIT=465191d
MISTRALRS_FEATURES=cuda,flash-attn
CUDA_HOME=/usr/local/cuda-13.1
CUDA_COMPUTE_CAP=89
MISTRALRS_BIN=/opt/mistralrs/v0.9.5/bin/mistralrs
# 8 vCPUs and 32 GiB of RAM; the flash-attn kernels are the long part of the build.
CARGO_BUILD_JOBS=8

# ── Serving ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8020
ENDPOINT=http://127.0.0.1:8020
# The 3050 values, forced by its 8 GB (local-mistralrs-3050oem-2b-q4_0/tpu.env): 4 requests, a fixed
# 8,192-token cache, 1,024 tokens per scheduler step. Kept for the flight's like-for-like arm. The flight
# also runs a whole-card arm (flight/engines.py `mistralrs-card`: 64 requests, 65,536-token cache, the
# default 4,096 per step), UNTESTED on the L4.
MAX_SEQS=4
KV_CACHE=8192tokens
MAX_NUM_BATCHED_TOKENS=1024
MAX_MODEL_LEN=8192
PREFIX_CACHE_N=0
# Empty = no drafter. Google's QAT assistant (bf16 safetensors) through --mtp-model; the flight fetches it.
MTP_MODEL=
MTP_N_PREDICT=2
MTP_HF=google/gemma-4-E2B-it-qat-q4_0-unquantized-assistant
MTP_HF_REVISION=ebc7e1a211354561464cb82ed6d886792138dcb6
