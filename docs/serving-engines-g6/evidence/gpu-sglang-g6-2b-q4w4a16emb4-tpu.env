# gpu-sglang-g6-2b-q4w4a16emb4 — SGLang on one NVIDIA L4 (EC2 G6), Gemma 4 E2B QAT W4A16 (int4 tables).
# Source of truth for serve.py and the Makefile; a real environment variable wins over this file.
#
# ADDED 2026-11-05, forked from local-sglang-3050oem-2b-q4w4a16emb4 for the G6 serving-engine flight.
# Slots 1 and 3 differ; checkpoint, SGLang version, both patches and the serving flags are the 3050
# rig's. NOTHING BELOW IS MEASURED ON THE L4 YET. Instance: gpu-pytorch-g6-2b-q4w4a16's create_g6_instance.

# ── Checkpoint (the same as gpu-vllm-g6-2b-q4w4a16emb4, same revision) ─────────────────────────────
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text-emb4
MODEL_REVISION=db715f83da4f13289761d7c45f4d19ceac84695d
QUANTIZATION=q4w4a16emb4

# ── Hardware ─────────────────────────────────────────────────────────────────
INSTANCE_TYPE=g6.2xlarge
AWS_REGION=us-east-1
ACCELERATOR_TYPE="NVIDIA L4"
COMPUTE_CAPABILITY=8.9
VRAM_TOTAL_MIB=23034

# ── Stack ────────────────────────────────────────────────────────────────────
# The instance's system python3 (Ubuntu 26.04: 3.14), the same interpreter and user site as
# gpu-vllm-g6-2b-q4w4a16emb4, whose `make install` must run first: it brings torch. sglang 0.5.23 ships
# cp311-cp313 wheels only, so `make install` retags the cp313 wheel for cp314 and installs it --no-deps,
# then the requirements the HTTP server needs that are missing, also --no-deps, as on the 3050.
SGLANG_VERSION=0.5.23
SGLANG_KERNEL_VERSION=0.4.10
PYTHON=/usr/bin/python3

# ── Serving (the 3050 rig's values) ──────────────────────────────────────────
HOST=127.0.0.1
PORT=8030
ENDPOINT=http://127.0.0.1:8030
MEM_FRACTION_STATIC=0.80
CONTEXT_LENGTH=16384
MAX_RUNNING_REQUESTS=64
TOOL_CALL_PARSER=gemma4
REASONING_PARSER=gemma4
DISABLE_RADIX_CACHE=true
# Prefill CUDA graphs refuse Gemma 4's KV-shared layers on the 3050 ("invalid or duplicate attention
# layer_id: 13"); a property of the model and SGLang, so kept off here.
DISABLE_PREFILL_CUDA_GRAPH=true
CUDA_GRAPH_MAX_BS_DECODE=64
# Empty = no drafter. The flight's drafter arm uses gpu-vllm-g6-2b-q4w4a16emb4's DRAFTER_DIR.
SPECULATIVE_MODEL=
SPECULATIVE_NUM_STEPS=2
