+def _first_kv_shared_layer(config) -> int:
+    """First layer that reuses an earlier layer's K/V (E2B/E4B); num_layers when none do."""
+    n = int(getattr(config, "num_kv_shared_layers", 0) or 0)
+    return config.num_hidden_layers - n
+
+
+def _kv_share_source(config, layer_id: int) -> int:
+    """The layer whose K/V a KV-shared layer reads: the last non-shared layer of its type."""
+    first = _first_kv_shared_layer(config)
+    if layer_id < first:
+        return layer_id
+    types = getattr(config, "layer_types", None) or []
+    want = types[layer_id]
+    return max(i for i in range(first) if types[i] == want)
+
