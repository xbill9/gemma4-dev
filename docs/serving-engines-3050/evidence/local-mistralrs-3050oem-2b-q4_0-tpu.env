# local-mistralrs-3050oem-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md, "The name is a claim").
# Committed on purpose and deliberately NOT gitignored. A real environment variable wins over it.
#
# Created 2026-11-03 for the 3050 serving-engine comparison. Serves the SAME exact Q4_0 GGUF as
# local-llamacpp-3050oem-2b-q4_0 (by path and hash), so slot 2 is the only slot that differs.
# Shares the card with the other 3050 rigs; they do not run beside each other.

# ── Model ────────────────────────────────────────────────────────────────────
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-exact-gguf
MODEL_PATH=/home/xbill/models/gemma-4-E2B-it-qat-q4_0-exact-v2/gemma-4-E2B-it-q4_0-exact.gguf
QUANTIZATION=q4_0
# mistral.rs always loads a projector for the gemma4 GGUF architecture (docs/.../gguf-support.md).
# Google's, from google/gemma-4-E2B-it-qat-q4_0-gguf @ 675cff42, 986,833,664 B.
MMPROJ_PATH=/home/xbill/models/gemma-4-E2B-it-mmproj/gemma-4-E2B-it-mmproj.gguf
MMPROJ_SHA256=021059cce659fe7f9170d5599761d7bbaf644b798dab9503aca30dc43e6beb14

# ── Hardware ─────────────────────────────────────────────────────────────────
ACCELERATOR_TYPE="NVIDIA GeForce RTX 3050 OEM"
COMPUTE_CAPABILITY=8.6
VRAM_TOTAL_MIB=8192
NVIDIA_DRIVER=615.78.08

# ── Software ─────────────────────────────────────────────────────────────────
# Built from source at the v0.9.5 tag with `make install` (CUDA 13.4, features below).
MISTRALRS_SRC=/home/xbill/mistral.rs
MISTRALRS_VERSION=v0.9.5
MISTRALRS_COMMIT=465191d
MISTRALRS_FEATURES=cuda,flash-attn
CUDA_COMPUTE_CAP=86
MISTRALRS_BIN=/home/xbill/.local/mistralrs-v0.9.5/bin/mistralrs

# ── Serving ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8020
ENDPOINT=http://127.0.0.1:8020
# Memory on the 8 GB card (2026-11-04). After load the engine holds 4,104 MiB (weights, the per-layer
# table, the image and audio encoders). Sized by --gpu-memory-utilization, it reserves encoder memory for
# every concurrent request first (about 300 MiB each) and then refuses to admit requests ("Memory pressure
# prevented forward admission"). A fixed cache (--kv-cache) serves: 4 requests with 8,192 tokens, or with
# the drafter 4 requests with 4,096; 12,288 does not load. Requests beyond MAX_SEQS queue.
MAX_SEQS=4
KV_CACHE=8192tokens
# Tokens per scheduler step. At the default 4,096, eight or more 512-token prompts at once ask for 3.9 GB
# of working memory, the engine answers 503 and keeps refusing every later request; at 1,024 bursts of
# 4 / 8 / 16 / 64 such prompts all complete (2026-11-04).
MAX_NUM_BATCHED_TOKENS=1024
MAX_MODEL_LEN=8192
# 0 = no prefix cache, so a repeated prompt is read in full (as llama.cpp with cache_prompt false).
PREFIX_CACHE_N=0
# Empty = no drafter. Google's QAT assistant (safetensors) through --mtp-model:
#   MTP_MODEL=/home/xbill/.cache/huggingface/hub/models--google--gemma-4-E2B-it-qat-q4_0-unquantized-assistant/snapshots/ebc7e1a211354561464cb82ed6d886792138dcb6
MTP_MODEL=
MTP_N_PREDICT=2
