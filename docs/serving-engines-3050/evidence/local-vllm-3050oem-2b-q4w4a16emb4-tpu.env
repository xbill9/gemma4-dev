# local-vllm-3050oem-2b-q4w4a16emb4 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md, "The name is a claim").
# Committed on purpose and deliberately NOT gitignored. A real environment variable wins
# over it in the scripts; on the make command line, `make serve MAX_NUM_SEQS=8` wins.
#
# Created 2026-11-03 for the 3050 serving-engine comparison. Same card, checkpoint and
# QAT grid as local-pytorch-3050oem-2b-q4w4a16 and (as int4 codes) the exact Q4_0 GGUF of
# local-llamacpp-3050oem-2b-q4_0 and the exact .litertlm of local-litertlm-3050oem-2b-q4w4a16emb4.
# Shares the card with those rigs; they do not run beside each other.

# ── Model ────────────────────────────────────────────────────────────────────
# Google's QAT Q4_0 weights repacked to compressed-tensors W4A16 (group 32, the QAT grid),
# text only, with embed_tokens, the per-layer embeddings and an untied lm_head int4 as well.
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text-emb4
MODEL_REVISION=db715f83da4f13289761d7c45f4d19ceac84695d
QUANTIZATION=q4w4a16emb4

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED-STATIC 2026-11-03, nvidia-smi: RTX 3050 OEM, sm_86, 8192 MiB, driver 615.78.08.
ACCELERATOR_TYPE="NVIDIA GeForce RTX 3050 OEM"
COMPUTE_CAPABILITY=8.6
VRAM_TOTAL_MIB=8192
NVIDIA_DRIVER=615.78.08
TENSOR_PARALLEL_SIZE=1

# ── Software ─────────────────────────────────────────────────────────────────
# vLLM 0.33.0 is installed into the system python3's user site with --no-deps on top of the
# system torch 2.14.1+cu130; vLLM pins torch==2.14.0. Its kernels are built against the
# libtorch stable ABI (_C_stable_libtorch.abi3.so) and load and serve on 2.14.1 (2026-11-03).
# Its other pins downgraded numpy 2.5.4 -> 2.4.6, numba 0.68.1 -> 0.65.0, fastapi 0.162 ->
# 0.136.3. State before: ~/.cache/vllm-install/freeze-before-2026-11-03.txt.
VLLM_VERSION=0.33.0
TORCH_VERSION=2.14.1+cu130
TRANSFORMERS_VERSION=5.16.1

# ── Serving ──────────────────────────────────────────────────────────────────
# Measured 2026-11-03 at these values: MarlinLinearKernel for the int4 linears,
# TRITON_ATTN attention, model loading 2.85 GiB, KV 259,018 tokens at MAX_MODEL_LEN 16384.
HOST=127.0.0.1
PORT=8010
ENDPOINT=http://127.0.0.1:8010
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=64
# Text only: the checkpoint has no vision or audio towers.
LANGUAGE_MODEL_ONLY=true
TOOL_CALL_PARSER=gemma4
REASONING_PARSER=gemma4
# Empty = no drafter. Google's QAT assistant drafter for vLLM's MTP path:
#   SPECULATIVE_MODEL=google/gemma-4-E2B-it-qat-q4_0-unquantized-assistant
SPECULATIVE_MODEL=
NUM_SPECULATIVE_TOKENS=2
