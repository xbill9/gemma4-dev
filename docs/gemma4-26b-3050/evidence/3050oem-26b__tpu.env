# local-llamacpp-3050oem-26b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# FORKED 2026-10-18 from local-llamacpp-3050oem-12b-q4_0, its 12B sister on the same
# card, host and llama.cpp binary. Slot 4 is the only slot that differs. Every serving
# value below was measured on this rig in benchmarks/runs/2026-10-18-first-light-3050oem.

# ── Model ────────────────────────────────────────────────────────────────────
# Google's 26B A4B QAT GGUF, unmodified: google/gemma-4-26B-A4B-it-qat-q4_0-gguf at revision
# d1c082be9cf3c8a514acf63b8761f4b41935842e. 14,439,363,584 B; SHA-256 matches the Hub's LFS oid.
# 30 layers, 128 experts, 8 used per token. Expert weights 12,251 MiB (Q4_0, about 408 MiB per
# layer); everything else 1,505 MiB (Q4_0, token_embd Q6_K 578 MiB, F32 norms). Text only: the
# mmproj file is not loaded. No exact Q4_0 rebuild exists for this size yet.
MODEL_NAME=google/gemma-4-26B-A4B-it-qat-q4_0-gguf
MODEL_PATH=/home/xbill/models/gemma-4-26B-A4B-it-qat-q4_0-gguf/gemma-4-26B_q4_0-it.gguf
MODEL_SHA256=3eca3b8f6d7baf218a7dd6bba5fb59a56ee25fe2d567b6f5f589b4f697eca51d

# Slot 5 of the directory name: every weight matrix Q4_0 except token_embd (Q6_K), the same
# claim as the E2B rigs that serve Google's file.
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED-STATIC 2026-10-13, `nvidia-smi --query-gpu=name,compute_cap,memory.total,
# memory.free,driver_version,pci.device_id`: PCI 10de:2508, GA106. Ampere, sm_86,
# with tensor cores (the parent's TU117 has none). Host: ASUS X99-A, i7-5820K
# (6C/12T Haswell-E, AVX2, no AVX-512), 46 GiB RAM, hostname `gpu`.
ACCELERATOR_TYPE="NVIDIA GeForce RTX 3050 OEM"
COMPUTE_CAPABILITY=8.6
VRAM_TOTAL_MIB=8192
VRAM_FREE_MIB=7875
NVIDIA_DRIVER=615.78.08
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# Cloned fresh 2026-10-13 and built with `make build`: GGML_CUDA=ON, CUDA_ARCH=86,
# GGML_NATIVE=ON, Release, FORCE_MMQ off. gcc 16.2.0, CUDA 13.4 (V13.4.92) at
# /usr/local/cuda, which is NOT on PATH by default on this host. The checkout was
# fast-forwarded and rebuilt 2026-10-16 11:32 (reflog); every 26B measurement is on
# that build.
LLAMA_CPP_DIR=/home/xbill/llama.cpp
LLAMA_CPP_COMMIT=7182ef71e
LLAMA_SERVER_BIN=/home/xbill/llama.cpp/build/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# The endpoint is not discovered. It is known before the process starts, which
# is the one place CLAUDE.md's "never hardcode an endpoint" rule does not apply
# — there is no QR -> node -> external IP chain here to walk.
#
# HOST=0.0.0.0 since 2026-10-13: listen on every interface so the LAN can reach
# it (eno1 is 192.168.0.156). No auth and no firewall on this host, so anyone on
# the LAN can use it. ENDPOINT stays on loopback: it is what the Makefile, the
# MCP server and sweep.py call, and 127.0.0.1 reaches a 0.0.0.0 listener.
HOST=0.0.0.0
PORT=8080
ENDPOINT=http://127.0.0.1:8080

# N_GPU_LAYERS=99 puts every layer's attention, norms and router on the card; N_CPU_MOE then
# keeps the EXPERTS of the first N layers in system RAM (-ncmoe), where the CPU runs them.
# Never pass --no-mmap: the experts in RAM are read from the mmap.
N_GPU_LAYERS=99

# MEASURED 2026-10-18 (first-light run, bench-*.md; llama-bench pp512/tg128, -t 6, no drafter):
# N_CPU_MOE  30 (= --cpu-moe)  24     20     18     17     16
# tg128      24.35             27.66  30.65  32.27  33.31  out of memory (544 MiB compute buffer)
# pp512      264               313    365    394    408
# Each layer moved back to the card is worth about 0.5-0.6 tok/s; each one left in RAM frees
# about 410 MiB for context. -ub 256 loads 16 (34.17 tok/s) but prompt reading drops to 243.
# Largest -c that loads (fit.md, fit-draft.txt), q4_0 cache:
#   no drafter: N=18 98304, N=19-21 131072, N=22 262144 (n_ctx_train)
#   drafter:    N=19 65536, N=20 98304, N=21-22 131072; 262144 fails even at N=24
# f16 holds 32768 at N=19-21; q8_0 65536 at N=19-20, 131072 at N=21-23.
# 21: the most context that fits with the drafter, for one long conversation at a time.
N_CPU_MOE=21
CONTEXT_SIZE=131072

# Full-attention KV costs 20 KiB/token at f16 (2560 MiB at 131072, from the failed allocation).
# q4_0 by the 12B sister's finding (answers level with f16 there). On the 26B, GSM8K 0.965 and
# BFCL 0.945 at q4_0 (benchmarks/runs/2026-10-18-accuracy-26b-3050oem); f16 not compared here.
KV_CACHE_TYPE=q4_0

# 12B / 2B carry. Not re-measured on 26B.
FLASH_ATTENTION=1

# Prometheus metrics at $ENDPOINT/metrics. Operational only, never the benchmark decode column.
METRICS=1

# MEASURED 2026-10-18 at N_CPU_MOE=17 (bench-threads.md, tg128): -t 4 / 5 / 6 / 8 / 12 =
# 28.49 / 31.92 / 33.03 / 33.97 / 34.65 (+-2.98) tok/s. The experts in RAM run on the CPU, so
# threads matter here, unlike on the sisters. 8: best steady result; 12 is noisy.
THREADS=8
# pp512 level from 4 to 12 threads (399.97-408.20). Carried 12.
THREADS_BATCH=12

# 1: one interactive session or agent stream. Concurrency UNMEASURED.
# llama.cpp SPLITS --ctx-size ACROSS SLOTS.
PARALLEL_SLOTS=1

# OFF so answers arrive in `content`; a request can still ask for
# "chat_template_kwargs": {"enable_thinking": true}.
REASONING=off

GGML_CUDA_FORCE_MMQ=OFF

# Empty: N_CPU_MOE places the experts.
OVERRIDE_TENSORS=

# ── Speculative decoding ─────────────────────────────────────────────────────
# Google's drafter for this checkpoint, google/gemma-4-26B-A4B-it-qat-q4_0-unquantized-assistant
# (revision 9537141506fe8875b3ed45b264af13580cb29166, 4 layers of width 1024, bf16 on its 4-bit
# QAT grid), stored as exact Q4_0 by the 12B sister's gguf_exact.py: 251,939,648 B against
# 461,785,920 for llama.cpp's Q8_0 conversion. Built in the first-light run; published 2026-10-18
# at SPEC_DRAFT_HF, revision below; the Hub's SHA-256 matches SPEC_DRAFT_SHA256.
# MEASURED 2026-10-18 (ab-n20/, N_CPU_MOE=20, -c 8192 f16, six prompts, greedy x3, 256 tokens):
# no drafter 29.6 tok/s; exact Q4_0 at 1 / 2 / 3 drafted tokens 1.247x / 1.241x / 1.014x
# (37.0 / 36.8 / 30.1); Q8_0 at 2 1.203x. Acceptance 0.76 / 0.654 / 0.579. Sampled: 1.252x /
# 1.219x / 0.614x. Code 1.51x and lists 1.43x at 2 tokens, prose 1.12-1.17x. The 12B gets 2.01x;
# here each drafted token adds expert reads on the CPU (inferred, not measured). +308 MiB VRAM.
# Greedy text differs from no drafter in 18 of 18 replies at 2 tokens (12 of 18 at 1).
# 2 kept: level with 1 overall, ahead on code and lists, which an agent stream is mostly.
SPEC_DRAFT_MODEL=/home/xbill/models/gemma-4-26B-A4B-it-qat-assistant/gemma-4-26B-A4B-it-qat-assistant-q4_0-exact.gguf
SPEC_DRAFT_SHA256=6cee35a091e6b7572be5b972fc994cde0c95dfa392466bdac0c184fe9060090b
SPEC_DRAFT_HF=xbill9/gemma-4-26B-A4B-it-qat-assistant-q4_0-exact-gguf
SPEC_DRAFT_HF_REVISION=b3116a27ecf042bb35ab7fc4d7f1a370a5b4397e
SPEC_DRAFT_N_MAX=2
