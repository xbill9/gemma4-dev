# gpu-vllm-t4-2b-q4w4a16emb4 — authoritative configuration.
#
# The directory name is documentation; this file decides. Committed on purpose, not gitignored.
# A real environment variable wins over it.
#
# FORKED 2026-11-05 from local-vllm-3050oem-2b-q4w4a16emb4 for the T4 engine comparison. Slots 1
# and 3 differ: a Tesla T4 on a Compute Engine VM. Same checkpoint and revision, same vLLM version.
#
# NOT gpu-vllm-t4-2b-w4a16, which serves the same checkpoint on this card with vLLM 0.29.0 from
# /opt1/pyuser. That rig predates slot 5's fifth rule (its name says w4a16; the weights are on the
# QAT grid) and keeps its install; this one runs vLLM 0.33.0 from its own user base
# (PYTHONUSERBASE below), so neither changes the other's packages.

# ── Model ────────────────────────────────────────────────────────────────────
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text-emb4
MODEL_REVISION=db715f83da4f13289761d7c45f4d19ceac84695d
QUANTIZATION=q4w4a16emb4

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED 2026-11-05, nvidia-smi: Tesla T4 (TU104, sm_75), 15360 MiB, driver 620.70.06.
# Host: GCE n1-standard-2, 2 vCPU, 7.4 GiB RAM, 16 GB swapfile on /opt1 (needed to load weights).
ACCELERATOR_TYPE="Tesla T4"
COMPUTE_CAPABILITY=7.5
VRAM_TOTAL_MIB=15360
NVIDIA_DRIVER=620.70.06
TENSOR_PARALLEL_SIZE=1

# ── Install ──────────────────────────────────────────────────────────────────
# /usr/bin/python3.13 with its user site on /opt1 (python3 on this host is pyenv 3.12 with a CPU
# torch, and / has little room). A relocated user base is the same interpreter, not a venv.
PYTHON_BIN=/usr/bin/python3.13
PYTHONUSERBASE=/opt1/pyuser-engines
PIP_CACHE_DIR=/opt1/pipcache
TMPDIR=/opt1/tmp
VLLM_VERSION=0.33.0

# ── Serving ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8010
ENDPOINT=http://127.0.0.1:8010
# Turing has no bfloat16; vLLM casts to float16 either way. Stated so the log says so.
DTYPE=float16
# The 3050 rig's 0.85 of 8 GB left ~7 GB; on 15 GB the same share leaves a much larger KV pool.
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=64
LANGUAGE_MODEL_ONLY=true
TOOL_CALL_PARSER=gemma4
REASONING_PARSER=gemma4

# Google's E2B QAT drafter repacked W4A16 (/opt1/models/..., SHA-256 66e683ad..., the same bytes
# as the 3050 rig's). Empty = no drafter.
SPECULATIVE_MODEL=
NUM_SPECULATIVE_TOKENS=2
