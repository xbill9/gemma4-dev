# gpu-llamacpp-t4-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md, "The name is a claim").
# Committed on purpose, not gitignored. A real environment variable wins over it.
#
# FORKED 2026-11-05 from local-llamacpp-3050oem-2b-q4_0 for the T4 engine comparison (the six
# engines of docs/serving-engines-3050, repeated on this card). Slots 1 and 3 differ: a Tesla T4
# on a Compute Engine VM instead of an RTX 3050 OEM in a desktop. Same GGUF and drafter by
# SHA-256, same llama.cpp commit. Values carried from the 3050 rig and not re-measured here say so.

# ── Model ────────────────────────────────────────────────────────────────────
# The exact Q4_0 rebuild of Google's E2B QAT GGUF (every weight matrix Q4_0 on the trained grid).
# Downloaded here 2026-11-05 from the repo's main revision; sha256sum matched the value below.
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-exact-gguf
MODEL_PATH=/opt1/models/gemma-4-E2B-it-qat-q4_0-exact-v2/gemma-4-E2B-it-q4_0-exact.gguf
MODEL_SHA256=419db9a6bf3bc15d770c85ccf9216827aa88c64fe8f3d72fbe5674f48efe2dc8
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED 2026-11-05, nvidia-smi: Tesla T4 (TU104, Turing sm_75, tensor cores), 15360 MiB,
# driver 620.70.06. Host: GCE n1-standard-2, 2 vCPU Xeon @ 2.00GHz, 7.4 GiB RAM, 16 GB swapfile
# on /opt1 (not in fstab: `sudo swapon /opt1/swapfile` after a reboot).
ACCELERATOR_TYPE="Tesla T4"
COMPUTE_CAPABILITY=7.5
VRAM_TOTAL_MIB=15360
NVIDIA_DRIVER=620.70.06
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# The host's existing checkout, built 2026-10-19 with GGML_CUDA=ON, CMAKE_CUDA_ARCHITECTURES=75,
# CUDA 13.4 at /opt1/cuda-13.4. The same commit as the 3050 engine study's llama.cpp.
LLAMA_CPP_DIR=/opt1/llama.cpp
LLAMA_CPP_COMMIT=7182ef71e
LLAMA_SERVER_BIN=/opt1/llama.cpp/build/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# Loopback only: this VM has a public IPv4 and llama-server has no auth.
HOST=127.0.0.1
PORT=8080
ENDPOINT=http://127.0.0.1:8080
N_GPU_LAYERS=99
CONTEXT_SIZE=131072
KV_CACHE_TYPE=f16
FLASH_ATTENTION=1
METRICS=1
# 2 vCPU on this host (the 3050 rig used 6 / 12).
THREADS=2
THREADS_BATCH=2
PARALLEL_SLOTS=1
REASONING=off
GGML_CUDA_FORCE_MMQ=OFF
# The per-layer table on the card, as on the 3050 rig (there 1.036x prefill, 1.001x decode).
# The T4 has 15 GB, so the 1.26 GB costs nothing it needs. Not re-measured here.
OVERRIDE_TENSORS=per_layer_token_embd\.weight=CUDA0

# ── Speculative decoding ─────────────────────────────────────────────────────
# Google's E2B QAT assistant drafter stored as exact Q4_0 on its grid (59 MB). The file here
# matched the SHA-256 below on 2026-11-05. SPEC_DRAFT_N_MAX is the 3050 rig's best (2); the T4's
# best is measured in benchmarks/runs/2026-11-05-*. Empty SPEC_DRAFT_MODEL to serve without it.
SPEC_DRAFT_MODEL=/opt1/models/gemma-4-E2B-it-qat-assistant/gemma-4-E2B-it-qat-assistant-q4_0-exact.gguf
SPEC_DRAFT_SHA256=060f5a0158f8120d25137866b90e04e21cd0d2d23de1db7a9cc3b7f00e60bd11
SPEC_DRAFT_HF=xbill9/gemma-4-E2B-it-qat-assistant-q4_0-exact-gguf
SPEC_DRAFT_HF_REVISION=6188294ee6f23cedadd98013fa664b3e1ba7159f
SPEC_DRAFT_N_MAX=2
