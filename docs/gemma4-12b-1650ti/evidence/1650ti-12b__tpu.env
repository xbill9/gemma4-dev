# local-llamacpp-1650ti-12b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# FORKED 2026-10-21 from local-llamacpp-3050oem-12b-q4_0, the same model and drafter on the
# RTX 3050 OEM (8 GiB). Slot 3 is the only slot that differs. The 4 GiB card cannot hold the
# 6.24 GiB of weights, so most layers run on the CPU (N_GPU_LAYERS below). Values measured here
# say MEASURED 2026-10-21 and name benchmarks/runs/2026-10-21-first-light-1650ti; the rest were
# carried from the 3050 sister or the 1650 Ti E2B/E4B rigs and say so. Shares port 8080 and the
# card with the 1650 Ti E2B and E4B rigs; one serves at a time.

# ── Model ────────────────────────────────────────────────────────────────────
# Exact Q4_0 rebuild of Google's 12B QAT GGUF (google/gemma-4-12B-it-qat-q4_0-gguf):
# every weight matrix Q4_0, token_embd included (Q6_K in Google's file), from
# google/gemma-4-12B-it-qat-q4_0-unquantized on the trained grid step. Text only:
# the vision tower is Google's separate mmproj file and is not loaded. Built in
# local-llamacpp-3050oem-12b-q4_0/benchmarks/runs/2026-10-16-exact-gguf-12b-3050oem. Published 2026-10-16 at revision
# 85e797eff295c45f8db90ba4e12d868578638c0e; the Hub's SHA-256 matches MODEL_SHA256.
MODEL_NAME=xbill9/gemma-4-12B-it-qat-q4_0-exact-gguf
MODEL_PATH=/home/xbill/models/gemma-4-12B-it-qat-q4_0-exact/gemma-4-12B-it-q4_0-exact.gguf
MODEL_SHA256=038337ee0375f602cc39eac7575b1c562cf7faaffcdbf538909c243862752731

# Slot 5 of the directory name. Every weight matrix in the file is Q4_0.
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED-STATIC 2026-10-21, `nvidia-smi --query-gpu=name,memory.total,driver_version,compute_cap`:
# TU117, Turing, sm_75, no tensor cores. Max-Q: the SM clock read 1035-1785 MHz under load
# (max 2100). Host: Lenovo Yoga 9 15IMH5 laptop `yogagpu`, i7-10750H (6C/12T, AVX2), 15 GiB RAM.
# CPU and GPU share the laptop's power and cooling, which moves both clocks (REPORT.md).
ACCELERATOR_TYPE="NVIDIA GeForce GTX 1650 Ti with Max-Q Design"
COMPUTE_CAPABILITY=7.5
VRAM_TOTAL_MIB=4096
VRAM_FREE_MIB=4093
NVIDIA_DRIVER=615.71.09
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# The checkout this host shares with the 1650 Ti E2B/E4B rigs, fast-forwarded 2026-10-16 and
# built for sm_75 (CMakeCache 2026-10-21: CMAKE_CUDA_ARCHITECTURES=75, GGML_NATIVE=ON, Release,
# FORCE_MMQ OFF). The same commit as the 3050 sister, on a different card and host. The E2B/E4B
# rigs' tpu.env still name f95b0d9.
LLAMA_CPP_DIR=/home/xbill/llama.cpp
LLAMA_CPP_COMMIT=7182ef71e
LLAMA_SERVER_BIN=/home/xbill/llama.cpp/build/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# The endpoint is not discovered. It is known before the process starts, which
# is the one place CLAUDE.md's "never hardcode an endpoint" rule does not apply
# — there is no QR -> node -> external IP chain here to walk.
#
# Loopback, as in the 1650 Ti E2B/E4B rigs: this is a laptop.
HOST=127.0.0.1
PORT=8080
ENDPOINT=http://127.0.0.1:8080

# MEASURED 2026-10-21 (benchmarks/runs/2026-10-21-first-light-1650ti): 48 layers of about
# 133 MiB. llama-bench tg64 / pp512 at -ub 512: 3.63 / 58.1 tok/s with no layer on the card,
# 4.72 / 59.6 at 12, 5.06 / 60.1 at 16, 5.43 / 60.7 at 20, 5.64 / 60.8 at 21; at -ub 128 up to
# 5.98 at 24 (25 fails). Each layer on the card adds about 0.1 tok/s; prompt reading does not move.
# Most layers that load in llama-server, -ub 512 (fit-all.out), with / without the drafter:
#   q4_0 cache  8192: 22 / 24   32768: 20 / 23   131072: 14 / 19
#   f16 cache   8192: 20 / 23   32768: 19 / 21
# 20 with the drafter at 32768: the drafter is worth 1.56x, three more layers without it 1.09x.
N_GPU_LAYERS=20

# 32768: context costs only a few layers (above), and at about 60 tok/s of prompt reading a
# 30,000-token prompt already takes minutes to read. 131072 loads at 14 layers with the drafter.
CONTEXT_SIZE=32768

# q4_0: two to three more layers than f16 at the same context (above). Answers level with f16 at
# q4_0 on the 3050 sister (benchmarks/runs/2026-10-17-kvcache-12b-3050oem there); this rig's own
# check is benchmarks/runs/2026-10-21-accuracy-12b-1650ti.
KV_CACHE_TYPE=q4_0

# Carried from the 1650 Ti E2B rig (1.133x prefill, 1.071x decode against -fa 0). Not re-measured.
FLASH_ATTENTION=1

# Prometheus metrics at $ENDPOINT/metrics (llama-server answers 501 without
# --metrics). For operational questions and for checking the prompt cache was
# defeated in a sweep, never for the benchmark decode column: --decode-source
# auto must keep resolving to `stream` (CLAUDE.md).
METRICS=1

# MEASURED 2026-10-21 (bench-threads.out, -ngl 21, mirrored order 6 4 8 12 12 8 4 6, each pass
# started with the CPU package at or below 55 C): tg64 -t 4 4.90 / 4.88, -t 6 5.03 / 4.66, -t 8
# 4.91 / 4.97, -t 12 4.05 / 3.94. 4-8 level; 12 slower. Generation runs mostly on the CPU here.
THREADS=6
# Carried; UNMEASURED here.
THREADS_BATCH=12

# 1: one session at a time. Concurrency UNMEASURED. llama.cpp SPLITS --ctx-size ACROSS SLOTS.
PARALLEL_SLOTS=1

# Thinking, server-wide: llama-server --reasoning {on,off,auto}. OFF so answers
# arrive directly in `content`. A request can still ask for it with
# "chat_template_kwargs": {"enable_thinking": true}, which is what sweep.py does.
REASONING=off

# llama.cpp's default, as in the 1650 Ti E2B/E4B rigs (which measured MMQ marginally worse).
GGML_CUDA_FORCE_MMQ=OFF

# Empty: the 12B has no per-layer table to place.
OVERRIDE_TENSORS=

# ── Speculative decoding ─────────────────────────────────────────────────────
# Google's drafter for this checkpoint, google/gemma-4-12B-it-qat-q4_0-unquantized-
# assistant (revision 18934064, 4 layers of width 1024, queries only, sharing the
# target's KV), ships as bf16 on its 4-bit QAT grid. Served as exact Q4_0 on that grid
# (253.7 MB against 465.1 MB for llama.cpp's Q8_0 conversion), built by gguf_exact.py in
# local-llamacpp-3050oem-12b-q4_0/benchmarks/runs/2026-10-16-drafter-q4exact-12b-3050oem, published at SPEC_DRAFT_HF.
# MEASURED 2026-10-21 (benchmarks/runs/2026-10-21-first-light-1650ti/ab-rounds-c32768: -ngl 20,
# -c 32768, q4_0 cache, six prompts, greedy, 128 tokens, three rounds in rotated order, median):
# no drafter 5.4 tok/s; 1 / 2 / 3 drafted tokens 8.1 / 6.2 / 8.5 (1.50x / 1.15x / 1.56x),
# acceptance 0.756 / 0.655 / 0.524; no drafter at 23 layers 5.9 (1.09x). 3 ahead of 1 in all three
# rounds. Greedy text differs from no drafter in 18 of 18 replies (as on the 3050), and so does
# no drafter at 23 layers against 20. Empty SPEC_DRAFT_MODEL to turn off (then N_GPU_LAYERS=23).
SPEC_DRAFT_MODEL=/home/xbill/models/gemma-4-12B-it-qat-assistant/gemma-4-12B-it-qat-assistant-q4_0-exact.gguf
SPEC_DRAFT_SHA256=f22f6366ca76102ac1d365a7ee331e80d4b1e986ddd7f0149c6d3ca5c7a87985
SPEC_DRAFT_HF=xbill9/gemma-4-12B-it-qat-assistant-q4_0-exact-gguf
SPEC_DRAFT_HF_REVISION=5fc2e28753efa96e4bd0a3cc365bbf5ffa789404
SPEC_DRAFT_N_MAX=3
