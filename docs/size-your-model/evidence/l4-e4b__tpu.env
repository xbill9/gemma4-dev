# gpu-llamacpp-g6-4b-q4_0 — authoritative configuration. The E4B sister of gpu-llamacpp-g6-2b-q4_0: same card, binary and flags.
#
# llama.cpp serving Gemma 4 E4B as the exact Q4_0 GGUF (Google's QAT grid), with Google's
# QAT assistant drafter as exact Q4_0, on one NVIDIA L4 in an AWS EC2 G6 instance.
# The serving flags are local-llamacpp-3050oem-2b-q4_0's; only the card, the thread counts
# and the paths differ. The instance comes from gpu-pytorch-g6-2b-q4w4a16's
# create_g6_instance (x86_64 PyTorch 2.13 / Ubuntu 26.04 DLAMI); this rig adds the
# CUDA 13.1 compiler and builds llama.cpp on it (Makefile `build`).

# ── Model ────────────────────────────────────────────────────────────────────
MODEL_NAME=xbill9/gemma-4-E4B-it-qat-q4_0-exact-gguf
MODEL_REVISION=8b7c081e6a50e5a3d3060ce723d7917f20153a0e
MODEL_PATH=/opt/models/e4b/gemma-4-E4B-it-q4_0-exact.gguf
MODEL_SHA256=5462cc102b7d22c4748f9b8e82091f2ae064e10a45525151af6f9a7d0da7caf9
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
INSTANCE_TYPE=g6.2xlarge
AWS_REGION=us-east-1
ACCELERATOR_TYPE="NVIDIA L4"
COMPUTE_CAPABILITY=8.9
VRAM_TOTAL_MIB=23034
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# The commit every drafter run on the 3050 and 1650 Ti used. The driver (595.112.07)
# supports CUDA 13.2, so the toolkit is 13.1 from NVIDIA's apt repo on the image;
# 13.3/13.4 would be newer than the driver.
LLAMA_CPP_DIR=/opt/llamacpp/llama.cpp
LLAMA_CPP_COMMIT=77c4540ce
LLAMA_SERVER_BIN=/opt/llamacpp/llama.cpp/build/bin/llama-server
CUDA_HOME=/usr/local/cuda-13.1
CUDA_ARCH=89

# ── Serving (the 3050 rig's flags) ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
N_GPU_LAYERS=99
CONTEXT_SIZE=131072
KV_CACHE_TYPE=f16
FLASH_ATTENTION=1
METRICS=1
# g6.2xlarge has 8 vCPUs (the 3050 host: 6 cores / 12 threads, -t 6 -tb 12).
THREADS=4
THREADS_BATCH=8
PARALLEL_SLOTS=1
REASONING=off
OVERRIDE_TENSORS=per_layer_token_embd\.weight=CUDA0

# ── Speculative decoding ─────────────────────────────────────────────────────
SPEC_DRAFT_MODEL=/opt/models/e4b-draft/gemma-4-E4B-it-qat-assistant-q4_0-exact.gguf
SPEC_DRAFT_SHA256=dc965cb963e56b86fbc04db8efec83163886085e88514574650a57fa55a2ee24
SPEC_DRAFT_HF=xbill9/gemma-4-E4B-it-qat-assistant-q4_0-exact-gguf
SPEC_DRAFT_HF_REVISION=a9468097e5feb9df13d25bd624f47edabfda0992
SPEC_DRAFT_N_MAX=2
