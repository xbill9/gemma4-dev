# Deployment parameters for this rig — the single source of truth.
#
# Read by: server.py (via python-dotenv), mcp-run.sh (which launches the MCP server),
# the Makefile (via -include), and set_env.sh. Change a value here and every one of
# them follows. A real environment variable always wins over anything set here, so
# `GOOGLE_CLOUD_ZONE=us-central1-b make status` still works for a one-off.
#
# Zone note: us-west4 has no v6e at all — no v6e-1 accelerator type in any of its zones
# and no v6e SKU in the billing catalog — so the v5e rig's default zone cannot serve this
# one. us-east5-b offers v6e-1 and the project has 512 chips of v6e quota there (verified
# 2026-08-07). See the gotcha in CLAUDE.md before changing.

GOOGLE_CLOUD_PROJECT=aisprint-491218
GOOGLE_CLOUD_REGION=us-east5
GOOGLE_CLOUD_ZONE=us-east5-b

MODEL_NAME=google/gemma-4-E2B-it
# v6e (Trillium) keeps its marketing name in the TPU API — unlike v5e, which is spelled
# v5litepod-1. The matching Flex-start runtime is v2-alpha-tpuv6e (TPU_RUNTIME_VERSION).
ACCELERATOR_TYPE=v6e-1
TENSOR_PARALLEL_SIZE=1

# Serving parameters. See SERVING-PARAMS.md for the decision and its evidence.
#
# 16384 was the v5e-era default this rig inherited at the fork, sized for a chip with
# ~5.5 GiB left for KV. v6e-1 has 19.79 GiB. 32768 measured equal-or-better than 16384 on
# every cell on v5e-1 at a quarter of the KV pool, so it is safe here by a wide margin.
#
# 65536 is also known to work on this exact chip and checkpoint: the allocation recorded in
# gemma4-e2b-v6e1-demo.html (and cited by ../HARDWARE.md) is a 65536 run — 1,151,744 KV
# tokens. Raising this to 65536 is a supported one-line change, not a leap; 32768 is set
# here only because it is the value with a measured throughput sweep behind it.
MAX_MODEL_LEN=32768

# Name of what this rig provisions: the Queued Resource id for the MCP tools (its node is
# <RESOURCE_ID>-node) and, as SERVICE_NAME, the tpu-vm for the Makefile's separate path.
# Left unset, both derive from the rig directory name — tpu-vllm-v6e1-2b. Set them only to
# reach a resource created under an older name; a rename otherwise orphans it.
#RESOURCE_ID=vllm-gemma4-qr
#SERVICE_NAME=tpu-2B-v6e1-devops-agent

# Name this rig's MCP server advertises, and the key the client must register it under —
# that key prefixes every tool, as mcp__<name>__find_tpu. Left unset it derives from the rig
# directory (tpu-vllm-v6e1-2b), which is what keeps the sibling rigs distinguishable; they
# previously all registered as "tpu-devops". Set it only to match a client that has
# already registered this server under a different key. `make mcp-config` writes a .mcp.json
# using the same value.
#MCP_SERVER_NAME=tpu-vllm-v6e1-2b

# Default provisioning model for the Queued Resource tools: flex-start, spot, or on-demand.
# Every creation tool takes a provisioning_model argument that overrides this per call.
#   flex-start - queues for scarce capacity, self-terminates after 4h. Sold as "DWS Defined
#                Duration V6e" and published in us-east5; see the zone note above.
#   spot       - cheapest, drawn from the separate preemptible quota (TPU_SPOT_QUOTA_ID),
#                reclaimable with ~30s notice, and NOT bounded by max-run-duration.
#   on-demand  - full price, no preemption, also unbounded. Destroy it yourself.
PROVISIONING_MODEL=flex-start
