# tokenlab-sglang-amd-31b — Gemma 4 31B through AMD Token Lab's hosted API.
#
# Nothing here provisions anything: Token Lab is someone else's server. This file
# names the endpoint and the model; the API key lives in .env (mode 0600, gitignored)
# as TOKENLAB_API_KEY. A real environment variable wins over either file.
#
# Read 2026-11-13 from GET /v1/models and the Token Lab page (notebooks.amd.com/tokenlab):
#   id                  Gemma-4-31B-IT ("Gemma 4 31B")
#   description         "Dynamic sglang-router service managed by Model Ops"  -> slot 2 is sglang
#   context_length      262144
#   input_modalities    text, image
#   supported params    temperature, max_tokens, top_p, stream, response_format, tools,
#                       tool_choice, reasoning_effort
#   hardware            not disclosed ("served on AMD Instinct and Radeon")      -> slot 3 is amd
#   rate                0.035 pts / 1M input tokens, 0.07 pts / 1M output tokens
#   per-model limit     128 requests at once across all users (HTTP 429
#                       model_concurrency_rate_limit_exceeded, Retry-After: 1)
#   key                 30-day access period, 10.00 starting points

TOKENLAB_BASE_URL=https://api.tokenlab.amd.com/v1
MODEL_NAME=Gemma-4-31B-IT
CONTEXT_LENGTH=262144
PLATFORM_NOTE=AMD Token Lab (hosted, OpenAI-compatible)
RUNTIME_NOTE=SGLang router (from /v1/models)
HARDWARE_NOTE=AMD Instinct or Radeon (not disclosed)

# Retries for 429 (rate or concurrency limit) and 502/503/504 before a stream starts.
# Token Lab's FAQ: retry after a few seconds, honour Retry-After.
RETRY_MAX=30
RETRY_WAIT_S=2

# Local chat page (chat_ui.py) binds 127.0.0.1 only.
UI_PORT=8766
