# local-llamacpp-sdm850-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# Forked 2026-10-11 from local-llamacpp-cpu-2b-q4_0 (i7-10750H, x86_64). Same
# runtime, same GGUF, same serving flags; slot 3 is the only slot that differs, so
# the pair is an x86_64-vs-aarch64 CPU comparison on identical weights. It is NOT
# a controlled A/B: different machines, different llama.cpp commits, different
# days. Nothing in that rig's benchmarks/ describes this host.

# ── Model ────────────────────────────────────────────────────────────────────
# MODEL_NAME is the upstream artifact; MODEL_PATH is what llama.cpp opens. The
# GGUF lives outside the git work tree on purpose.
# 2026-09-29: the exact Q4_0 rebuild, v2. Google's GGUF metadata byte for byte, with
# all 275 layer matrices, both embedding tables and per_layer_model_proj rebuilt as
# Q4_0 from google/gemma-4-E2B-it-qat-q4_0-unquantized on the trained grid step; only
# 1.1 MB of F32 norms is stored otherwise. Built by gguf_exact.py in
# local-llamacpp-1650ti-2b-q4_0/benchmarks/runs/2026-09-29-exact-gguf-v2-1650ti.
# SHA-256 419db9a6bf3bc15d770c85ccf9216827aa88c64fe8f3d72fbe5674f48efe2dc8.
# Published: the Hugging Face repo below has held v2 since revision 74b2c92; v1
# (25f21f14...) is at revision e5d65c8. MODEL_SHA256 decides, not the name.
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-exact-gguf
MODEL_PATH=/home/xbill/models/gemma-4-E2B-it-qat-q4_0-exact-v2/gemma-4-E2B-it-q4_0-exact.gguf
MODEL_SHA256=419db9a6bf3bc15d770c85ccf9216827aa88c64fe8f3d72fbe5674f48efe2dc8

# Slot 5 of the directory name. Since 2026-09-29 every weight matrix in the file
# is Q4_0 (Google's file, served until then, was mostly Q6_K by bytes).
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED 2026-10-11 from lscpu, /proc/cpuinfo, /proc/meminfo, DMI and the device
# tree. Lenovo Yoga C630 (DMI 81JL), bare metal (systemd-detect-virt: none).
#
# The SoC is a Snapdragon 850 (SDM850) by Lenovo's spec. The device tree says
# `qcom,sdm845` because mainline Linux describes the 850 with the 845's tree — the
# 850 is a higher-binned 845 — so do not "correct" slot 3 from that string.
#
# HETEROGENEOUS, and the kernel says so through cpu_capacity, not through
# /sys/devices/cpu_core (an Intel-hybrid path that does not exist on ARM):
#   cpu0-3  Kryo 385 Silver (Cortex-A55-derived)  capacity  379   max 1766 MHz
#   cpu4-7  Kryo 385 Gold   (Cortex-A75-derived)  capacity 1024   max 2842 MHz
# No SMT. The big cores are the HIGH-numbered ones, so a mask that picks "the
# first N" picks the slow cluster.
ACCELERATOR_TYPE=cpu
CPU_MODEL="Qualcomm Snapdragon 850 (Kryo 385, 4x Gold + 4x Silver)"
CPU_CORES=8
CPU_THREADS=8
CPU_P_CORE_LOGICAL=4-7
CPU_E_CORE_LOGICAL=0-3
# /proc/cpuinfo: fp asimd aes pmull sha1 sha2 crc32 atomics fphp asimdhp asimdrdm
# lrcpc dcpop. NO asimddp (dot product), NO i8mm, NO sve. llama.cpp's cmake reports
# -U__ARM_FEATURE_DOTPROD: its Q4_0 kernels run without SDOT, on plain NEON.
CPU_SIMD="neon fp16"
# 7.3 GiB MemTotal, with a GNOME session holding ~3-4 GiB of it. The 3.35 GB GGUF
# is an mmap, so it competes with the page cache rather than with anon memory.
HOST_RAM_GIB=7
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# A CPU-only build: GGML_CUDA=OFF, GGML_NATIVE=ON (cmake detected
# -mcpu=generic-armv8-a+lse+rdma+crc+crypto+fp16+rcpc). `make build` produces it.
LLAMA_CPP_DIR=/home/xbill/llama.cpp
# Cloned fresh on 2026-10-11 (Debian sid arm64, gcc 16.2.0). NOT the x86 rig's
# f95b0d9; differencing the two rigs carries an upstream delta as well as a CPU one.
LLAMA_CPP_COMMIT=23b0202a1
LLAMA_SERVER_BIN=/home/xbill/llama.cpp/build-cpu/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# The endpoint is not discovered; it is known before the process starts.
HOST=127.0.0.1
PORT=8080
ENDPOINT=http://127.0.0.1:8080

# NOT configurable. `-ngl 0` and an empty CUDA_VISIBLE_DEVICES are hardcoded in
# both `make serve` and server.py, because a CPU rig that can be flipped onto a
# GPU by one env line measures whichever device happened to be present.

# 18 KiB/token geometry (MODELS.md), but llama.cpp caps the 12 sliding layers at
# the 1024-cell window, so KV at 8192 is ~60 MiB, not 144 (MEASURED on the 1650ti
# sibling from the allocation log). Host RAM is not the constraint at this size.
CONTEXT_SIZE=8192

# UNMEASURED HERE. Carried from local-llamacpp-cpu-2b-q4_0 so the two CPU rigs
# serve identical flags apart from threads.
KV_CACHE_TYPE=f16

# UNMEASURED HERE. Carried from the x86 CPU rig.
FLASH_ATTENTION=1

# Prometheus metrics at $ENDPOINT/metrics. Operational visibility only — never
# the benchmark decode column (see CLAUDE.md).
METRICS=1

# MEASURED 2026-10-11 (benchmarks/runs/2026-10-11-first-light-sdm850, llama-bench
# pp512/tg128, cooldown-gated): decode 5.00 tok/s on the 4 Gold cores, 2.18 on all
# 8 — the Silver cores are stragglers and halve decode. Prefill 9.22 on all 8 vs
# 7.14 on 4 Gold. Unpinned -t 4 lands on the Gold cores by itself (5.01), so no
# affinity flag is passed; never raise THREADS above the Gold count.
THREADS=4
THREADS_BATCH=8

# One interactive session. llama.cpp SPLITS --ctx-size ACROSS SLOTS, so raising
# this without raising CONTEXT_SIZE shrinks each sequence.
PARALLEL_SLOTS=1

# Thinking, server-wide: llama-server --reasoning {on,off,auto}. Gemma 4 thinks by
# default and spent 1274 chars reasoning to answer "name three TPU generations"
# (CLAUDE.md, "Gemma 4 reasons"). OFF since 2026-09-29 for a single-user demo:
# answers arrive directly in `content`. A request can still ask for it with
# "chat_template_kwargs": {"enable_thinking": true}, which is what sweep.py does,
# so benchmark workloads do not depend on this key.
REASONING=off

