# lambda-vllm-g6-2b-q4w4a16emb4 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md, "The name is a claim").
# Committed on purpose and deliberately NOT gitignored. A real environment variable wins over it.
#
# ADDED 2026-11-18: Gemma 4 E2B as an AWS Lambda function on a GPU, through Lambda Managed Instances
# (LMI) GPU support announced 2026-11-18. Same checkpoint, revision and vLLM version as
# gpu-vllm-g6-2b-q4w4a16emb4 (one L4 in an EC2 G6) — slot 1 is the only slot that differs.
# Lambda provisions the g6.2xlarge; nothing here calls ec2 run-instances.

# ── Model ────────────────────────────────────────────────────────────────────
# Baked into the image at /opt/model (2,862,961,435 bytes at this revision), so the instance needs no
# Hugging Face access and nothing streams from S3.
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text-emb4
MODEL_REVISION=db715f83da4f13289761d7c45f4d19ceac84695d
QUANTIZATION=q4w4a16emb4

# ── Image ────────────────────────────────────────────────────────────────────
# AWS's Lambda vLLM base image. Its build args read FRAMEWORK_VERSION=0.33.0 (vLLM), PYTHON_VERSION=3.13,
# CUDA_VERSION=13.0.3, created 2026-11-16. Tags cuda-v1 and cuda-v1.0.15 both had this digest on 2026-11-18.
BASE_IMAGE=public.ecr.aws/lambda/deep-learning-containers/vllm@sha256:3272913a4db3d1f3d07c94674990f1e036d2fd94a92c6a1aa70008c6f3bbe744
VLLM_VERSION=0.33.0
ECR_REPO=lambda-vllm-g6-2b-q4w4a16emb4

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# g6.2xlarge: 8 vCPUs, 32,768 MiB, one L4 with 22,888 MiB (DescribeInstanceTypes, 2026-11-18).
# Only this type is allowed, so the hardware is the G6 flight's. The account's "Running On-Demand G and VT
# instances" quota in us-east-1 is 16 vCPUs (2026-11-18): two of these at most.
INSTANCE_TYPE=g6.2xlarge
ACCELERATOR_TYPE="NVIDIA L4"
CAPACITY_PROVIDER=gemma4-e2b-g6
MAX_VCPU_COUNT=16
# Empty = the default VPC's subnets and its default security group (outbound open).
SUBNET_IDS=
SECURITY_GROUP_IDS=
OPERATOR_ROLE=lambda-lmi-gpu-operator
EXECUTION_ROLE=lambda-lmi-gpu-exec

# ── Function ─────────────────────────────────────────────────────────────────
FUNCTION_NAME=gemma4-e2b-g6
# 16 GiB at 4 GiB per vCPU = 4 vCPUs; at the default 2 GiB per vCPU 16 GiB asks for 8 and the docs say a
# g6.2xlarge can refuse it (IncompatibleAcceleratorInstanceTypes).
MEMORY_MB=16384
MEMORY_GIB_PER_VCPU=4
# Minimum GPU memory, in GB (valid: 3, 6, 12, 16, 24, 48). 16 admits the L4.
ACCELERATOR_MEMORY_GB=16
EPHEMERAL_MB=10240
TIMEOUT_S=900
# Requests one execution environment takes at once; vLLM batches them. Max 48.
PER_ENV_MAX_CONCURRENCY=48
# Lambda's default is 3 execution environments across AZs, which exceeds the 16-vCPU quota. 1 for a demo.
# `make down` sets both to 0 (version kept, instances released); `make up` sets them back.
MIN_ENVS=1
MAX_ENVS=1

# ── Serving (gpu-vllm-g6-2b-q4w4a16emb4's values) ────────────────────────────
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=64
LANGUAGE_MODEL_ONLY=true
TOOL_CALL_PARSER=gemma4
REASONING_PARSER=gemma4
# Seconds the image's engine extension waits for vLLM during Init (default 600). Lambda's Init limit is
# the larger of 130 s and the function timeout, up to 900 s.
VLLM_SERVER_TIMEOUT=840

# ── Local chat page (chat_ui.py) ─────────────────────────────────────────────
# Token Lab's page uses 8766 and its agent 8767.
UI_PORT=8768

# ── Drafter (added 2026-11-18) ───────────────────────────────────────────────
# Google's E2B QAT assistant repacked as W4A16 by repack/repack_drafter.py (copied from
# gpu-vllm-g6-2b-q4w4a16emb4): model.safetensors SHA-256 66e683ad…860b, identical to the drafter on the
# gpu host. Baked into the image at /opt/drafter. 4 drafted tokens: the G6 flight's best on vLLM 0.33.
# Empty SPECULATIVE_MODEL = no drafter.
SPECULATIVE_MODEL=/opt/drafter
NUM_SPECULATIVE_TOKENS=4
DRAFTER_SOURCE=google/gemma-4-E2B-it-qat-q4_0-unquantized-assistant
DRAFTER_SOURCE_REVISION=ebc7e1a211354561464cb82ed6d886792138dcb6
