# gpu-ollama-g5g-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# STATUS: THIS RIG HAS SERVED NOTHING. Created 2026-09-02 alongside
# `gpu-llamacpp-g5g-2b-q4_0`. `benchmarks/` is empty on purpose.
#
# WHY IT EXISTS: it and the llama.cpp sibling SHARE AN ENGINE — Ollama links
# `libllama.so`, and the Gemma 4 graph both execute is upstream
# `src/models/gemma4.cpp`. They are two rigs because four differences are visible
# to a benchmark; CLAUDE.md has the byte counts. The practical asymmetry is that
# **Ollama ships a working aarch64 CUDA binary with native sm_75 SASS and
# llama.cpp makes you compile one**, so this rig has no build step at all.

# --- Model -------------------------------------------------------------------
# AN OLLAMA TAG, not a Hub id — a weaker claim than the sibling's, deliberately.
#
# `gemma4:e2b-it-qat` IS Google's QAT Q4_0 GGUF, RE-CONTAINERED. Verified
# 2026-09-02 from the registry manifest against the Hub:
#
#                    Ollama blob        Google file       delta
#   model         3,349,514,112 B    3,349,516,256 B    -2,144
#   projector       986,833,312 B      986,833,664 B      -352
#   digests       3646b4c1...        fa401b55...        differ
#
# Ollama strips the metadata it owns (the GGUF's embedded Google canonical chat
# template, published 2026-07-09) and re-hashes. Tensors presumed identical; the
# FILE provably is not.
#
# Do NOT repoint this at the Hub file through a Modelfile. That makes it a
# llama.cpp rig wearing an Ollama name and destroys the pair.
#
# The plain `gemma4:e2b` tag is a DIFFERENT artifact — one 7.162 GB model layer,
# no projector — so do not "simplify" the tag.
MODEL_NAME=gemma4:e2b-it-qat

# --- Hardware ----------------------------------------------------------------
INSTANCE_TYPE=g5g.2xlarge
AWS_REGION=us-east-1

# --- Runtime: DOWNLOADED, NOT BUILT ------------------------------------------
# The generic linux-arm64 bundle carries CUDA. Verified against v0.33.2
# (2026-08-27): 1543 MB — larger than amd64 — containing cuda_v12/ and cuda_v13/
# with libggml-cuda.so, libcublas, libcublasLt, libcudart, beside libllama.so.
#
# The jetpack5/jetpack6 bundles are separate and are for Jetson. The binary logs
# "jetpack not detected ... skipping" on a G5g and falls through to these two.
OLLAMA_VERSION=v0.33.2

# THE MOST IMPORTANT LINE IN THIS FILE.
#
# MEASURED 2026-09-02 by walking the fatbin headers in both libggml-cuda.so and
# decompressing one entry of each kind (kind=1 is PTX text, kind=2 a CUDA ELF
# with e_machine=190):
#
#   cuda_v12  CUBIN sm_60 61 70 75 80 86 89 90 100 120  + PTX sm_50..120
#   cuda_v13  PTX ONLY for every arch — ZERO CUBIN
#
# Ollama picks by DRIVER VERSION. This rig's DLAMI carries a CUDA 13 driver, so
# unpinned it selects cuda_v13 and JITs every kernel from PTX at load. That
# works, but the warm-up becomes a property of the deployment and gets recorded
# as a property of the engine.
#
# cuda_v12 has native Turing SASS. The llama.cpp sibling builds native sm_75 too,
# so PINNING IS WHAT MAKES THE PAIR COMPARABLE. Unset it and the A/B silently
# measures codegen instead of runtime.
OLLAMA_LLM_LIBRARY=cuda_v12

# --- Serving -----------------------------------------------------------------
SERVICE_NAME=ollama-g5g
HF_SECRET_ID=vllm/hf-token
APP_DIR=/opt/ollama-g5g

# Ollama's own default is 11434. Pinned to 8000 to match every sibling, so one
# sweep command works against all of them.
LLAMA_PORT=8000

# OLLAMA'S DEFAULT IS 0, WHICH MEANS "4k/32k/256k BASED ON VRAM". Unpinned, two
# instance sizes get two different contexts and nothing announces it. Matched to
# the llama.cpp sibling's --ctx-size.
CONTEXT_SIZE=4096

# Ollama's own default is already 1; stated explicitly because a default is not a
# decision until someone writes it down. Raise it only in a run whose REPORT.md
# says so — the PyTorch sibling measured 7.84x from batching, and changing this
# silently invalidates every existing comparison.
PARALLEL_SLOTS=1

# KEEP THE MODEL LOADED. Ollama unloads after 5 minutes idle by default, so a
# sweep that pauses between cells pays a full reload and records it as latency.
# Negative means forever.
#
# No sibling has this knob: llama-server, vLLM and our own JAX/PyTorch servers
# all hold weights for the life of the process. It is purely a daemon property,
# which is exactly what this rig exists to surface.
OLLAMA_KEEP_ALIVE=-1

# --- AMI ---------------------------------------------------------------------
# This rig only needs the NVIDIA DRIVER — it compiles nothing, and Ollama ships
# its own CUDA runtime inside the bundle.
#
# The full PyTorch DLAMI is kept anyway, DELIBERATELY: it is what the llama.cpp
# sibling must use (it needs nvcc), and an A/B pair that differs in its base
# image is measuring the image as well as the runtime. **Keep both rigs on this
# same parameter even though this one could use a smaller image.**
DLAMI_SSM_PARAMETER=/aws/service/deeplearning/ami/arm64/oss-nvidia-driver-gpu-pytorch-2.12-ubuntu-24.04/latest/ami-id
DLAMI_NAME=Deep Learning ARM64 AMI OSS Nvidia Driver GPU PyTorch*Ubuntu*

# --- Storage -----------------------------------------------------------------
# The 1.5 GB bundle, its extraction, and ~4.3 GB of model blobs share this volume.
ROOT_VOLUME_GB=100
ROOT_VOLUME_THROUGHPUT_MBPS=500
ROOT_VOLUME_IOPS=6000
