# Deployment parameters for this rig — the single source of truth.
#
# Read by: server.py (via python-dotenv), mcp-run.sh (which launches the MCP server),
# the Makefile (via -include), and set_env.sh. Change a value here and every one of
# them follows. A real environment variable always wins over anything set here, so
# `GOOGLE_CLOUD_ZONE=us-east5-a make status` still works for a one-off.
#
# THIS RIG PROVISIONS THROUGH COMPUTE ENGINE, NOT THE CLOUD TPU API. It is the A/B twin of
# tpu-vllm-v5e1-2b: same chip, same checkpoint, same vLLM flags, different control plane.
# Keep the serving parameters below in step with that rig or the comparison stops being one.
#
# ⚠️  AND UNLIKE THE v6e AND v5p GCE RIGS, THIS PATH IS NOT KNOWN TO EXIST FOR v5e. Google's
# v5e page says v5e "is supported using Google Kubernetes Engine and the Cloud TPU API";
# Compute Engine is not named, and `ct5lp` is absent from the CE machine-types page. The
# machine type, image family and CE quota below are all real, and all explainable by the TPU
# API and GKE being implemented on Compute Engine underneath. Nothing here has provisioned
# anything. See CLAUDE.md and ../HARDWARE.md before spending money against it.

GOOGLE_CLOUD_PROJECT=aisprint-491218
GOOGLE_CLOUD_REGION=us-west4
GOOGLE_CLOUD_ZONE=us-west4-a

MODEL_NAME=google/gemma-4-E2B-it

# --- What Compute Engine actually consumes -----------------------------------------------
# MACHINE_TYPE is the real accelerator request on this path. ct5lp-hightpu-1t is one v5e
# chip, 24 vCPU / 48 GB — a third of the v6e shape's host. Unlike v6e and v5p, v5e publishes
# no `<name>-tpu` twin, so there is exactly one string to choose. Published in 26 zones
# including us-west4-a (verified 2026-08-10).
MACHINE_TYPE=ct5lp-hightpu-1t
# Replaces the TPU API's --runtime-version (v2-alpha-tpuv5-lite on the sibling rig). Pin the
# FAMILY, never a dated build: images ship roughly weekly and every superseded build goes
# DEPRECATED within the fortnight. Note the family name says v5e out loud.
IMAGE_FAMILY=ubuntu-accel-2204-amd64-tpu-v5e-v5p-v6e
IMAGE_PROJECT=ubuntu-os-accelerator-images
# The image default is 10GB, which cannot hold the vLLM TPU image. Undersizing fails late,
# after boot, during the docker pull.
BOOT_DISK_SIZE_GB=200

# ACCELERATOR_TYPE is documentation here — the Cloud TPU API's spelling, kept so benchmark
# reports and the directory name line up with the sibling rig. NEVER passed to gcloud on
# this path; `gcloud compute instances create` would reject it.
ACCELERATOR_TYPE=v5litepod-1
TENSOR_PARALLEL_SIZE=1

# Serving parameters. Held identical to tpu-vllm-v5e1-2b on purpose — this rig varies the
# control plane and nothing else, so any difference here would confound the comparison.
#
# 16384 is what that rig actually serves (it leaves MAX_MODEL_LEN unset and takes server.py's
# default), sized for a chip with ~5.5 GiB left for KV. Note SERVING-PARAMS.md recommends
# 32768 on measured evidence — that gap is unresolved in the twin as well, so close it in both
# rigs or neither. Do not reach for the v6e GCE rig's 32768 by analogy: v5e has 16 GB of HBM
# against v6e's 32.
MAX_MODEL_LEN=16384

# --- Provisioning -------------------------------------------------------------------------
# flex-start, spot, on-demand, or reservation-bound. These are this rig's lowercase labels;
# server.py maps them to gcloud's SCREAMING_CASE --provisioning-model values. Every creation
# tool takes a provisioning_model argument that overrides this per call.
#   flex-start        - FLEX_START. Queues for scarce capacity via Dynamic Workload
#                       Scheduler, then self-deletes at MAX_RUN_DURATION.
#   spot              - SPOT. Reclaimable with ~30s notice. On v5e in us-west4 spot is the
#                       CHEAPEST of the three ($0.5779 vs flex-start's $0.60) — the reverse
#                       of the v6e ordering in us-east5. Read estimate_deployment_cost.
#   on-demand         - STANDARD. Full price, no preemption.
#   reservation-bound - RESERVATION_BOUND. Consumes a calendar or dense-deployment
#                       reservation. HAS NO QUEUED RESOURCE EQUIVALENT — only on this path.
#
# On the TPU API, flex-start v5litepod-1 was accepted in us-west4-a and refused everywhere
# else tried. Whether that zone restriction carries over to Compute Engine is unknown, and
# is a second unverified thing on top of whether the path works for v5e at all.
PROVISIONING_MODEL=flex-start
# How long to keep asking for flex-start capacity, and how long the VM may run once granted.
# Unlike the TPU API, --max-run-duration is not flex-start-only here: spot and on-demand get
# an automatic stop too, paired with --instance-termination-action=DELETE.
REQUEST_VALID_FOR=2h
MAX_RUN_DURATION=4h

# --- Quota: the trap this rig exists to document -------------------------------------------
# The two control planes meter against DIFFERENT POOLS. TPU API quota does not carry over.
#
# v5e is more symmetrical than v6e here, and it is the one place the retarget from the v6e
# rig is not a search-and-replace: v6e publishes only a PREEMPTIBLE per-zone id and has to
# fall back to a regional family-wide quota for everything else, whereas v5 Lite PodSlice
# publishes both halves per-zone. Verified 2026-08-10: both ids exist, each with a single
# default bucket reading -1 across 130 locations and no per-zone override on this project.
#
# A -1 default is not a grant — it means nobody has ever set this quota here, which reads
# identically whether the real ceiling is unlimited or zero.
GCE_QUOTA_ID=TPU-LITE-PODSLICE-V5-per-project-zone
GCE_SPOT_QUOTA_ID=PREEMPTIBLE-TPU-LITE-PODSLICE-V5-per-project-zone
# Family name for the regional TPUS-PER-TPU-FAMILY-per-project-region quota, reported for
# comparison only. This project has NO CT5LP bucket in it at all (it holds CT6E=32 in eight
# regions, plus CT3P and CT3), which is why that id is not GCE_QUOTA_ID here.
GCE_TPU_FAMILY=CT5LP
# The sibling rig's ids, kept only so comparison tooling can report both. Compute Engine
# does not consult them.
TPU_QUOTA_ID=TPUV5sLitepodPerProjectPerZoneForTPUAPI
TPU_SPOT_QUOTA_ID=TPUV5sPreemptibleLitepodPerProjectPerZoneForTPUAPI

# Name of the instance this rig provisions. On this path the instance IS the node — there is
# no Queued Resource indirection and no derived <id>-node. Left unset it derives from the rig
# directory (gce-vllm-v5e1-2b). Set it only to reach something created under an older name;
# a rename otherwise orphans it and it keeps billing.
#INSTANCE_NAME=gce-vllm-v5e1-2b
#SERVICE_NAME=gce-vllm-v5e1-2b

# Name this rig's MCP server advertises, and the key the client must register it under —
# that key prefixes every tool, as mcp__<name>__find_tpu. Left unset it derives from the rig
# directory (gce-vllm-v5e1-2b), which is what keeps it distinguishable from the TPU-API twin
# registered as tpu-vllm-v5e1-2b. `make mcp-config` writes a .mcp.json using the same value.
#MCP_SERVER_NAME=gce-vllm-v5e1-2b
