.mcp.json

# Local env config (non-secret, but machine-specific)
.env

# No .aws_creds line, and no save-aws-creds.sh. This rig has no cloud account
# to authenticate against: nothing is provisioned, so there is nothing to sign
# a request to. The script and its ignore rule were deleted with the control
# plane on 2026-08-29 rather than left as dormant credential-handling code.

# Build artifacts
dist/

# Serving state: the pidfile and the serving log. STATE_DIR defaults to
# ~/.local/state/local-jax-cpu-2b so these normally live outside the tree, but
# STATE_DIR is overridable and pointing it here is an obvious thing to do.
#
# Deliberately NOT a blanket `*.log`: logs under benchmarks/runs/ are COMMITTED
# as the record of a measurement (monorepo CLAUDE.md), and a wildcard here would
# silently drop them.
.state/

# NOTE: tpu.env is NOT ignored. It is the rig's source of truth and is committed
# on purpose — never add *.env here.
