# gpu-vllm-g6-2b — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: mcp-run.sh exports only unset keys, Makefiles
# use ?=, and dotenv does not overwrite.
#
# STATUS: THIS RIG HAS SERVED NOTHING. Forked from `gpu-vllm-g5g-2b` 2026-08-28 to
# move vLLM off Turing/aarch64 onto Ada/x86_64 (NVIDIA L4, SM 8.9). `benchmarks/`
# is deliberately empty and no run directory was copied at the fork.
#
# EVERY value below marked MEASURED was measured on G5g (T4G, Turing, Graviton2),
# NOT here. This fork changes BOTH the GPU generation AND the host architecture,
# so fewer values carry than across any other fork in this tree. Treat all of them
# as PREDICTED until re-run.
#
# WHY THIS RIG EXISTS: it is the runtime control for `gpu-jax-g6-2b`. That rig
# MEASURED 48.3-48.5 tok/s on this exact silicon under pure JAX on 2026-08-28.
# Same chip, same checkpoint, different runtime -- which would be the only clean
# runtime comparison in this tree, because the T4G pair was never clean: the vLLM
# side there ran with hand-reduced Triton tiles.
#
# AND IT REMOVES THE SIBLING'S REASON FOR EXISTING. `gpu-vllm-g5g-2b` needs a
# ~67-minute from-source build because G5g needs aarch64 AND SM 7.5, and the
# published arm64 manifest carries `8.0 8.7 8.9 9.0 10.0 11.0 12.0` while only
# the amd64 manifest carries 7.5. G6 is x86_64 and 8.9 -- BOTH in the published
# image -- so there is no build, no CUDA toolkit, no Rust and no Triton patch.

# --- Model -------------------------------------------------------------------
# Reference instruction-tuned release, so the rig name carries no encoding slot.
# MODELS.md: 10.2 GB / 9.5 GiB of bf16 weights, 18 KiB/token of KV. Fits the L4's
# 23034 MiB with far more room for a KV pool than the T4G's 15360 had.
MODEL_NAME=google/gemma-4-E2B-it

# --- Hardware ----------------------------------------------------------------
# The hardware slot is `g6` — the EC2 instance family, by the general EC2 rule in
# NAMING.md (`g5g`, `g4dn`, `g6`, `g6f`), NOT the GPU SKU. The GPU is an NVIDIA
# L4. Family rather than SKU keeps `g6` distinct from `g6f`, which is HALF an L4,
# and pins the x86_64 host — which matters concretely here, because the host
# architecture is exactly what changed at this fork.
#
# Do NOT "correct" this to `l4`. The five `gpu-vllm-l4-*` rigs predate the rule,
# are ARTIFACT rigs, and their provenance is the weakest in the tree.
INSTANCE_TYPE=g6.xlarge
AWS_REGION=us-east-1

# TWO TRAPS relative to the G5g table this replaces:
#   * Host RAM DOUBLED at every matching suffix. g6.xlarge has 16 GiB where
#     g5g.xlarge had 8 -- so the sibling's "xlarge cannot stage the weights"
#     verdict DOES NOT transfer, and g6.xlarge is a reasonable default here where
#     g5g.xlarge was not.
#   * g6.16xlarge is SINGLE-GPU despite the suffix, where g5g.16xlarge had two.
#     GPU count is not monotonic in the size. Never infer it from the name.
#
#   size          GPUs  GPU mem  vCPU   RAM
#   g6.xlarge      1      24 GB    4    16 GB   <- default
#   g6.2xlarge     1      24 GB    8    32 GB
#   g6.4xlarge     1      24 GB   16    64 GB
#   g6.8xlarge     1      24 GB   32   128 GB
#   g6.12xlarge    4      96 GB   48   192 GB
#   g6.16xlarge    1      24 GB   64   256 GB
#   g6.24xlarge    4      96 GB   96   384 GB
#   g6.48xlarge    8     192 GB  192   768 GB
#
# G6 is 4 GiB of RAM per vCPU; G5g was 2. Any inherited `RAM // 2` vCPU shortcut
# silently DOUBLES the answer here. server.py reads it from the table instead.
TENSOR_PARALLEL_SIZE=1

# --- Ada (SM 8.9) --- the Turing constraints DO NOT apply ---------------------
# Ada HAS a native bfloat16 datapath, and fp8 as well. On the T4G neither existed:
# PyTorch ran bf16 by upconverting and vLLM logged `Casting torch.bfloat16 to
# torch.float16`, so float16 was the honest setting there.
#
# bfloat16 here, and the reason is not just "the part supports it": THE
# CHECKPOINT IS BF16. Setting float16 would make vLLM convert every weight, and
# `gpu-jax-g6-2b` MEASURED exactly that mismatch costing 54% of decode on Turing
# (0.0% once the dtypes matched). Matching the checkpoint is the cheap default.
DTYPE=bfloat16

# `auto` keeps KV at the model dtype. fp8 KV is newly REACHABLE here and is
# deliberately NOT enabled: KV is ~18 KiB/token, so the whole cache at 16K
# context is ~288 MiB against 23034 MiB of device memory -- it is not the binding
# constraint, and nothing here has measured its accuracy cost. Enable it with a
# measurement, not because the part supports it.
KV_CACHE_DTYPE=auto

# NOTE: there is deliberately no VLLM_ATTENTION_BACKEND here, and the reason is
# MEASURED on the sibling 2026-08-12 rather than assumed. It was once set to
# XFORMERS on the theory that FlashAttention needs SM 8.0+; in fact vLLM v0.27
# does not recognize the variable at all ("Unknown vLLM environment variable
# detected"), AND it forces TRITON_ATTN for Gemma 4 regardless, because the
# model's head dims are heterogeneous (sliding 256 / global 512) and only FA4 or
# Triton handle that. Setting it did nothing; it would be dead config.
#
# THAT MEASUREMENT WAS ON SM 7.5 AND THE DISPATCH MAY DIFFER ON 8.9. What does
# NOT differ is the model's head dims, so TRITON_ATTN is still the likely path.
# The open question is whether its 512-wide tile fits: it wants ~96 KiB of shared
# memory per block, Turing caps a block at 64 KiB (which is why the sibling
# carries an unlanded patch shrinking the tile), and Ada allows ~99 KiB. It
# should fit unpatched. UNVERIFIED ON HARDWARE -- this is the first thing to
# check on this rig, and server.py leaves the backend unpinned so vLLM dispatches
# for the real part.

# The T4G MEASURED 15360 MiB total and 13501 MiB in use while serving, giving a
# 2.95 GiB KV pool = 329,579 tokens at 0.90. The L4 has 23034 MiB, so the same
# fraction should yield a substantially larger pool -- ARITHMETIC, not measured.
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=8

# --- Serving -----------------------------------------------------------------
VLLM_PORT=8000
SERVICE_NAME=vllm-g6
HF_SECRET_ID=vllm/hf-token

# THE PUBLISHED IMAGE IS THE IMAGE. On x86_64 + SM 8.9 both axes are covered by
# the published amd64 manifest, so there is nothing to build and the sibling's
# VLLM_STOCK_IMAGE / VLLM_IMAGE split is collapsed to one name. That split only
# ever meant "what you pull" versus "what you spent 67 minutes compiling".
#
# THE TAG IS NOT THE SIBLING'S STOCK TAG. That rig's VLLM_STOCK_IMAGE was
# v0.27.1, but it used that tag ONLY to reproduce the SM 7.5 failure -- it never
# served from it, and built its real image from VLLM_REF=v0.27.2rc0. So v0.27.1
# is BELOW the measured floor and was an easy tag to inherit by mistake.
#
# MEASURED on the sibling: v0.26.0 dies with AmbiguousGlobalPerLayerAttributeError
# against current transformers, because Gemma 4's head_dim is per-layer. The
# per_layer_config handling that fixes it landed in v0.27.2rc0. DO NOT PIN BELOW
# THIS -- the constraint is the MODEL, not the chip, so it carries across the
# fork unchanged.
VLLM_IMAGE=vllm/vllm-openai:v0.27.2rc0

# TORCH_CUDA_ARCH_LIST, VLLM_REF and CUDA_TOOLKIT_PACKAGE are GONE, not blank.
# Nothing on this rig compiles, so an arch list, a source ref and a toolkit
# package would be inert settings that look meaningful. Do not reintroduce them
# without a build to feed.

# --- Root volume -------------------------------------------------------------
# The image pull lands here (multiple GB) and the checkpoint downloads here
# (10.2 GB). Throughput is set EXPLICITLY because gp3 defaults to 125 MiB/s.
#
# PORTED FROM `gpu-jax-g6-2b`, where it is MEASURED: two unrelated load stages
# both landed on ~125 MB/s, the signature of a volume ceiling rather than CPU or
# network, and raising it took that rig's read_shards 73.5s -> 24.7s (3.0x).
# This rig adds a multi-GB image pull on top, so the ceiling should bind at least
# as hard. UNMEASURED HERE.
#
# gp3 requires throughput <= IOPS * 0.25, and that rule is enforced at
# run-instances time -- violating it fails a LAUNCH, not just a disk.
ROOT_VOLUME_GB=100
ROOT_VOLUME_THROUGHPUT_MBPS=500
ROOT_VOLUME_IOPS=6000

# --- AMI ---------------------------------------------------------------------
# x86_64 GPU DLAMI. The architecture requirement FLIPPED at this fork: the
# sibling needs arm64, and an arm64 image cannot boot a G6 at all.
#
# BASE, not PyTorch: this rig serves from a docker image carrying its own CUDA
# and torch, so a PyTorch DLAMI is GBs of unused image. The DLAMI supplies the
# NVIDIA driver and docker, nothing else.
#
# `/latest/` in a DLAMI path is only the newest build WITHIN one PyTorch-and-
# Ubuntu line, and AWS stops rebuilding a line -- the sibling pinned
# `pytorch-2.7-ubuntu-22.04`, which froze at a 2026-05-02 image while reading as
# "track latest". This exact path was VERIFIED ON HARDWARE by `gpu-jax-g6-2b`
# on 2026-08-28: driver 595.91.07, Ubuntu 26.04, 66-second bootstrap.
DLAMI_SSM_PARAMETER=/aws/service/deeplearning/ami/x86_64/base-oss-nvidia-driver-gpu-ubuntu-26.04/latest/ami-id

# Fallback for describe-images. It must NOT require "ARM64 AMI" contiguously the
# way the sibling's pattern did: the base images are named "Deep Learning Base
# OSS Nvidia Driver GPU AMI (Ubuntu 26.04)". Changing the SSM path without
# changing this filter in the same commit is a revert that reports success --
# the fallback quietly resolves the old image.
DLAMI_NAME=Deep Learning Base OSS Nvidia Driver GPU*Ubuntu*
