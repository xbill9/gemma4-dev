# local-pytorch-cpu-2b — source of truth. Committed on purpose.
#
# The directory name describes; this file decides. `tpu.env` is the filename
# every rig in this tree uses, including the ones with no TPU in them.

# ---------------------------------------------------------------------------
# Model. A Hub id, resolved from the local HF cache — 10,246,621,918 B of bf16
# safetensors, MEASURED, already present at
# ~/.cache/huggingface/hub/models--google--gemma-4-E2B-it.
#
# NOT the -qat-w4a16-ct export. That one is 8.32 GB and only 12.5% of it is
# actually 4-bit (@MODELS.md): its `ignore` list keeps the PLE, the embeddings
# and both towers at bf16, so it saves 19% and costs a quantized load path.
# NOT the q4_0 GGUF either — transformers reads it but dequantizes to fp32 and
# silently drops 35 `layer_scalar` tensors (@QUANTIZATION.md), which makes it a
# converter rather than a serving path.
MODEL_NAME=google/gemma-4-E2B-it
MODEL_SAFETENSORS_BYTES=10246621918

# ---------------------------------------------------------------------------
# Hardware. There is no accelerator in play and slot 3 is `cpu` for that reason.
#
# THE BOX HAS A GPU AND THIS RIG DELIBERATELY DOES NOT USE IT. The GTX 1650 Ti
# has 4096 MiB; these weights are 10.25 GB and transformers has no equivalent of
# llama.cpp's lazy PLE gather, so `device_map="auto"` would spill most of the
# model to host anyway and measure the PCIe link rather than either processor.
# If a GPU PyTorch rig is ever wanted here it needs its own directory and slot 3
# = `1650ti`; do not add a device flag to this one.
ACCELERATOR_TYPE=none
CHIP_COUNT=0
DEVICE=cpu

# MEASURED on this host 2026-09-04.
HOST_CPU="Intel(R) Core(TM) i7-10750H CPU @ 2.60GHz"
HOST_CPU_CORES=6
HOST_CPU_THREADS=12
HOST_ISA=avx2,f16c
HOST_RAM_TOTAL_BYTES=16420000000

# ---------------------------------------------------------------------------
# Compute dtype. bf16, and the reason is memory, not speed.
#
# fp32 would be 20.5 GB and does not fit this host at all. bf16 halves that to
# 10.25 GB, which does fit — MEASURED 11.80 GB available at the time of the
# first run. torch accepts bf16 on x86 regardless of AVX512-BF16; that flag
# governs whether there is a fast datapath, not whether the dtype is legal.
# This CPU has AVX2 only, so expect bf16 to be emulated and slow.
DTYPE=bfloat16

# Six physical cores. The other six are SMT siblings that share execution units,
# and a memory-bound decode gains nothing from oversubscribing them.
TORCH_NUM_THREADS=6
OMP_NUM_THREADS=6

# ---------------------------------------------------------------------------
# Generation. GEMMA 4 IS A REASONING MODEL: it emits a thinking block first, so
# a small budget measures the thinking phase and returns no answer. 1024 is the
# floor for a completed task; the first-light run used 128 deliberately and
# recorded that it measured thinking only.
MAX_NEW_TOKENS=1024
