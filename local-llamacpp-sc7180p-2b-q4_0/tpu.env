# local-llamacpp-sc7180p-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# Forked 2026-10-11 from local-llamacpp-sdm850-2b-q4_0 (Snapdragon 850, aarch64).
# Same runtime, same GGUF, same serving flags apart from threads; slot 3 is the only
# slot that differs, so the pair is a with-vs-without dot product comparison on
# identical weights. It is NOT a controlled A/B: different machines, different
# llama.cpp commits (f2cc7282c here, 23b0202a1 there). Nothing in that rig's
# benchmarks/ describes this host.

# ── Model ────────────────────────────────────────────────────────────────────
# MODEL_NAME is the upstream artifact; MODEL_PATH is what llama.cpp opens. The
# GGUF lives outside the git work tree on purpose.
# 2026-09-29: the exact Q4_0 rebuild, v2. Google's GGUF metadata byte for byte, with
# all 275 layer matrices, both embedding tables and per_layer_model_proj rebuilt as
# Q4_0 from google/gemma-4-E2B-it-qat-q4_0-unquantized on the trained grid step; only
# 1.1 MB of F32 norms is stored otherwise. Built by gguf_exact.py in
# local-llamacpp-1650ti-2b-q4_0/benchmarks/runs/2026-09-29-exact-gguf-v2-1650ti.
# SHA-256 419db9a6bf3bc15d770c85ccf9216827aa88c64fe8f3d72fbe5674f48efe2dc8.
# Published: the Hugging Face repo below has held v2 since revision 74b2c92; v1
# (25f21f14...) is at revision e5d65c8. MODEL_SHA256 decides, not the name.
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-exact-gguf
MODEL_PATH=/home/xbill/models/gemma-4-E2B-it-qat-q4_0-exact-v2/gemma-4-E2B-it-q4_0-exact.gguf
MODEL_SHA256=419db9a6bf3bc15d770c85ccf9216827aa88c64fe8f3d72fbe5674f48efe2dc8

# Slot 5 of the directory name. Since 2026-09-29 every weight matrix in the file
# is Q4_0 (Google's file, served until then, was mostly Q6_K by bytes).
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED 2026-10-11 from lscpu, /proc/cpuinfo, /proc/meminfo, DMI and the device
# tree. Samsung Galaxy Book Go (Wi-Fi), bare metal (systemd-detect-virt: none),
# fanless (the only thermal cooling devices are cpufreq and GPU devfreq).
#
# The SoC is a Snapdragon 7c Gen 2, part SC7180P. The device tree says
# `qcom,sc7180` because mainline Linux describes 7c Gen 1 and Gen 2 with one tree
# (Gen 2 is the higher-clocked bin); lscpu says "Kryo-4XX". Slot 3 names the part.
#
# HETEROGENEOUS, 2 big + 6 little, and the kernel says so through cpu_capacity:
#   cpu0-5  Kryo 468 Silver (Cortex-A55-derived)  capacity  293   max 1805 MHz
#   cpu6-7  Kryo 468 Gold   (Cortex-A76-derived)  capacity 1024   max 2554 MHz
# No SMT. The big cores are the two HIGHEST-numbered ones; Gold-only is -C 0xC0.
ACCELERATOR_TYPE=cpu
CPU_MODEL="Qualcomm Snapdragon 7c Gen 2 (SC7180P, Kryo 468, 2x Gold + 6x Silver)"
CPU_CORES=8
CPU_THREADS=8
CPU_P_CORE_LOGICAL=6-7
CPU_E_CORE_LOGICAL=0-5
# /proc/cpuinfo: fp asimd aes pmull sha1 sha2 crc32 atomics fphp asimdhp asimdrdm
# lrcpc dcpop ASIMDDP. Dot product YES — the difference from the SDM850 sibling —
# no i8mm, no SVE. cmake: -mcpu=generic-armv8-a+lse+dotprod+rdma+crc+crypto+fp16+rcpc.
CPU_SIMD="neon fp16 dotprod"
# 3.4 GiB MemTotal (4 GB part) with 3.3 GiB swap on /dev/sdb4. THIS is the binding
# constraint, not compute: the dotprod Q4_0 repack copies the weight body into
# anonymous memory, and llama-bench peaks at 2.4-2.6 GB RSS — swapping ~1 GB per
# cell beside a GNOME session (benchmarks/runs/2026-10-11-first-light-sc7180p).
HOST_RAM_GIB=3
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# A CPU-only build: GGML_CUDA=OFF, GGML_NATIVE=ON (cmake detected
# -mcpu=generic-armv8-a+lse+dotprod+rdma+crc+crypto+fp16+rcpc). Built with ninja
# at -j6 in ~25 minutes, deep in swap; keep BUILD_JOBS low on 3.4 GiB.
LLAMA_CPP_DIR=/home/xbill/llama.cpp
# Cloned fresh on 2026-10-11 (Debian forky/sid arm64, kernel 7.2.9, gcc 16.2.0).
# NOT the SDM850 rig's 23b0202a1; differencing the two carries an upstream delta.
LLAMA_CPP_COMMIT=f2cc7282c
LLAMA_SERVER_BIN=/home/xbill/llama.cpp/build-cpu/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# The endpoint is not discovered; it is known before the process starts.
HOST=127.0.0.1
PORT=8080
ENDPOINT=http://127.0.0.1:8080

# NOT configurable. `-ngl 0` and an empty CUDA_VISIBLE_DEVICES are hardcoded in
# both `make serve` and server.py, because a CPU rig that can be flipped onto a
# GPU by one env line measures whichever device happened to be present.

# 18 KiB/token geometry (MODELS.md), but llama.cpp caps the 12 sliding layers at
# the 1024-cell window, so KV at 8192 is ~60 MiB, not 144 (MEASURED on the 1650ti
# sibling from the allocation log). KV is small; the repacked weights are what
# pressure 3.4 GiB of host RAM (see Hardware).
CONTEXT_SIZE=8192

# UNMEASURED HERE. Carried from local-llamacpp-sdm850-2b-q4_0 so the two aarch64
# rigs serve identical flags apart from threads.
KV_CACHE_TYPE=f16

# llama-bench ran every cell at -fa 1; -fa 0 is UNMEASURED here.
FLASH_ATTENTION=1

# Prometheus metrics at $ENDPOINT/metrics. Operational visibility only — never
# the benchmark decode column (see CLAUDE.md).
METRICS=1

# MEASURED 2026-10-11 (benchmarks/runs/2026-10-11-first-light-sc7180p, llama-bench
# pp512/tg128, cooldown-gated): decode 8.33 tok/s on the 2 Gold cores, 7.64 on one,
# 5.17 on all 8 — the Silver cores are stragglers, as on the SDM850. Prefill 46.68
# on all 8 vs 36.36 on 2 Gold. Unpinned -t 2 lands on the Gold cores by itself
# (8.28), so no affinity flag is passed; never raise THREADS above the Gold count.
THREADS=2
THREADS_BATCH=8

# One interactive session. llama.cpp SPLITS --ctx-size ACROSS SLOTS, so raising
# this without raising CONTEXT_SIZE shrinks each sequence.
PARALLEL_SLOTS=1

# Thinking, server-wide: llama-server --reasoning {on,off,auto}. Gemma 4 thinks by
# default and spent 1274 chars reasoning to answer "name three TPU generations"
# (CLAUDE.md, "Gemma 4 reasons"). OFF since 2026-09-29 for a single-user demo:
# answers arrive directly in `content`. A request can still ask for it with
# "chat_template_kwargs": {"enable_thinking": true}, which is what sweep.py does,
# so benchmark workloads do not depend on this key.
REASONING=off

