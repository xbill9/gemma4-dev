# tpu-sglangjax-v5e1-2b: SGLang-JAX on one TPU v5e chip, Gemma 4 E2B bf16, with patches/gemma4-e2b.diff.
# Source of truth for flight/; a real environment variable wins over this file.

# ── Checkpoint ───────────────────────────────────────────────────────────────
MODEL_NAME=google/gemma-4-E2B-it
MODEL_REVISION=4adf15748de9e1a0097b6274cee9c15836c41c37
DTYPE=bfloat16

# ── Hardware / provisioning ──────────────────────────────────────────────────
ACCELERATOR_TYPE=v5litepod-1
RUNTIME_VERSION=v2-alpha-tpuv5-lite
TENSOR_PARALLEL_SIZE=1
PROJECT_ID=aisprint-491218
ZONE=us-west4-a
QR_NAME=tpu-sglangjax-v5e1-2b
PROVISIONING_MODEL=flex-start

# ── Stack ────────────────────────────────────────────────────────────────────
# sgl-project/sglang-jax main of 2026-10-20 has the Gemma 4 31B and 26B A4B decoders only; the patch adds what
# E2B needs (see CLAUDE.md). Python 3.13 from deadsnakes, sglang-jax's own jax[tpu] pin, CPU torch for the
# Gemma4Processor that transformers builds.
SGL_COMMIT=b3e3e16b2d3f0281a9e23f547cd4382f4a166eb6
PATCH=patches/gemma4-e2b.diff

# ── Serving ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
CONTEXT_LENGTH=16384
MAX_RUNNING_REQUESTS=64
MEM_FRACTION_STATIC=0.8
REASONING_PARSER=gemma4
