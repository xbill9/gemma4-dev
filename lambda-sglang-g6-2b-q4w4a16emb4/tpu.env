# lambda-sglang-g6-2b-q4w4a16emb4 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md). A real environment variable wins.
# ADDED 2026-11-19: gpu-sglang-g6-2b-q4w4a16emb4 (one L4 in an EC2 G6) as a Lambda GPU function. Same
# checkpoint, SGLang version, patches and serving values; slot 1 is the only slot that differs.

ENGINE=sglang
ENGINE_LABEL="SGLang 0.5.23"
ENGINE_LOG_PATTERN=?"server_args"

# ── Model (baked into the image at /opt/model) ───────────────────────────────
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text-emb4
MODEL_REVISION=db715f83da4f13289761d7c45f4d19ceac84695d
QUANTIZATION=q4w4a16emb4

# ── Image ────────────────────────────────────────────────────────────────────
# AWS's Lambda SGLang image: FRAMEWORK_VERSION=0.5.23+dlc1, Python 3.13, CUDA 13.0.3, created 2026-11-16
# (its build history). Tags cuda and cuda-v1 had this digest on 2026-11-19. Its engine extension starts
# `sglang.launch_server` during Init; the two patches from gpu-sglang-g6-2b-q4w4a16emb4 are applied on top.
BASE_IMAGE=public.ecr.aws/lambda/deep-learning-containers/sglang@sha256:048e60a27397ab7e06f8bdc27c70d5c359fb69d196abcd918bb7d892505d2f35
SGLANG_VERSION=0.5.23
BUILD_ARGS=BASE_IMAGE,MODEL_NAME,MODEL_REVISION

# ── Serving (gpu-sglang-g6-2b-q4w4a16emb4's values) ──────────────────────────
MEM_FRACTION_STATIC=0.80
# The G6 server logged "Use triton as default attention backend for Gemma4"; AWS's extension passes
# --attention-backend itself (flashinfer unless set), so the G6 choice is written out here.
ATTENTION_BACKEND=triton
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=64
TOOL_CALL_PARSER=gemma4
REASONING_PARSER=gemma4
DISABLE_RADIX_CACHE=true
DISABLE_PREFILL_CUDA_GRAPH=true
CUDA_GRAPH_MAX_BS_DECODE=64
SPECULATIVE_MODEL=
SPECULATIVE_NUM_STEPS=2

# ── AWS (lambda-vllm-g6-2b-q4w4a16emb4's values) ─────────────────────────────
AWS_REGION=us-east-1
# g6.2xlarge: 8 vCPUs, 32,768 MiB, one L4 with 22,888 MiB (DescribeInstanceTypes, 2026-11-18).
INSTANCE_TYPE=g6.2xlarge
ACCELERATOR_TYPE="NVIDIA L4"
# One capacity provider for every lambda-*-g6 rig (created by lambda-vllm-g6-2b-q4w4a16emb4). The account's
# "Running On-Demand G and VT instances" quota in us-east-1 is 16 vCPUs: two rigs up at once at most.
CAPACITY_PROVIDER=gemma4-e2b-g6
MAX_VCPU_COUNT=16
SUBNET_IDS=
SECURITY_GROUP_IDS=
OPERATOR_ROLE=lambda-lmi-gpu-operator
EXECUTION_ROLE=lambda-lmi-gpu-exec

# ── Function ─────────────────────────────────────────────────────────────────
FUNCTION_NAME=gemma4-e2b-g6-sglang
MEMORY_MB=16384
MEMORY_GIB_PER_VCPU=4
ACCELERATOR_MEMORY_GB=16
EPHEMERAL_MB=10240
TIMEOUT_S=900
PER_ENV_MAX_CONCURRENCY=48
MIN_ENVS=1
MAX_ENVS=1
# Seconds the engine extension waits for the server during Init (Lambda's Init limit is the function timeout).
SERVER_TIMEOUT=840

# ── Image build (builder.py: one EC2 instance shared by the lambda-*-g6 rigs) ──
ECR_REPO=lambda-sglang-g6-2b-q4w4a16emb4
IMAGE_TAG=db715f83da4f
BUILDER_INSTANCE_TYPE=c7i.4xlarge
BUILDER_DISK_GB=300
# Every checkpoint here is public and ungated (Hugging Face API, 2026-11-19): no token needed.
HF_SECRET_ID=

# ── Local chat page (chat_ui.py) ─────────────────────────────────────────────
# lambda-vllm 8768, lambda-sglang 8769, lambda-llamacpp 8770, lambda-pytorch 8771, lambda-jax 8772.
UI_PORT=8769
