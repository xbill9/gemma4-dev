# gpu-litertlm-g6-2b-q4w4a16emb4 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md). Committed on purpose and NOT
# gitignored. Override a value on the make command line.
#
# ADDED 2026-11-05, forked from local-litertlm-3050oem-2b-q4w4a16emb4 for the G6 serving-engine flight:
# the sister of gpu-litertlm-g6-2b-int248, slot 5 the only slot that differs. NOTHING BELOW IS MEASURED
# ON THE L4 YET. Instance: gpu-pytorch-g6-2b-q4w4a16's create_g6_instance.

# ── Model ────────────────────────────────────────────────────────────────────
# The file the 3050 rig built (local-litertlm-3050oem-2b-q4w4a16emb4/build.sh), by hash. It is not
# published, and it is not rebuilt here: the export peaked near 45 GB of RAM on the 3050 host and
# g6.2xlarge has 32,768 MiB (EC2 DescribeInstanceTypes, 2026-11-05). `make fetch` copies it from
# MODEL_S3_URI, which you set after `make stage` uploads it from the 3050 host.
MODEL_NAME=local:gemma-4-E2B-it-qat-q4_0-w4a16-emb4.litertlm
MODEL_PATH=/opt/models/litert/gemma-4-E2B-it-qat-q4_0-w4a16-emb4.litertlm
MODEL_SHA256=c880dac6f1e7a6f72a222bf4192fc3267c13e8c3278fabaecefedfcc488da8bb
QUANTIZATION=q4w4a16emb4
SOURCE_PATH_3050=/home/xbill/models/litert/gemma-4-E2B-it-qat-q4_0-w4a16-emb4.litertlm
# Empty until staged, e.g. s3://<bucket>/gemma4-dev/gemma-4-E2B-it-qat-q4_0-w4a16-emb4.litertlm
MODEL_S3_URI=
MODEL_ID=gemma-4-e2b-q4exact
LITERT_LM_DIR=/opt/cache/gpu-litertlm-g6-2b-q4w4a16emb4

# ── Hardware ─────────────────────────────────────────────────────────────────
# WebGPU on Vulkan; see gpu-litertlm-g6-2b-int248/tpu.env and its `make vulkan`.
INSTANCE_TYPE=g6.2xlarge
AWS_REGION=us-east-1
ACCELERATOR_TYPE="NVIDIA L4"
COMPUTE_CAPABILITY=8.9
VRAM_TOTAL_MIB=23034
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
LITERT_LM_VERSION=0.19.0
PROTOBUF_VERSION=7.36.2
PYTHON=/usr/bin/python3

# ── Serving (the 3050 rig's values) ──────────────────────────────────────────
HOST=127.0.0.1
PORT=9380
ENDPOINT=http://127.0.0.1:9380
BACKEND=gpu
CACHE=disk
# The build has no drafter section.
SPECULATIVE_DECODING=off
MAX_NUM_TOKENS=
