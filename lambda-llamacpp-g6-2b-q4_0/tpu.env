# lambda-llamacpp-g6-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md). A real environment variable wins.
# ADDED 2026-11-19: gpu-llamacpp-g6-2b-q4_0 (one L4 in an EC2 G6) as a Lambda GPU function: the exact Q4_0
# GGUF and Google's QAT assistant drafter as exact Q4_0, llama.cpp at the G6 flight's commit.

ENGINE=cmd
ENGINE_LABEL="llama.cpp 7182ef71e"
ENGINE_LOG_PATTERN=?"engine-ext" ?"model loaded"

# ── Model (baked into the image at /opt/models) ──────────────────────────────
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-exact-gguf
MODEL_REVISION=74b2c92c8f7f84d3d9c39e8026f6a28f62788255
MODEL_FILE=gemma-4-E2B-it-q4_0-exact.gguf
MODEL_SHA256=419db9a6bf3bc15d770c85ccf9216827aa88c64fe8f3d72fbe5674f48efe2dc8
QUANTIZATION=q4_0
SPEC_DRAFT_HF=xbill9/gemma-4-E2B-it-qat-assistant-q4_0-exact-gguf
SPEC_DRAFT_HF_REVISION=6188294ee6f23cedadd98013fa664b3e1ba7159f
SPEC_DRAFT_FILE=gemma-4-E2B-it-qat-assistant-q4_0-exact.gguf
SPEC_DRAFT_SHA256=060f5a0158f8120d25137866b90e04e21cd0d2d23de1db7a9cc3b7f00e60bd11

# ── Image ────────────────────────────────────────────────────────────────────
# AWS's Lambda base image (CUDA 13.0.3, Python 3.13, awslambdaric; created 2026-11-13, tags cuda and
# cuda-v1 on 2026-11-19). llama-server is built in a stage on the same image with NVIDIA's CUDA 13.0
# toolkit packages, for sm_89 only, without -march=native (the builder's CPU is not the g6's).
BASE_IMAGE=public.ecr.aws/lambda/deep-learning-containers/base@sha256:22a6d01522021562cbcf2388531b0bbdddd31e2210993e2507298816bc28b488
# The G6 flight's commit (gpu-vllm-g6-2b-q4w4a16emb4/flight/FLIGHT.md), not gpu-llamacpp-g6-2b-q4_0's 77c4540ce.
LLAMA_CPP_COMMIT=7182ef71e6d5dd0c8ea76486fac134fcd25025d4
CUDA_ARCH=89
BUILD_ARGS=BASE_IMAGE,MODEL_NAME,MODEL_REVISION,MODEL_FILE,MODEL_SHA256,SPEC_DRAFT_HF,SPEC_DRAFT_HF_REVISION,SPEC_DRAFT_FILE,SPEC_DRAFT_SHA256,LLAMA_CPP_COMMIT,CUDA_ARCH

# ── Serving ──────────────────────────────────────────────────────────────────
# The G6 flight's llama-d2 arm (f16 KV, flash attention, per-layer embeddings on the GPU, drafter at 2
# tokens), with 4 slots of 8,192 tokens (the flight ran -c 8192 for its short prompts). -t 4: the function
# gets 4 vCPUs (16 GiB at 4 GiB per vCPU). --jinja so chat_template_kwargs (enable_thinking) reach the template.
MAX_MODEL_LEN=8192
ENGINE_PORT=8000
ENGINE_CMD=/opt/llama/bin/llama-server -m /opt/models/gemma-4-E2B-it-q4_0-exact.gguf --alias xbill9/gemma-4-E2B-it-qat-q4_0-exact-gguf --host 127.0.0.1 --port 8000 -ngl 99 -c 32768 --parallel 4 -ctk f16 -ctv f16 -fa 1 -t 4 -tb 4 --jinja --metrics -ot 'per_layer_token_embd\.weight=CUDA0' -md /opt/models/gemma-4-E2B-it-qat-assistant-q4_0-exact.gguf --spec-type draft-mtp -ngld all --spec-draft-n-max 2

# ── AWS (lambda-vllm-g6-2b-q4w4a16emb4's values) ─────────────────────────────
AWS_REGION=us-east-1
# g6.2xlarge: 8 vCPUs, 32,768 MiB, one L4 with 22,888 MiB (DescribeInstanceTypes, 2026-11-18).
INSTANCE_TYPE=g6.2xlarge
ACCELERATOR_TYPE="NVIDIA L4"
# One capacity provider for the lambda-*-g6 sweep rigs, allowed g6.2xlarge or g6.4xlarge (one L4 either way;
# 16 vCPUs and 64 GiB on the 4xlarge). Lambda had no g6.2xlarge capacity in any of the five us-east-1 zones
# that offer it, 17:01-17:38 UTC on 2026-11-19 (InsufficientCapacity); the native G6 sweep met the same
# shortage on 2026-11-05 and ran on a g6.4xlarge. Which type each run got is recorded with its results.
# The "Running On-Demand G and VT instances" quota in us-east-1 is 16 vCPUs: one rig at a time.
CAPACITY_PROVIDER=gemma4-e2b-g6-l4
ALLOWED_INSTANCE_TYPES=g6.2xlarge,g6.4xlarge
MAX_VCPU_COUNT=16
SUBNET_IDS=
SECURITY_GROUP_IDS=
OPERATOR_ROLE=lambda-lmi-gpu-operator
EXECUTION_ROLE=lambda-lmi-gpu-exec

# ── Function ─────────────────────────────────────────────────────────────────
FUNCTION_NAME=gemma4-e2b-g6-llamacpp
MEMORY_MB=16384
MEMORY_GIB_PER_VCPU=4
ACCELERATOR_MEMORY_GB=16
EPHEMERAL_MB=10240
TIMEOUT_S=900
PER_ENV_MAX_CONCURRENCY=4
MIN_ENVS=1
MAX_ENVS=1
# Seconds the engine extension waits for the server during Init (Lambda's Init limit is the function timeout).
SERVER_TIMEOUT=840

# ── Image build (builder.py: one EC2 instance shared by the lambda-*-g6 rigs) ──
ECR_REPO=lambda-llamacpp-g6-2b-q4_0
IMAGE_TAG=7182ef71e-74b2c92c
BUILDER_INSTANCE_TYPE=c7i.4xlarge
BUILDER_DISK_GB=300
# Every checkpoint here is public and ungated (Hugging Face API, 2026-11-19): no token needed.
HF_SECRET_ID=

# ── Local chat page (chat_ui.py) ─────────────────────────────────────────────
# lambda-vllm 8768, lambda-sglang 8769, lambda-llamacpp 8770, lambda-pytorch 8771, lambda-jax 8772.
UI_PORT=8770
