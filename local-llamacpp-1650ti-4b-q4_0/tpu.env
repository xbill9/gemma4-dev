# local-llamacpp-1650ti-4b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
# `1650ti` is for humans; llama.cpp never sees it, and CUDA_VISIBLE_DEVICES below
# is the value that actually selects the card. `4b` is E4B: 4.5B effective,
# 8.0B total (MODELS.md, "The `E` prefix is load-bearing").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# The file is named tpu.env for consistency with every sibling. There is no TPU
# here and there is no cloud here.
#
# FORKED 2026-09-30 from local-llamacpp-1650ti-2b-q4_0 as its E4B parallel. Slot 4
# is the only slot that differs. Every Runtime/Serving value below was carried over
# from the E2B rig and was MEASURED THERE, NOT HERE, unless a line says otherwise.
# The two rigs share port 8080 and the card, and do not fit on it together
# (E2B 1480 MiB + E4B ~2.9 GiB > 4096): stop one to run the other.
#
# STATUS 2026-09-30: FIRST LIGHT on Google's E4B GGUF, then the exact rebuild. See
# benchmarks/runs/2026-09-30-exact-gguf-e4b-1650ti/.

# ── Model ────────────────────────────────────────────────────────────────────
# MODEL_NAME is the artifact label; MODEL_PATH is what llama.cpp opens. The GGUF
# lives outside the git work tree on purpose.
# 2026-09-30: the exact Q4_0 rebuild of E4B, by the E2B rig's v2 gguf_exact.py
# unchanged (same tensor set, same name map): Google's GGUF metadata byte for byte,
# every layer matrix, both embedding tables and per_layer_model_proj rebuilt as
# Q4_0 from google/gemma-4-E4B-it-qat-q4_0-unquantized on the trained grid step.
# NOT PUBLISHED: no Hugging Face repo holds this file yet, so MODEL_NAME names the
# repo it would go to, following the E2B convention. MODEL_SHA256 decides.
MODEL_NAME=xbill9/gemma-4-E4B-it-qat-q4_0-exact-gguf
MODEL_PATH=/home/xbill/models/gemma-4-E4B-it-qat-q4_0-exact/gemma-4-E4B-it-q4_0-exact.gguf
MODEL_SHA256=5462cc102b7d22c4748f9b8e82091f2ae064e10a45525151af6f9a7d0da7caf9

# Slot 5 of the directory name. Every weight matrix in the exact file is Q4_0;
# Google's E4B file is 2.86 GB Q6_K against 2.22 GB Q4_0.
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED-STATIC 2026-09-03, `nvidia-smi --query-gpu=name,compute_cap,memory.total`.
ACCELERATOR_TYPE="NVIDIA GeForce GTX 1650 Ti with Max-Q Design"
COMPUTE_CAPABILITY=7.5
VRAM_TOTAL_MIB=4096
VRAM_FREE_MIB=3724
NVIDIA_DRIVER=615.71.09
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# HEAD at build time, MEASURED-STATIC 2026-09-22 (git -C ~/llama.cpp rev-parse).
LLAMA_CPP_DIR=/home/xbill/llama.cpp
# BOTH ARMS OF THE CONTROL BUILD FROM THIS COMMIT. This rig was at 95ef7fc and
# the CPU twin at 82324fc50, so a CPU-vs-GPU difference would have carried an
# upstream delta inside it. Rebuilt both 2026-09-16, and again 2026-09-22 onto
# f95b0d9 after the host moved to Debian sid: gcc 16.2.0, CUDA 13.4. Rebuilt from
# a clean tree, not the 2026-09-16 CMakeCache, which still named gcc 14 and CUDA
# 13.3. Flags carried over from that cache: GGML_CUDA=ON, CUDA_ARCH=75,
# GGML_NATIVE=ON, Release, FORCE_MMQ=OFF — now recorded in the Makefile's `build:`
# target rather than only in a CMakeCache. See CLAUDE.md, "Building llama.cpp here".
#
# sm_75 IS NOW THE LOWEST ARCH CUDA SHIPS (13.4 lists compute_75 first). The next
# major CUDA is the one to expect to drop Turing and strand this card.
#
# ONLY 2026-09-22-paired-sweep-1650ti WAS MEASURED ON THIS BINARY. Three older
# runs are at 95ef7fc with the old GPU-specific filler; 2026-09-16 at c6824a9.
# None of those is pairable with anything measured at f95b0d9.
LLAMA_CPP_COMMIT=f95b0d9
LLAMA_SERVER_BIN=/home/xbill/llama.cpp/build/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# The endpoint is not discovered. It is known before the process starts, which
# is the one place CLAUDE.md's "never hardcode an endpoint" rule does not apply
# — there is no QR -> node -> external IP chain here to walk.
HOST=127.0.0.1
PORT=8080
ENDPOINT=http://127.0.0.1:8080

# N_GPU_LAYERS=99 offloads all 42 blocks. MEASURED 2026-09-30 on the exact file:
# CUDA0 model buffer 2493.32 MiB (predicted 2493 from the tensor table), nvidia-smi
# 2848 MiB of 4096, with 3671 MiB free before load. That leaves ~820 MiB, against
# ~2.3 GiB on E2B. It fits because per_layer_token_embd (1.59 GB, 38% of the file)
# is TENSOR_READ_LAZY (llama.cpp src/models/gemma4.cpp) and served by GET_ROWS out
# of the mmap -- the same mechanism as E2B. If it were resident, E4B would need
# ~4.4 GiB and could not load. Do NOT lower this "to be safe" without measuring.
# Google's own E4B GGUF also fits, at 2696 MiB model buffer / 3052 MiB total:
# its Q6_K token_embd and F16 per_layer_model_proj cost 203 MiB more.
N_GPU_LAYERS=99

# E4B's KV is 3.1x E2B's per token (MODELS.md, "E4B -- KV is 3.1x E2B's"), but
# llama.cpp caps the 20 sliding layers at 1024 cells whatever n_ctx is. MEASURED
# 2026-09-30 at 8192: 128 MiB for the 4 full-attention layers (16 KiB/token) plus
# 40 MiB sliding = 168 MiB, exactly as derived. Only the 16 KiB/token term grows
# with context, so the ~820 MiB of headroom is roughly another 50K tokens --
# ARITHMETIC, not measured; compute buffers also grow with context.
CONTEXT_SIZE=8192
#
# f16, and NOT q8_0 -- carried over from the E2B rig, where MEASURED 2026-09-03
# q8_0 on either K or V cost ~12% of decode and 20-40% of prefill (no tensor
# cores to hide the dequant). UNMEASURED on E4B. The KV here is 168 MiB, so the
# memory it would buy is still not scarce at this context.
KV_CACHE_TYPE=f16

# MEASURED ON E2B 2026-09-03: +4.8% decode (70.39 -> 73.74), prefill unchanged.
FLASH_ATTENTION=1

# Prometheus metrics at $ENDPOINT/metrics. OFF in llama-server by default: it
# answers 501 "This server does not support metrics endpoint. Start it with
# `--metrics`" until the flag is passed, which is what MEASURED 2026-09-08 on a
# healthy server. The endpoint is llama.cpp's own — nothing here implements it.
#
# Cheap to leave on: a counter bump per request, and it binds no extra port.
#
# WHAT IT IS NOT FOR. CLAUDE.md forbids scraping /metrics to fill the benchmark
# decode column, and enabling it here does not soften that. `--decode-source
# auto` must keep resolving to `stream`: llama-server does not emit
# `usage.decode_tokens_per_second`, and feeding it llama.cpp's own
# `predicted_per_second` under that shared name would put a per-engine statistic
# in a cross-rig column. Use /metrics for operational questions — is a slot
# stuck, how deep is the queue — not to produce a number a report compares.
METRICS=1

# MEASURED ON E2B 2026-09-03: thread count does not matter (73.75 / 73.08 / 72.97 at
# t=4/6/8) — decode is GPU-bound. 4 was marginally best.
#
# 6 SINCE 2026-09-22, FOR THE CONTROL. The CPU twin re-derived its THREADS to 6
# from the real topology (6 cores, homogeneous), and the arms must differ only in
# -ngl. 4 vs 6 was 0.9% on GPU decode on 2026-09-03 — inside that run's noise.
# The 2026-09-22 paired sweep ran at 6/12 on both arms.
THREADS=6

# ADDED 2026-09-16 FOR THE CONTROL, not because it was measured here. The CPU
# twin (local-llamacpp-cpu-2b-q4_0) passes -tb and this arm did not, so the two
# arms differed by a prefill-thread flag on top of the device. Prefill runs on
# the card here, so the expected effect is small -- but a control does not get to
# assume which of its differences are the harmless ones. UNMEASURED on this rig:
# if you sweep it, record that separately from any CPU-vs-GPU number.
THREADS_BATCH=12

# Concurrency is the largest lever here by a wide margin. MEASURED ON E2B 2026-09-03,
# aggregate decode: B=1 73.33, B=2 121.31, B=4 168.37, B=8 223.75, B=16 238.41,
# B=64 277.61 — 3.8x end to end, and 3.05x of it arrives by B=8. Prefill is flat
# at ~355 t/s across the whole range, so batching does nothing for that path.
#
# 1 is the right default because this rig's normal use is one interactive
# session, and per-stream falls hard: 73.33 -> 27.97 at B=8 -> 4.34 at B=64.
# Raise it deliberately, in a run whose REPORT.md says so.
#
# NOTE llama.cpp SPLITS --ctx-size ACROSS SLOTS. --parallel 16 at -c 16384 is
# 1024 tokens per sequence, not 16384. Memory is not the constraint: that
# configuration measured 1818 MiB of 4096, leaving 1903 MiB free.
PARALLEL_SLOTS=1

# Thinking, server-wide: llama-server --reasoning {on,off,auto}. Gemma 4 thinks by
# default and spent 1274 chars reasoning to answer "name three TPU generations"
# (CLAUDE.md, "Gemma 4 reasons"). OFF since 2026-09-29 for a single-user demo:
# answers arrive directly in `content`. A request can still ask for it with
# "chat_template_kwargs": {"enable_thinking": true}, which is what sweep.py does,
# so benchmark workloads do not depend on this key. Both arms of the GPU/CPU pair
# must carry the same value.
REASONING=off

# NOT adopted, and tested rather than assumed. llama.cpp warns at init that this
# card lacks tensor cores and suggests CMAKE_CUDA_ARCHITECTURES=61-virtual;80-virtual
# with GGML_CUDA_FORCE_MMQ. A FORCE_MMQ build at arch=75 measured pp512 337.61 /
# tg128 73.04 against the stock build's 340.33 / 73.75 — marginally WORSE. The
# build lives at ~/llama.cpp/build-mmq if you want to re-test; LLAMA_SERVER_BIN
# above deliberately still points at the stock build.
GGML_CUDA_FORCE_MMQ=OFF
