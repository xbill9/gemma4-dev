# lambda-jax-g6-2b — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md). A real environment variable wins.
# ADDED 2026-11-19: gpu-jax-g6-2b's pure-JAX Gemma 4 port (jax_openai_server.py, jax_engine.py, ports/gemma4/,
# copied byte-for-byte into image/engine/) as a Lambda GPU function. The reference bf16 checkpoint, as on G6.

ENGINE=cmd
ENGINE_LABEL="JAX 0.11.1"
ENGINE_LOG_PATTERN=?"engine-ext" ?"loaded"

# ── Model (the hub cache baked into the image at /opt/hf, read offline) ──────
MODEL_NAME=google/gemma-4-E2B-it
# main on 2026-11-19 (Hugging Face API); the G6 rig did not pin one.
MODEL_REVISION=4adf15748de9e1a0097b6274cee9c15836c41c37
QUANTIZATION=bf16

# ── Image ────────────────────────────────────────────────────────────────────
# AWS's Lambda base image (CUDA 13.0.3, Python 3.13, awslambdaric; created 2026-11-13). jax[cuda13] brings
# its own CUDA libraries from pip. 0.11.1 is the version gpu-jax-g6-2b's first serve recorded.
BASE_IMAGE=public.ecr.aws/lambda/deep-learning-containers/base@sha256:22a6d01522021562cbcf2388531b0bbdddd31e2210993e2507298816bc28b488
JAX_PIP_SPEC=jax[cuda13]==0.11.1 fastapi uvicorn pydantic transformers==5.16.1 jinja2 safetensors huggingface_hub==1.31.0 numpy
BUILD_ARGS=BASE_IMAGE,MODEL_NAME,MODEL_REVISION,JAX_PIP_SPEC

# ── Serving (gpu-jax-g6-2b's values) ─────────────────────────────────────────
# One request at a time (Gemma4EModelJAX refuses B > 1). 24 GiB of host memory (6 vCPUs): the loader reads
# the 10 GB bf16 checkpoint through host memory; 16 GiB is untested here.
MAX_MODEL_LEN=4096
ENGINE_PORT=8000
ENGINE_CMD=/var/lang/bin/python3 /opt/engine/jax_openai_server.py --model google/gemma-4-E2B-it --host 127.0.0.1 --port 8000 --kv-cache-dtype auto --quant-mode fp16 --max-model-len 4096 --ple-bits 4 --int8-lm-head
ENGINE_ENV=XLA_PYTHON_CLIENT_MEM_FRACTION=0.90 JAX_COMPILATION_CACHE_DIR=/tmp/jax-cache RIG_NAME=lambda-jax-g6-2b

# ── AWS (lambda-vllm-g6-2b-q4w4a16emb4's values) ─────────────────────────────
AWS_REGION=us-east-1
# g6.2xlarge: 8 vCPUs, 32,768 MiB, one L4 with 22,888 MiB (DescribeInstanceTypes, 2026-11-18).
INSTANCE_TYPE=g6.2xlarge
ACCELERATOR_TYPE="NVIDIA L4"
# One capacity provider for every lambda-*-g6 rig (created by lambda-vllm-g6-2b-q4w4a16emb4). The account's
# "Running On-Demand G and VT instances" quota in us-east-1 is 16 vCPUs: two rigs up at once at most.
CAPACITY_PROVIDER=gemma4-e2b-g6
MAX_VCPU_COUNT=16
SUBNET_IDS=
SECURITY_GROUP_IDS=
OPERATOR_ROLE=lambda-lmi-gpu-operator
EXECUTION_ROLE=lambda-lmi-gpu-exec

# ── Function ─────────────────────────────────────────────────────────────────
FUNCTION_NAME=gemma4-e2b-g6-jax
MEMORY_MB=24576
MEMORY_GIB_PER_VCPU=4
ACCELERATOR_MEMORY_GB=16
EPHEMERAL_MB=10240
TIMEOUT_S=900
PER_ENV_MAX_CONCURRENCY=4
MIN_ENVS=1
MAX_ENVS=1
# Seconds the engine extension waits for the server during Init (Lambda's Init limit is the function timeout).
SERVER_TIMEOUT=840

# ── Image build (builder.py: one EC2 instance shared by the lambda-*-g6 rigs) ──
ECR_REPO=lambda-jax-g6-2b
IMAGE_TAG=4adf15748de9
BUILDER_INSTANCE_TYPE=c7i.4xlarge
BUILDER_DISK_GB=300
# Every checkpoint here is public and ungated (Hugging Face API, 2026-11-19): no token needed.
HF_SECRET_ID=

# ── Local chat page (chat_ui.py) ─────────────────────────────────────────────
# lambda-vllm 8768, lambda-sglang 8769, lambda-llamacpp 8770, lambda-pytorch 8771, lambda-jax 8772.
UI_PORT=8772
