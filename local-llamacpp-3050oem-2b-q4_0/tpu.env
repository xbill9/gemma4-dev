# local-llamacpp-3050oem-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
# `3050oem` is for humans; llama.cpp never sees it, and CUDA_VISIBLE_DEVICES below
# is the value that actually selects the card.
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# FORKED 2026-10-13 from local-llamacpp-1650ti-2b-q4_0. Slot 3 is the only slot
# that differs: same runtime, same GGUF (by SHA-256), same serving flags. NOT a
# controlled A/B against the 1650 Ti: different host (i7-5820K desktop here,
# i7-10750H laptop there), different llama.cpp commit, different day. Values below
# marked "parent" were measured on the 1650 Ti and are carried, not re-measured.

# ── Model ────────────────────────────────────────────────────────────────────
# MODEL_NAME is the upstream artifact; MODEL_PATH is what llama.cpp opens. They
# are separate because the GGUF lives outside the git work tree on purpose (a
# 3.3 GB blob in a rig directory would be committed by accident sooner or later).
# 2026-09-29: the exact Q4_0 rebuild, v2. Google's GGUF metadata byte for byte, with
# all 275 layer matrices, both embedding tables and per_layer_model_proj rebuilt as
# Q4_0 from google/gemma-4-E2B-it-qat-q4_0-unquantized on the trained grid step; only
# 1.1 MB of F32 norms is stored otherwise. Built by gguf_exact.py in
# local-llamacpp-1650ti-2b-q4_0/benchmarks/runs/2026-09-29-exact-gguf-v2-1650ti.
# SHA-256 419db9a6bf3bc15d770c85ccf9216827aa88c64fe8f3d72fbe5674f48efe2dc8.
# Published: the Hugging Face repo below has held v2 since revision 74b2c92; v1
# (25f21f14...) is at revision e5d65c8. MODEL_SHA256 decides, not the name.
# Downloaded here 2026-10-13 from revision 74b2c92; sha256sum matched.
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-exact-gguf
MODEL_PATH=/home/xbill/models/gemma-4-E2B-it-qat-q4_0-exact-v2/gemma-4-E2B-it-q4_0-exact.gguf
MODEL_SHA256=419db9a6bf3bc15d770c85ccf9216827aa88c64fe8f3d72fbe5674f48efe2dc8

# Slot 5 of the directory name. Since 2026-09-29 every weight matrix in the file
# is Q4_0 (Google's file, served until then, was mostly Q6_K by bytes).
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED-STATIC 2026-10-13, `nvidia-smi --query-gpu=name,compute_cap,memory.total,
# memory.free,driver_version,pci.device_id`: PCI 10de:2508, GA106. Ampere, sm_86,
# with tensor cores (the parent's TU117 has none). Host: ASUS X99-A, i7-5820K
# (6C/12T Haswell-E, AVX2, no AVX-512), 46 GiB RAM, hostname `gpu`.
ACCELERATOR_TYPE="NVIDIA GeForce RTX 3050 OEM"
COMPUTE_CAPABILITY=8.6
VRAM_TOTAL_MIB=8192
VRAM_FREE_MIB=7875
NVIDIA_DRIVER=615.78.08
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# Cloned fresh 2026-10-13 and built with `make build`: GGML_CUDA=ON, CUDA_ARCH=86,
# GGML_NATIVE=ON, Release, FORCE_MMQ off. gcc 16.2.0, CUDA 13.4 (V13.4.92) at
# /usr/local/cuda, which is NOT on PATH by default on this host.
LLAMA_CPP_DIR=/home/xbill/llama.cpp
LLAMA_CPP_COMMIT=77c4540ce
LLAMA_SERVER_BIN=/home/xbill/llama.cpp/build/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# The endpoint is not discovered. It is known before the process starts, which
# is the one place CLAUDE.md's "never hardcode an endpoint" rule does not apply
# — there is no QR -> node -> external IP chain here to walk.
#
# HOST=0.0.0.0 since 2026-10-13: listen on every interface so the LAN can reach
# it (eno1 is 192.168.0.156). No auth and no firewall on this host, so anyone on
# the LAN can use it. ENDPOINT stays on loopback: it is what the Makefile, the
# MCP server and sweep.py call, and 127.0.0.1 reaches a 0.0.0.0 listener.
HOST=0.0.0.0
PORT=8080
ENDPOINT=http://127.0.0.1:8080

# N_GPU_LAYERS=99 offloads all 35 blocks. MEASURED 2026-10-13: 1510 MiB of 8192
# at the settings below. Only 1.20 GiB of weights must be resident (`make info`),
# because per_layer_token_embd (1.321 GB, 51% of the file) is TENSOR_READ_LAZY and
# served by GET_ROWS out of the mmap. Never pass --no-mmap. See CLAUDE.md.
N_GPU_LAYERS=99

# The trained maximum (n_ctx_train 131072), for one user. MEASURED 2026-10-13
# (benchmarks/runs/2026-10-13-long-context-3050oem): 3610 MiB in all against
# 2770 at 8192, and a short chat decodes at 0.997x. Speed falls with how much
# conversation is actually in the cache: 107 tok/s at 8k, 91 at 32k, 58 at 120k.
# With --parallel N each slot gets CONTEXT_SIZE / N.
CONTEXT_SIZE=131072

# f16, and NOT q8_0. MEASURED 2026-10-13 (llama-bench pp512/tg128, r=5): q8_0 K+V
# is 0.961x prefill and 0.926x decode of f16. Same direction as the parent.
KV_CACHE_TYPE=f16

# MEASURED 2026-10-13: 1.133x prefill, 1.071x decode against -fa 0.
FLASH_ATTENTION=1

# Prometheus metrics at $ENDPOINT/metrics (llama-server answers 501 without
# --metrics). For operational questions and for checking the prompt cache was
# defeated in a sweep, never for the benchmark decode column: --decode-source
# auto must keep resolving to `stream` (CLAUDE.md).
METRICS=1

# MEASURED 2026-10-13: -t 4 is 0.995x prefill / 0.998x decode of -t 6. Decode
# runs on the card. 6 matches this host's six cores and the parent's value.
THREADS=6
# Carried from the parent; UNMEASURED here. Prefill runs on the card.
THREADS_BATCH=12

# 1: this rig's normal use is one interactive session. MEASURED 2026-10-13
# (benchmarks/runs/2026-10-13-concurrency-3050oem, -c 65536 --parallel 64):
# aggregate 93 -> 358 tok/s at 512/128 and 105 -> 618 at 128/512 from c=1 to 64,
# per-stream 107 -> 9-10. 64 slots used 2612 MiB. llama.cpp SPLITS --ctx-size ACROSS SLOTS: --parallel 16 at
# -c 16384 is 1024 tokens per sequence. Raise it deliberately, in a run whose
# REPORT.md says so.
PARALLEL_SLOTS=1

# Thinking, server-wide: llama-server --reasoning {on,off,auto}. OFF so answers
# arrive directly in `content`. A request can still ask for it with
# "chat_template_kwargs": {"enable_thinking": true}, which is what sweep.py does.
REASONING=off

# llama.cpp's default. UNMEASURED on this card; the parent measured it marginally
# worse on the 1650 Ti, which has no tensor cores. This card does.
GGML_CUDA_FORCE_MMQ=OFF

# per_layer_token_embd ON THE CARD, passed as -ot. MEASURED 2026-10-13
# (benchmarks/runs/2026-10-13-ple-offload-3050oem, llama-bench r=5, ABBA):
# prefill 1.036x at pp512 and 1.024x at pp2048, decode 1.001x, for 1260 MiB
# more VRAM (1510 -> 2770 MiB of 8192). The 1650 Ti measured no gain from the
# same move. mmap stays on: token_embd's 216 MiB input copy still reads from it.
# Empty this to go back to the lazy host-side table.
OVERRIDE_TENSORS=per_layer_token_embd\.weight=CUDA0

# ── Speculative decoding ─────────────────────────────────────────────────────
# Google's drafter for this checkpoint, google/gemma-4-E2B-it-qat-q4_0-unquantized-
# assistant (revision ebc7e1a2, 4 layers sharing the target's KV), ships as bf16 on
# its 4-bit QAT grid. SINCE 2026-10-14 this rig serves it as exact Q4_0 on that grid
# (59 MB), published at SPEC_DRAFT_HF and fetched by `make draft`; SHA-256 below.
# MEASURED 2026-10-14 (local-llamacpp-3050oem-2b-q4_0/benchmarks/runs/2026-10-14-drafter-q4exact-3050oem):
# against the Q8_0 conversion it replaces, 151.1 against 150.1 tok/s at 2 drafted tokens,
# same acceptance, GSM8K and BFCL level, 2875 against 2915 MiB VRAM. Passed as -md with
# --spec-type draft-mtp. The numbers below came from the Q8_0 drafter.
# MEASURED 2026-10-13 (benchmarks/runs/2026-10-13-spec-mtp-3050oem): drafting 2
# tokens per step is best, 1.39x decode overall greedy (1.20x story .. 1.85x code)
# and 1.36x sampled at temperature 0.8; 3/4/6 tokens are progressively worse, 6 is
# a net loss. Costs 230 MiB VRAM and 3.6% of prompt speed. Greedy output is NOT
# byte-identical to serving without it: each arm is deterministic, and they part at
# a near-tie word choice partway into the reply. Empty SPEC_DRAFT_MODEL to turn off.
SPEC_DRAFT_MODEL=/home/xbill/models/gemma-4-E2B-it-qat-assistant/gemma-4-E2B-it-qat-assistant-q4_0-exact.gguf
SPEC_DRAFT_SHA256=060f5a0158f8120d25137866b90e04e21cd0d2d23de1db7a9cc3b7f00e60bd11
SPEC_DRAFT_HF=xbill9/gemma-4-E2B-it-qat-assistant-q4_0-exact-gguf
SPEC_DRAFT_HF_REVISION=6188294ee6f23cedadd98013fa664b3e1ba7159f
SPEC_DRAFT_N_MAX=2
