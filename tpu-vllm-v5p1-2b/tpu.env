# Deployment parameters for this rig — the single source of truth.
#
# Read by: server.py (via python-dotenv), mcp-run.sh (which launches the MCP server),
# the Makefile (via -include), and set_env.sh. Change a value here and every one of
# them follows. A real environment variable always wins over anything set here, so
# `GOOGLE_CLOUD_ZONE=us-central1-a make status` still works for a one-off.
#
# Zone note: v5p hardware is published in ≥9 zones, but this project holds quota in only
# three of them — us-central1-a, us-east5-a and europe-west4-b — and flex-start narrows
# that to us-east5-a alone. See CLAUDE.md before changing the zone or PROVISIONING_MODEL;
# they are coupled.

GOOGLE_CLOUD_PROJECT=aisprint-491218
GOOGLE_CLOUD_REGION=us-east5
GOOGLE_CLOUD_ZONE=us-east5-a

MODEL_NAME=google/gemma-4-E2B-it

# --- Compute Engine control plane ---
# This rig provisions through `gcloud compute instances`, NOT the Cloud TPU API. That API
# is deprecated (bug/security fixes only; TPU7x and later are CE/GKE-only) and its smallest
# v5p is `v5p-8` at 4 chips. Compute Engine publishes a 1-chip machine type, and E2B needs
# exactly one 95 GiB chip — so the old path would have billed 4x for nothing.
#
# The `-tpu` suffix marks the CE-native shape (guestAcceleratorType `tpu-v5p`); the bare
# `ct5p-hightpu-4t` is the legacy shape. They are not known to be interchangeable.
MACHINE_TYPE=ct5p-hightpu-1t-tpu

# Pin the image FAMILY, never a dated name: builds ship roughly weekly and every superseded
# one is marked DEPRECATED, so a pinned name rots within a fortnight. One family covers
# v5e/v5p/v6e; TPU7x has its own. Current build 2026-08-10 was ...-v20260803.
IMAGE_FAMILY=ubuntu-accel-2204-amd64-tpu-v5e-v5p-v6e
IMAGE_PROJECT=ubuntu-os-accelerator-images

# CE instances default to a small boot disk; the vLLM TPU image plus the model does not fit.
# The Cloud TPU API handed us a large disk implicitly, so this is a knob the old path hid.
BOOT_DISK_SIZE=200GB
BOOT_DISK_TYPE=pd-balanced

# The startup script fetches the HF token from Secret Manager via the metadata server. TPU
# VMs defaulted to cloud-platform scope; a plain CE instance does NOT, and without this the
# boot fetch fails 30 minutes into its retry loop. The instance service account still needs
# roles/secretmanager.secretAccessor — the scope is necessary, not sufficient.
INSTANCE_SCOPES=https://www.googleapis.com/auth/cloud-platform

# Quota for this path lives on compute.googleapis.com, a different service from the TPU
# API's, with differently-spelled ids. The TPU API ids (TPUV5P...ForTPUAPI) meter the other
# control plane and say nothing about what CE will grant. Confirmed live 2026-08-10.
QUOTA_SERVICE=compute.googleapis.com
TPU_QUOTA_ID=TPU-V5P-per-project-zone
TPU_SPOT_QUOTA_ID=PREEMPTIBLE-TPU-V5P-per-project-zone

# One chip, so nothing to shard. This is the point of the CE path: the Cloud TPU API's floor
# was 4 chips and TP=4, which needed E2B's single KV head (MQA, num_key_value_heads=1)
# replicated four ways — a stack capability nobody here had verified. TP=1 removes it.
TENSOR_PARALLEL_SIZE=1

# Name of what this rig provisions: the GCE instance name for the MCP tools — the instance
# IS the node now, with no <RESOURCE_ID>-node indirection — and, as SERVICE_NAME, the
# instance for the Makefile's separate hand-provisioned path.
# Left unset, both derive from the rig directory name — tpu-vllm-v5p1-2b. Set them only to
# reach a resource created under an older name; a rename otherwise orphans it.
#RESOURCE_ID=
#SERVICE_NAME=

# Name this rig's MCP server advertises, and the key the client must register it under —
# that key prefixes every tool, as mcp__<name>__find_tpu. Left unset it derives from the rig
# directory (tpu-vllm-v5p1-2b), which is what keeps the sibling rigs distinguishable;
# they previously all registered as "tpu-devops". Set it only to match a client that has
# already registered this server under a different key. `make mcp-config` writes a .mcp.json
# using the same value.
#MCP_SERVER_NAME=tpu-vllm-v5p1-2b

# Default provisioning model for the instance tools: flex-start, spot, or on-demand.
# Every creation tool takes a provisioning_model argument that overrides this per call.
#   flex-start - queues for scarce capacity, then self-terminates AND DELETES the instance
#                at --max-run-duration, which server.py sets to 4h (ceiling is 7 days).
#                For v5p this model is offered in us-east5-a ONLY, which is why that is
#                the default zone above.
#   spot       - cheapest, drawn from the separate preemptible quota (TPU_SPOT_QUOTA_ID),
#                reclaimable with ~30s notice, and NOT bounded by max-run-duration.
#                Available in all three v5p zones.
#   on-demand  - full price, no preemption, also unbounded. Destroy it yourself.
#                Available in all three v5p zones.
PROVISIONING_MODEL=flex-start
