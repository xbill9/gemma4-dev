# local-llamacpp-i71360p-2b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# The file is named tpu.env for consistency with every sibling. There is no TPU,
# no GPU and no cloud here.
#
# Added 2026-09-29, code forked from local-llamacpp-cpu-2b-q4_0. That rig is
# pinned to a different machine (i7-10750H); nothing in its tpu.env, CLAUDE.md or
# benchmarks/ describes this one, and none of its measurements were carried over.

# ── Model ────────────────────────────────────────────────────────────────────
# MODEL_NAME is the upstream artifact; MODEL_PATH is what llama.cpp opens. The
# GGUF lives outside the git work tree on purpose.
#
# The exact Q4_0 rebuild: Google's GGUF metadata byte for byte, with all 275
# layer matrices, both embedding tables and per_layer_model_proj rebuilt as Q4_0
# from google/gemma-4-E2B-it-qat-q4_0-unquantized on the trained grid step.
# Only the F32 norms (1.1 MB) are stored otherwise.
# SHA-256 419db9a6bf3bc15d770c85ccf9216827aa88c64fe8f3d72fbe5674f48efe2dc8.
# benchmarks/runs/2026-09-29-exact-gguf-i71360p has the build and the measurements
# against Google's file; 2026-09-29-exact-gguf-v2-i71360p adds per_layer_model_proj.
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-exact-gguf
MODEL_PATH=/home/xbill/models/gemma-4-E2B-it-qat-q4_0-exact-v2/gemma-4-E2B-it-q4_0-exact.gguf

# Slot 5 of the directory name. Every weight matrix in this file is Q4_0,
# embeddings included (Google's GGUF stores both embedding tables as Q6_K and
# per_layer_model_proj as F16).
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED 2026-09-29 from lscpu, /proc/cpuinfo, /proc/meminfo, /sys and DMI.
# Lenovo Yoga 9 14IRP8 (DMI 83B1), bare metal (systemd-detect-virt: none), nvme +
# ext4, Debian sid, kernel 7.2.8, gcc 16.2.0. Graphics: Intel Iris Xe only — no
# /dev/nvidia*, no discrete GPU.
ACCELERATOR_TYPE=cpu
CPU_MODEL="13th Gen Intel(R) Core(TM) i7-1360P"
CPU_CORES=12
CPU_THREADS=16
# HYBRID. /sys/devices/cpu_core/cpus = 0-7 (4 P-cores, SMT pairs (0,1) (2,3)
# (4,5) (6,7)); /sys/devices/cpu_atom/cpus = 8-15 (8 E-cores, one thread each).
# The second thread of P-core N is 2N+1 on this die.
CPU_P_CORE_LOGICAL=0-7
CPU_E_CORE_LOGICAL=8-15
# avx2 and avx_vnni. No AVX-512, no AMX.
CPU_SIMD="avx2 avx_vnni"
HOST_RAM_GIB=15
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# A CPU-only build (GGML_CUDA=OFF) in a llama.cpp WORKTREE of its own, at the
# commit the 2026-09-29 measurements ran on (ghcr.io/ggml-org/llama.cpp:full,
# build 11243). ~/llama.cpp is local-llamacpp-cpu-2b-q4_0's checkout; moving it
# would move that rig's binary.
LLAMA_CPP_DIR=/home/xbill/llama.cpp-fc07d78
LLAMA_CPP_COMMIT=fc07d781e
LLAMA_SERVER_BIN=/home/xbill/llama.cpp-fc07d78/build-cpu/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# The endpoint is not discovered; it is known before the process starts. 8090,
# not the 8080 the llamacpp siblings share: attest.py tells devices apart, not
# rigs, and a second CPU rig on the same port would attest as this one.
HOST=127.0.0.1
PORT=8090
ENDPOINT=http://127.0.0.1:8090

# NOT configurable. `-ngl 0` and an empty CUDA_VISIBLE_DEVICES are hardcoded in
# both `make serve` and server.py.

CONTEXT_SIZE=8192

# UNMEASURED ON THIS HOST. f16 and -fa 1 are llama-server's usual settings here;
# neither was varied.
KV_CACHE_TYPE=f16
FLASH_ATTENTION=1

# Prometheus metrics at $ENDPOINT/metrics. Operational visibility only.
METRICS=1

# THREADS: see benchmarks/runs/2026-09-29-exact-gguf-i71360p/threads.md for the
# spot-check behind these values. Not a sweep, not pinned: the kernel places the
# threads across P- and E-cores as it likes.
THREADS=8
THREADS_BATCH=8

# One interactive session. llama.cpp SPLITS --ctx-size ACROSS SLOTS, so raising
# this without raising CONTEXT_SIZE shrinks each sequence.
PARALLEL_SLOTS=1

# Gemma 4 thinks before it answers, and on this CPU every thinking token costs
# the same ~26 tok/s as an answer token. `off` makes llama-server tell the chat
# template not to think; a request can still opt back in with
# "chat_template_kwargs": {"enable_thinking": true}. on | off | auto.
REASONING=off
