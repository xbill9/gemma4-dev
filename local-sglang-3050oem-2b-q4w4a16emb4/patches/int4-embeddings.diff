+def _int4_embedding_target(quant_config, name):
+    """True when a compressed-tensors config stores the table `name` as pack-quantized int4, group 32."""
+    targets = getattr(quant_config, "target_scheme_map", None) or {}
+    for target, scheme in targets.items():
+        if not target.startswith("re:") or re.match(target[3:], name) is None:
+            continue
+        w = (scheme or {}).get("weights")
+        return w is not None and w.num_bits == 4 and w.group_size == 32 and w.symmetric
+    return False
+
+
+class Gemma4Int4ScaledEmbedding(nn.Module):
+    """A compressed-tensors pack-quantized int4 table (group 32, symmetric) kept packed on the device.
+
+    Only the gathered rows are unpacked: nibble i of int32 word j holds q + 8 for column 8j + i, and
+    a row is q * weight_scale per 32 columns, then times embed_scale, as Gemma3TextScaledWordEmbedding.
+    """
+
+    def __init__(self, num_embeddings, embedding_dim, embed_scale=1.0):
+        super().__init__()
+        self.num_embeddings = num_embeddings
+        self.embedding_dim = embedding_dim
+        self.embed_scale = embed_scale
+        self.weight_packed = nn.Parameter(
+            torch.empty(num_embeddings, embedding_dim // 8, dtype=torch.int32), requires_grad=False
+        )
+        self.weight_scale = nn.Parameter(
+            torch.empty(num_embeddings, embedding_dim // 32, dtype=torch.float16), requires_grad=False
+        )
+        self.weight_shape = nn.Parameter(torch.empty(2, dtype=torch.int64), requires_grad=False)
+        self.register_buffer("shifts", torch.arange(0, 32, 4, dtype=torch.int32), persistent=False)
+        self._dense = None
+
+    def _rows(self, packed, scale, dtype):
+        q = ((packed.unsqueeze(-1) >> self.shifts) & 0xF) - 8
+        q = q.reshape(*packed.shape[:-1], self.embedding_dim // 32, 32).to(torch.float32)
+        w = q * scale.to(torch.float32).unsqueeze(-1)
+        return w.reshape(*packed.shape[:-1], self.embedding_dim).to(dtype)
+
+    @property
+    def weight(self):
+        # Dense table for callers that need one (a drafter's shared embedding); built once on request.
+        if self._dense is None:
+            dt = torch.get_default_dtype() if torch.get_default_dtype() != torch.float32 else torch.bfloat16
+            self._dense = torch.cat(
+                [self._rows(self.weight_packed[i:i + 8192], self.weight_scale[i:i + 8192], dt)
+                 for i in range(0, self.num_embeddings, 8192)])
+        return self._dense
+
+    def forward(self, input_ids):
+        dt = self.out_dtype
+        return self._rows(self.weight_packed[input_ids], self.weight_scale[input_ids], dt) * self.embed_scale
+
+    out_dtype = torch.bfloat16
+
+
