# local-litertlm-3050oem-2b-int248 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: the Makefile uses `include` + `?=`-style
# overrides and render_config.py reads os.environ first.
#
# ADDED 2026-11-02. Not a fork: the first `litertlm` rig. Same card and host as
# the local-llamacpp-3050oem-* and local-pytorch-3050oem-* rigs; they share the
# card and do not run beside each other.

# ── Model ────────────────────────────────────────────────────────────────────
# Google's LiteRT-LM build of Gemma 4 E2B, the general file (text, vision, audio,
# built-in MTP drafter). NOT gemma-4-E2B-it-gpu.litertlm from the same repo: that
# one is text-only, has no drafter, and stores the weights differently (int4/int8
# with a 4-bit per-layer table, no int2), so serving it would be another rig.
# Downloaded 2026-11-02; repo at revision cbb97a3e (last modified 18:15 UTC that
# day). MODEL_SHA256 decides, not the name or the revision.
MODEL_NAME=litert-community/gemma-4-E2B-it-litert-lm
MODEL_FILE=gemma-4-E2B-it.litertlm
MODEL_HF_REVISION=cbb97a3e73fd566bd089ca762461458c78ed4761
MODEL_PATH=/home/xbill/models/litert/gemma-4-E2B-it.litertlm
MODEL_SHA256=181938105e0eefd105961417e8da75903eacda102c4fce9ce90f50b97139a63c

# Slot 5. MEASURED 2026-11-02 from the file's own tensors
# (benchmarks/runs/2026-11-02-first-light-3050oem/encoding.txt):
#   int2  the wide MLPs of the 20 KV-shared layers (12288 x 1536) and the shared
#         262144 x 1536 embedding / output table
#   int4  every attention projection, the MLPs of the first 15 layers (6144 x 1536)
#         and the 35 per-layer embedding tables (262144 x 256)
#   int8  the per-layer embedding gates and projections
# Google's model card calls it the "Gemma-4 mobile quantization scheme".
QUANTIZATION=int248

# The name the OpenAI server answers to (`"model"` in a request). It is also the
# directory litert-lm import creates under $LITERT_LM_DIR/models/.
MODEL_ID=gemma-4-e2b

# Per-rig LiteRT-LM state: imported models, compiled GPU caches (778 MB of
# weights cache for this model) and nothing else. Not ~/.litert-lm, so no other
# rig or ad-hoc run shares it (CLAUDE.md, per-rig caches).
LITERT_LM_DIR=/home/xbill/.cache/local-litertlm-3050oem-2b-int248

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED-STATIC 2026-11-02, nvidia-smi: PCI 10de:2508, GA106, Ampere, sm_86,
# driver 615.78.08. Host `gpu` (i7-5820K, 46 GiB).
#
# LiteRT-LM reaches the card through WebGPU (Dawn) on VULKAN, not CUDA:
# `Selected adapter: NVIDIA GeForce RTX 3050 OEM, arch=ampere, vendor=nvidia,
# backend=Vulkan`. It needs libvulkan1 and /etc/vulkan/icd.d/nvidia_icd.json,
# both present. CUDA_VISIBLE_DEVICES does not select the card for it; the
# intel/freedreno "/dev/dri/renderD128: Permission denied" lines at start-up are
# Mesa ICDs probing and are harmless.
ACCELERATOR_TYPE="NVIDIA GeForce RTX 3050 OEM"
COMPUTE_CAPABILITY=8.6
VRAM_TOTAL_MIB=8192
NVIDIA_DRIVER=615.78.08
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# pip, system python3, user site (CLAUDE.md: no virtualenv). litert-lm needs
# protobuf >= 6.31.1 (its generated _pb2 files import runtime_version); Debian's
# python3-protobuf is 3.21.12 and fails at import, so a newer protobuf sits in
# ~/.local and shadows it.
LITERT_LM_VERSION=0.19.0
PROTOBUF_VERSION=7.36.2

# ── Serving ──────────────────────────────────────────────────────────────────
# Loopback only. `litert-lm serve` has no auth; set HOST=0.0.0.0 to open it to
# the LAN, as the llama.cpp rigs do.
HOST=127.0.0.1
PORT=9379
ENDPOINT=http://127.0.0.1:9379

BACKEND=gpu
# Compiled GPU programs and weights cached next to the imported model. MEASURED
# 2026-11-02: init 10.4 s cold, 3.8 s with the cache present.
CACHE=disk

# The built-in MTP drafter, on. MEASURED 2026-11-02
# (benchmarks/runs/2026-11-02-first-light-3050oem): six chat prompts, greedy, 256
# tokens: 82.6 tok/s off; on 1.168x geometric mean (code 1.80x .. summary 0.87x);
# adaptive 1.089x and its greedy replies do not repeat. Greedy text with the
# drafter differs from without it on 6 of 6 prompts. Values: on, off, adaptive.
SPECULATIVE_DECODING=on

# Empty = the engine's default, likely 4,096 (inferred: the server holds the
# same ~1.4 GB as a 4,096 benchmark). MEASURED 2026-11-02
# (benchmarks/runs/2026-11-02-context-3050oem): 32768 takes ~4.0 GB and, on the
# same short prompt, reads at 0.40x and generates at 0.65x; 65536 and 131072
# behave exactly like 32768 (model card: up to 32k). Set 32768 for long
# conversations, at that cost.
MAX_NUM_TOKENS=

# Not set: MEASURED 2026-11-02, gpu_decode_steps_per_sync 1/2/4/8 gave 86.12 /
# 85.18 / 85.36 / 84.97 tok/s (engine benchmark, drafter off). No gain.
