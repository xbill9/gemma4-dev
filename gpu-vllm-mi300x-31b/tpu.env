# gpu-vllm-mi300x-31b configuration — the source of truth for this rig.
#
# Named tpu.env like every sibling, including the gpu-* and local-* ones. The
# name is a monorepo convention, not a claim that this rig is a TPU.
#
# Committed on purpose, and deliberately not gitignored: everything in here is
# an identifier, never a secret. The API token is NOT here. It lives in `.env`
# (gitignored, mode 0600) or in the environment.
#
# A real environment variable always wins over this file: python-dotenv does
# not overwrite, and the Makefile uses `?=`.

# Every droplet lookup is filtered by this tag, so the MCP server can only see
# droplets somebody tagged for this rig.
DROPLET_TAG=gemma

# SSH into the droplet. DigitalOcean's GPU images land you as root by default.
SSH_USER=root
SSH_PORT=22
# Path to the private key, if it is not one ssh finds by itself. `~` is expanded.
SSH_KEY=~/amd

# Where the rig checkout lives on the droplet.
REMOTE_WORKDIR=/opt/gpu-vllm-mi300x-31b

# The MCP client's key for this server. It prefixes every tool name
# (mcp__gpu-vllm-mi300x-31b__serving_status), so it must match the directory
# name or two loaded rigs become indistinguishable at the call site.
MCP_SERVER_NAME=gpu-vllm-mi300x-31b

# The checkpoint: Gemma 4 31B as Google publishes it, bf16, 62.55 GB, ungated.
# Multimodal (Gemma4ForConditionalGeneration) — the vision tower is loaded but
# LIMIT_MM_PER_PROMPT below admits no images, so it serves text only, like the
# -text repack it is the control for. The tower's weights still sit in memory;
# that is a known residual difference against the repack, not an oversight.
VLLM_MODEL=google/gemma-4-31B-it
VLLM_PORT=8000
VLLM_CONTAINER=vllm

# The serving image. A CONTAINER NIGHTLY, ON PURPOSE.
#
# rocm/vllm:rocm10.0.0_..._vllm_0.27.0 is the newest image AMD publishes and it
# CANNOT LOAD THIS MODEL: no Gemma4ModelArchConfigConvertor, so config parsing
# raises AmbiguousGlobalPerLayerAttributeError on `head_dim` before the GPU is
# touched. rocm/vllm:rocm7.13.0_gfx94X-dcgpu_..._vllm_0.19.1 does work, from the
# other side — transformers 5.8.1 predates per-layer attributes entirely.
#
# The pip channel vLLM's own Gemma 4 recipe names,
# wheels.vllm.ai/rocm/nightly/rocm721, is staler than both at 0.20.2rc1.
#
# Run `check_image` before changing this line.
VLLM_IMAGE=vllm/vllm-openai-rocm:nightly-rocm100

# Where model weights are cached on the droplet. Mounted into the container so
# an image swap does not re-download the weights.
HF_CACHE=/opt/hf-cache

# Serving shape. Identical to gpu-vllm-mi300x-31b-q4w4a16 so the two are an
# A/B pair. 32768 of a supported 262144. 62.55 GB of weights leave well over
# 100 GiB of the 0.90 budget for KV, so the pool is not the constraint here.
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90

# Empty = serve bf16 as published. This rig is the control; leave it empty. `fp8` adds `--quantization fp8`: vLLM derives
# e4m3fnuz scales from the bf16 weights at load. Do NOT point VLLM_MODEL at an
# fp8 Hub checkpoint instead — those are e4m3fn and raise
# HIPBLAS_STATUS_NOT_SUPPORTED on gfx942. benchmarking_suite.py records this in
# the report's model.quantization, so a report cannot claim bf16 for an fp8 run.
VLLM_QUANTIZATION=

# Text-only serving of a multimodal checkpoint: no images (so it matches the
# -text repack and skips encoder profiling), no audio (31B has no audio tower,
# and no ROCm image could serve one anyway). verify_capabilities skips vision.
LIMIT_MM_PER_PROMPT={"image": 0, "audio": 0}

# Empty: a bf16 checkpoint needs no mixed-precision kernel. The comment below
# is kept from the 4-bit siblings so the two env files diff cleanly.
# The 4-bit path. vLLM main lists these ROCm mixed-precision kernels, in order:
# RDNA3, RDNA-hybrid (both gfx11/gfx12 only), TritonW4A16, Conch (needs a
# package), ExLlama (fp16 activations only; Gemma 4 runs bf16). On gfx942 a
# symmetric group-32 bf16-activation checkpoint therefore has TritonW4A16 or
# nothing. check_image fails an image that does not list it.
EXPECT_MP_KERNEL=

# What benchmarking_suite.py writes into the report's model block. Without
# these a 4-bit run would be filed as bfloat16 / none, because
# VLLM_QUANTIZATION is empty for a checkpoint that is stored quantized.
MODEL_PARAMETERS_B=31
WEIGHTS_DTYPE=bfloat16
CHECKPOINT_QUANTIZATION=none

# Ships inside the image; no mount needed.
CHAT_TEMPLATE=/app/vllm/examples/tool_chat_template_gemma4.jinja

# Render groups on the Debian 13 GPU image, passed as --group-add so the
# container opens /dev/kfd without running privileged.
RENDER_GIDS=44,991
