# local-litertlm-i71360p-2b-q4wi4b32 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# The file is named tpu.env for consistency with every sibling. There is no TPU,
# no GPU and no cloud here.
#
# Added 2026-10-15 as the LiteRT-LM sister of local-llamacpp-i71360p-2b-q4_0: same
# host, same QAT weights on their trained 4-bit grid. Nothing was copied from that
# rig but host facts re-read from this machine.

# ── Model ────────────────────────────────────────────────────────────────────
# Built here by build_litertlm.py (`make model`) from the QAT source below; not on
# the Hub. MODEL_PATH is named model.litertlm inside a directory whose name, with
# `--` read as `/`, is MODEL_NAME: that is how litert-lm derives a model id, and
# the id keys this rig's --config entry.
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-litertlm-wi4b32
MODEL_PATH=/home/xbill/models/litertlm/xbill9--gemma-4-E2B-it-qat-q4_0-litertlm-wi4b32/model.litertlm
SRC_MODEL=google/gemma-4-E2B-it-qat-q4_0-unquantized
SRC_REVISION=6befbaca7398925921802abd1f277b495b78b738
SRC_DIR=/home/xbill/models/hf/gemma-4-E2B-it-qat-q4_0-unquantized

# Slot 5 of the directory name. Every FULLY_CONNECTED and EMBEDDING_LOOKUP weight
# is LiteRT dynamic int4 in blocks of 32 (ai_edge_quantizer dynamic_wi4b32_afp32),
# each block's scale the trained QAT step; LiteRT holds those scales at bf16
# precision. Text only: no vision or audio sections, no MTP drafter.
QUANTIZATION=q4wi4b32

# Export shape (build_litertlm.py). The KV cache is sized at export time.
CACHE_LENGTH=8192
PREFILL_LENGTHS=128,1024

# ── Hardware ─────────────────────────────────────────────────────────────────
# Same machine as local-llamacpp-i71360p-2b-q4_0, re-read 2026-10-15 (lscpu,
# free): Lenovo Yoga 9 14IRP8, i7-1360P, hybrid 4 P-cores with SMT (logical 0-7)
# + 8 E-cores (8-15), avx2 + avx_vnni, no AVX-512, no AMX, 15 GiB RAM, Iris Xe
# only.
ACCELERATOR_TYPE=cpu
CPU_MODEL="13th Gen Intel(R) Core(TM) i7-1360P"
CPU_CORES=12
CPU_THREADS=16
CPU_P_CORE_LOGICAL=0-7
CPU_E_CORE_LOGICAL=8-15
CPU_SIMD="avx2 avx_vnni"
HOST_RAM_GIB=15
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# pip packages in the system python3 (no virtualenv). Versions as installed
# 2026-10-15; litert-lm 0.18.0 needs protobuf >= 7.35.
LITERT_LM_BIN=litert-lm
LITERT_LM_VERSION=0.18.0
LITERT_TORCH_VERSION=0.10.0.dev20261015

# ── Serving ──────────────────────────────────────────────────────────────────
# 8092: 8090 is the llama.cpp sister, 8091 its E4B sibling.
HOST=127.0.0.1
PORT=8092
ENDPOINT=http://127.0.0.1:8092

# Written into run/litertlm-config.json (`make config`) under this model's id.
# The backend is NOT here: server.py and the Makefile write "cpu" unconditionally.
MAX_NUM_TOKENS=8192
CPU_THREAD_COUNT=8
# `false` = Gemma 4 answers without a thinking block unless a request asks
# (reasoning_effort). Matches the sister's REASONING=off.
THINKING=false
# Compiled XNNPACK artifacts persisted next to the model, so a restart does not
# recompile.
COMPILE_CACHE=disk
