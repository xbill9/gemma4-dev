# local-llamacpp-3050oem-12b-q4_0 — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: Makefiles use ?= and dotenv does not overwrite.
#
# FORKED 2026-10-16 from local-llamacpp-3050oem-4b-q4_0, its E4B sister on the same
# card, host and llama.cpp binary. Slot 4 is the only slot that differs. Values
# marked "E4B" were measured on that rig and carried; re-measured ones say so.

# ── Model ────────────────────────────────────────────────────────────────────
# Exact Q4_0 rebuild of Google's 12B QAT GGUF (google/gemma-4-12B-it-qat-q4_0-gguf):
# every weight matrix Q4_0, token_embd included (Q6_K in Google's file), from
# google/gemma-4-12B-it-qat-q4_0-unquantized on the trained grid step. Text only:
# the vision tower is Google's separate mmproj file and is not loaded. Built in
# benchmarks/runs/2026-10-16-exact-gguf-12b-3050oem. Published 2026-10-16 at revision
# 85e797eff295c45f8db90ba4e12d868578638c0e; the Hub's SHA-256 matches MODEL_SHA256.
MODEL_NAME=xbill9/gemma-4-12B-it-qat-q4_0-exact-gguf
MODEL_PATH=/home/xbill/models/gemma-4-12B-it-qat-q4_0-exact/gemma-4-12B-it-q4_0-exact.gguf
MODEL_SHA256=038337ee0375f602cc39eac7575b1c562cf7faaffcdbf538909c243862752731

# Slot 5 of the directory name. Every weight matrix in the file is Q4_0.
QUANTIZATION=q4_0

# ── Hardware ─────────────────────────────────────────────────────────────────
# MEASURED-STATIC 2026-10-13, `nvidia-smi --query-gpu=name,compute_cap,memory.total,
# memory.free,driver_version,pci.device_id`: PCI 10de:2508, GA106. Ampere, sm_86,
# with tensor cores (the parent's TU117 has none). Host: ASUS X99-A, i7-5820K
# (6C/12T Haswell-E, AVX2, no AVX-512), 46 GiB RAM, hostname `gpu`.
ACCELERATOR_TYPE="NVIDIA GeForce RTX 3050 OEM"
COMPUTE_CAPABILITY=8.6
VRAM_TOTAL_MIB=8192
VRAM_FREE_MIB=7875
NVIDIA_DRIVER=615.78.08
CUDA_VISIBLE_DEVICES=0
TENSOR_PARALLEL_SIZE=1

# ── Runtime ──────────────────────────────────────────────────────────────────
# Cloned fresh 2026-10-13 and built with `make build`: GGML_CUDA=ON, CUDA_ARCH=86,
# GGML_NATIVE=ON, Release, FORCE_MMQ off. gcc 16.2.0, CUDA 13.4 (V13.4.92) at
# /usr/local/cuda, which is NOT on PATH by default on this host. The checkout was
# fast-forwarded and rebuilt 2026-10-16 11:32 (reflog); every 12B measurement is on
# that build. The E2B/E4B sisters' tpu.env still name 77c4540ce.
LLAMA_CPP_DIR=/home/xbill/llama.cpp
LLAMA_CPP_COMMIT=7182ef71e
LLAMA_SERVER_BIN=/home/xbill/llama.cpp/build/bin/llama-server

# ── Serving ──────────────────────────────────────────────────────────────────
# The endpoint is not discovered. It is known before the process starts, which
# is the one place CLAUDE.md's "never hardcode an endpoint" rule does not apply
# — there is no QR -> node -> external IP chain here to walk.
#
# HOST=0.0.0.0 since 2026-10-13: listen on every interface so the LAN can reach
# it (eno1 is 192.168.0.156). No auth and no firewall on this host, so anyone on
# the LAN can use it. ENDPOINT stays on loopback: it is what the Makefile, the
# MCP server and sweep.py call, and 127.0.0.1 reaches a 0.0.0.0 listener.
HOST=0.0.0.0
PORT=8080
ENDPOINT=http://127.0.0.1:8080

# N_GPU_LAYERS=99 offloads every block: 6390.19 MiB of weights on the card. The 12B has
# no per-layer table, so nothing large stays in the mmap except token_embd's 540 MiB
# input copy (the output copy is on the card). Never pass --no-mmap.
N_GPU_LAYERS=99

# MEASURED 2026-10-16 (benchmarks/runs/2026-10-16-first-light-3050oem, fit.md): the
# context cache, not the weights, sets the limit. KV costs 16 KiB/token (8 full-attention
# layers, 1 KV head of 512, K+V f16) plus a fixed 480 MiB for the 40 sliding layers
# (1536 cells). Largest -c that loads: f16 40960 (7772 MiB) without the drafter, 24576
# (7820 MiB) with it; q8_0 KV 65536 without, 49152 with. Google's file: f16 28672.
# 24576 is what fits with the drafter at f16; n_ctx_train is 131072.
# Generation without the drafter: 28.6 / 26.8 / 26.3 tok/s at 0 / 8k / 16k tokens of context.
CONTEXT_SIZE=24576

# f16. 2B: q8_0 K+V was 0.961x prefill and 0.926x decode. Not re-measured on 12B; q8_0
# doubles the context that fits (49152 with the drafter).
KV_CACHE_TYPE=f16

# 2B: 1.133x prefill, 1.071x decode against -fa 0. Not re-measured on 12B.
FLASH_ATTENTION=1

# Prometheus metrics at $ENDPOINT/metrics (llama-server answers 501 without
# --metrics). For operational questions and for checking the prompt cache was
# defeated in a sweep, never for the benchmark decode column: --decode-source
# auto must keep resolving to `stream` (CLAUDE.md).
METRICS=1

# 2B: -t 4 within 0.5% of -t 6; decode runs on the card. Not re-measured on 12B.
THREADS=6
# Carried from the parent; UNMEASURED here. Prefill runs on the card.
THREADS_BATCH=12

# 1: this rig's normal use is one interactive session. Concurrency UNMEASURED on
# 12B; with -c 24576 there is little room to split. llama.cpp SPLITS --ctx-size ACROSS SLOTS.
PARALLEL_SLOTS=1

# Thinking, server-wide: llama-server --reasoning {on,off,auto}. OFF so answers
# arrive directly in `content`. A request can still ask for it with
# "chat_template_kwargs": {"enable_thinking": true}, which is what sweep.py does.
REASONING=off

# llama.cpp's default. UNMEASURED on this card; the parent measured it marginally
# worse on the 1650 Ti, which has no tensor cores. This card does.
GGML_CUDA_FORCE_MMQ=OFF

# Empty: the 12B has no per-layer table to place (E4B's sister puts its table on the card).
OVERRIDE_TENSORS=

# ── Speculative decoding ─────────────────────────────────────────────────────
# Google's drafter for this checkpoint, google/gemma-4-12B-it-qat-q4_0-unquantized-
# assistant (revision 18934064, 4 layers of width 1024, queries only, sharing the
# target's KV), ships as bf16 on its 4-bit QAT grid. Served as exact Q4_0 on that grid
# (253.7 MB against 465.1 MB for llama.cpp's Q8_0 conversion), built by gguf_exact.py in
# benchmarks/runs/2026-10-16-drafter-q4exact-12b-3050oem, published at SPEC_DRAFT_HF.
# MEASURED 2026-10-16 there (-c 8192, six prompts, greedy x3, 256 tokens): no drafter
# 28.1 tok/s; exact Q4_0 at 1 / 2 / 3 drafted tokens 1.62x / 2.01x / 2.02x (45.6 / 56.4 /
# 56.7); Q8_0 at 2 tokens 1.90x (53.4). Acceptance at 2 tokens 0.658 (Q4_0) and 0.661
# (Q8_0). VRAM 7255 / 7569 / 7771 MiB for none / Q4_0 / Q8_0. Sampled (temperature 0.8):
# 1.90x. 2 tokens kept: level with 3, and 3 costs more on long text (story 1.67x vs 1.75x).
# Greedy text with the drafter repeats exactly but differs from serving without it in
# 18 of 18 replies at 2 tokens (9 of 18 at 1); answers are not: GSM8K 0.9598 vs 0.9629 and BFCL 0.9500 vs
# 0.9475 with vs without, both level (benchmarks/runs/2026-10-16-accuracy-12b-3050oem).
# Empty SPEC_DRAFT_MODEL to turn off (then -c 40960 fits at f16).
SPEC_DRAFT_MODEL=/home/xbill/models/gemma-4-12B-it-qat-assistant/gemma-4-12B-it-qat-assistant-q4_0-exact.gguf
SPEC_DRAFT_SHA256=f22f6366ca76102ac1d365a7ee331e80d4b1e986ddd7f0149c6d3ca5c7a87985
SPEC_DRAFT_HF=xbill9/gemma-4-12B-it-qat-assistant-q4_0-exact-gguf
SPEC_DRAFT_HF_REVISION=5fc2e28753efa96e4bd0a3cc365bbf5ffa789404
SPEC_DRAFT_N_MAX=2
