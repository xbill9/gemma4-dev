# lambda-pytorch-g6-2b-q4w4a16 — authoritative configuration.
#
# The directory name is documentation; this file decides (NAMING.md). A real environment variable wins.
# ADDED 2026-11-19: gpu-pytorch-g6-2b-q4w4a16's hand-built int4 engine (e2b_engine.py, w4gemv.py, w4attn.py,
# gemma4_tools.py, openai_server.py, copied byte-for-byte into image/engine/) as a Lambda GPU function.

ENGINE=cmd
ENGINE_LABEL="PyTorch int4 engine"
ENGINE_LOG_PATTERN=?"engine-ext"

# ── Model (the hub cache baked into the image at /opt/hf, read offline) ──────
MODEL_NAME=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text
MODEL_REVISION=315aec06cff196fd6479aa2669bf9379b0d0268a
VOCAB_TABLES=xbill9/gemma-4-E2B-it-qat-q4_0-w4a16-ct-text-emb4
VOCAB_TABLES_REVISION=db715f83da4f13289761d7c45f4d19ceac84695d
QUANTIZATION=q4w4a16

# ── Image ────────────────────────────────────────────────────────────────────
# AWS's Lambda PyTorch image: torch 2.14.1 (FRAMEWORK_VERSION), Python 3.13, CUDA 13.0.3, created 2026-11-13;
# tags cuda and cuda-v1 on 2026-11-19. The G6 rig ran the DLAMI's torch 2.13. The engine's pins
# (gpu-pytorch-g6-2b-q4w4a16/requirements-serving.txt) are installed with torch held at the image's version.
BASE_IMAGE=public.ecr.aws/lambda/deep-learning-containers/pytorch@sha256:b9521b1134f4e4c119241ad6ee48730a29523799325f9a13dec979dad6bed578
TORCH_PIP_SPEC=transformers==5.16.1 compressed-tensors==0.17.0 accelerate==1.14.0 huggingface_hub==1.31.0 safetensors numpy jinja2
BUILD_ARGS=BASE_IMAGE,MODEL_NAME,MODEL_REVISION,VOCAB_TABLES,VOCAB_TABLES_REVISION,TORCH_PIP_SPEC

# ── Serving ──────────────────────────────────────────────────────────────────
# One request at a time (the engine does not batch); Lambda queues the rest in the environment, up to
# PER_ENV_MAX_CONCURRENCY. --max-ctx 8192 as in the G6 flight.
MAX_MODEL_LEN=8192
ENGINE_PORT=8000
ENGINE_CMD=/var/lang/bin/python3 /opt/engine/openai_server.py --host 127.0.0.1 --port 8000 --max-ctx 8192

# ── AWS (lambda-vllm-g6-2b-q4w4a16emb4's values) ─────────────────────────────
AWS_REGION=us-east-1
# g6.2xlarge: 8 vCPUs, 32,768 MiB, one L4 with 22,888 MiB (DescribeInstanceTypes, 2026-11-18).
INSTANCE_TYPE=g6.2xlarge
ACCELERATOR_TYPE="NVIDIA L4"
# One capacity provider for every lambda-*-g6 rig (created by lambda-vllm-g6-2b-q4w4a16emb4). The account's
# "Running On-Demand G and VT instances" quota in us-east-1 is 16 vCPUs: two rigs up at once at most.
CAPACITY_PROVIDER=gemma4-e2b-g6
MAX_VCPU_COUNT=16
SUBNET_IDS=
SECURITY_GROUP_IDS=
OPERATOR_ROLE=lambda-lmi-gpu-operator
EXECUTION_ROLE=lambda-lmi-gpu-exec

# ── Function ─────────────────────────────────────────────────────────────────
FUNCTION_NAME=gemma4-e2b-g6-pytorch
MEMORY_MB=16384
MEMORY_GIB_PER_VCPU=4
ACCELERATOR_MEMORY_GB=16
EPHEMERAL_MB=10240
TIMEOUT_S=900
PER_ENV_MAX_CONCURRENCY=4
MIN_ENVS=1
MAX_ENVS=1
# Seconds the engine extension waits for the server during Init (Lambda's Init limit is the function timeout).
SERVER_TIMEOUT=840

# ── Image build (builder.py: one EC2 instance shared by the lambda-*-g6 rigs) ──
ECR_REPO=lambda-pytorch-g6-2b-q4w4a16
IMAGE_TAG=315aec06cff1
BUILDER_INSTANCE_TYPE=c7i.4xlarge
BUILDER_DISK_GB=300
# Every checkpoint here is public and ungated (Hugging Face API, 2026-11-19): no token needed.
HF_SECRET_ID=

# ── Local chat page (chat_ui.py) ─────────────────────────────────────────────
# lambda-vllm 8768, lambda-sglang 8769, lambda-llamacpp 8770, lambda-pytorch 8771, lambda-jax 8772.
UI_PORT=8771
