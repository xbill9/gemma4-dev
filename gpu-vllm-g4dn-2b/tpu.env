# gpu-vllm-g4dn-2b — authoritative configuration.
#
# The directory name is documentation; this file decides. Never copy a slot value
# out of the directory name into a CLI flag (NAMING.md, "The name is a claim").
#
# Committed on purpose and deliberately NOT gitignored. A real environment
# variable always wins over it: mcp-run.sh exports only unset keys, Makefiles
# use ?=, and dotenv does not overwrite.
#
# STATUS: THIS RIG HAS SERVED NOTHING. Forked from `gpu-vllm-g6-2b` 2026-08-29,
# which had itself served nothing. `benchmarks/runs/` is deliberately empty and no
# run directory was copied at either fork. EVERY value below marked MEASURED was
# measured on `gpu-vllm-g5g-2b` (T4G, Turing, Graviton2) or `gpu-jax-g5g-2b`, NOT
# here. Treat all of them as PREDICTED until re-run.
#
# WHY THIS RIG EXISTS: it isolates ONE of the two problems that make
# `gpu-vllm-g5g-2b` the hardest rig in this tree.
#
#   axis                        g5g (aarch64, 7.5)   g6 (x86_64, 8.9)   THIS (x86_64, 7.5)
#   SM in the published image?  NO  -> 67-min build  yes                YES
#   Turing 64 KiB shared mem?   BLOCKS -> patch      n/a (~99 KiB)      BLOCKS -> patch
#
# x86_64 means this rig pulls the amd64 manifest, and that is the manifest
# carrying SM 7.5. So the packaging half of the G5g problem is gone outright. The
# Turing half is untouched, and unlike on Ada it is not a margin to check:
# 65,536 < 98,304 is arithmetic, and the same silicon already produced the
# failure. See docs/turing-shared-memory.md.
#
# IT IS ALSO THE RUNTIME CONTROL FOR `gpu-jax-g4dn-2b` — same chip, same host,
# same checkpoint, different runtime. That rig has measured nothing either, so
# the comparison is available rather than made.

# --- Model -------------------------------------------------------------------
# Reference instruction-tuned release, so the rig name carries no encoding slot.
# MODELS.md: 10.2 GB / 9.5 GiB of bf16 weights, 18 KiB/token of KV.
MODEL_NAME=google/gemma-4-E2B-it

# --- Hardware ----------------------------------------------------------------
# The hardware slot is `g4dn` — the EC2 instance family, by the general EC2 rule
# in NAMING.md (`g5g`, `g4dn`, `g6`, `g6f`), NOT the GPU SKU. The GPU is an NVIDIA
# T4. Family rather than SKU is what pins the x86_64 host, and the host is
# EXACTLY what distinguishes this rig from `gpu-vllm-g5g-2b`: same Turing
# silicon, different architecture, and that difference is the whole finding.
# Naming both `t4`-something would hide it.
INSTANCE_TYPE=g4dn.xlarge
AWS_REGION=us-east-1

# TWO TRAPS relative to the G5g table, both shared with G6:
#   * Host RAM is DOUBLE its g5g namesake at every suffix. g4dn.xlarge has 16 GiB
#     where g5g.xlarge had 8 -- so the G5g rig's "xlarge cannot stage the weights"
#     verdict DOES NOT transfer, and g4dn.xlarge is a reasonable default.
#   * GPU count is NOT MONOTONIC in the size: 12xlarge has 4, 16xlarge has 1,
#     metal has 8. Never infer it from the suffix.
#
#   size            GPUs  GPU mem  vCPU   RAM
#   g4dn.xlarge      1      16 GB    4    16 GB   <- default
#   g4dn.2xlarge     1      16 GB    8    32 GB
#   g4dn.4xlarge     1      16 GB   16    64 GB
#   g4dn.8xlarge     1      16 GB   32   128 GB
#   g4dn.12xlarge    4      64 GB   48   192 GB
#   g4dn.16xlarge    1      16 GB   64   256 GB
#   g4dn.metal       8     128 GB   96   384 GB
#
# G4dn is 4 GiB of RAM per vCPU; G5g was 2. Any inherited `RAM // 2` vCPU
# shortcut silently DOUBLES the answer. server.py reads it from the table.
TENSOR_PARALLEL_SIZE=1

# --- Turing (SM 7.5) --- the G6 sibling's dtype policy is WRONG here ----------
# Turing has NO bfloat16 datapath and NO fp8. Ada has both, so a fork from
# `gpu-vllm-g6-2b` inherits `DTYPE=bfloat16` and is wrong in the one place that
# matters most on this part.
#
# MEASURED on `gpu-vllm-g5g-2b` 2026-08-12 and worth stating precisely, because
# the WRONG REASON invites someone to delete the guard: bfloat16 does NOT fail.
# PyTorch upconverts, vLLM logs `Casting torch.bfloat16 to torch.float16` and
# proceeds. float16 is correct because it is what EXECUTES, not because bf16
# errors. A silent cost is worse than an error.
DTYPE=float16

# `auto` keeps KV at the model dtype, i.e. float16. fp8 KV is NOT REACHABLE on
# Turing -- no datapath at all, unlike on the G6 sibling where it exists and is
# merely unused. int8 is this part's only low-precision compute win
# (HARDWARE.md), and vLLM does not expose it as a KV cache dtype.
KV_CACHE_DTYPE=auto

# NOTE: there is deliberately no VLLM_ATTENTION_BACKEND here, and the reason is
# MEASURED on the G5g sibling 2026-08-12 rather than assumed. It was once set to
# XFORMERS on the theory that FlashAttention needs SM 8.0+; in fact vLLM v0.27
# does not recognize the variable at all ("Unknown vLLM environment variable
# detected"), AND it forces TRITON_ATTN for Gemma 4 regardless, because the
# model's head dims are heterogeneous (sliding 256 / global 512) and only FA4 or
# Triton handle that. Setting it did nothing; it would be dead config.
#
# HARDWARE.md still says "the Turing-capable vLLM attention backend is XFORMERS".
# That line predates this measurement and is stale.
#
# So the backend is not the knob. THE TILE SIZE INSIDE THE FORCED TRITON KERNEL
# IS, and that is what patch_triton_turing.py changes -- see below.

# The T4G MEASURED 15360 MiB total and 13501 MiB in use while serving, giving a
# 2.95 GiB KV pool = 329,579 tokens at 0.90. The T4 here is the same die with the
# same 16 GB of GDDR6, so the arithmetic should carry -- ARITHMETIC, NOT MEASURED.
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=8

# --- Serving -----------------------------------------------------------------
VLLM_PORT=8000
SERVICE_NAME=vllm-g4dn
HF_SECRET_ID=vllm/hf-token

# TWO IMAGE NAMES, AND THE SPLIT MEANS SOMETHING DIFFERENT FROM EITHER SIBLING.
#
#   * `gpu-vllm-g6-2b` has ONE name: SM 8.9 needs no patch, so what you pull is
#     what you serve.
#   * `gpu-vllm-g5g-2b` has a stock/built split where the built side is 67
#     minutes of COMPILATION, because the arm64 image has no SM 7.5 kernels.
#
# Here the published amd64 image already HAS the SM 7.5 kernels, so nothing is
# compiled -- but the Triton attention tile still has to shrink, and that is one
# pure-Python file. VLLM_PATCHED_IMAGE is a derived tag built `FROM` the pulled
# one with a single COPY. Seconds, not an hour.
#
# THE INHERITED TAG DID NOT EXIST. `gpu-vllm-g6-2b` pins
# `vllm/vllm-openai:v0.27.2rc0` and this rig copied it at the fork. CHECKED
# 2026-08-29 against both registries: 404 on Docker Hub, and no such git tag --
# the published sequence goes v0.27.0, rc1/rc2, v0.27.1, then v0.28.0rc1/rc2,
# v0.28.0, v0.28.1rc0. Cloud-init would have died at `docker pull`.
#
# The FLOOR is unaffected: v0.26.0 dies with AmbiguousGlobalPerLayerAttributeError
# against current transformers because Gemma 4's head_dim is per-layer, and that
# is a constraint of the MODEL, so it holds on every part in this tree. v0.28.0
# clears any v0.27.x floor outright.
#
# v0.28.0 rather than `nightly`: nightly is a MOVING tag and this rig renders
# deterministic user data. Checked anyway -- for triton_unified_attention.py
# `main` is BYTE-IDENTICAL to v0.28.0, so nightly buys nothing here.
#
# VERIFIED on the real v0.28.0 manifest 2026-08-29 -- this rig's whole premise:
#   linux/amd64  7.5 8.0 8.6 8.9 9.0 10.0 12.0    <- SM 7.5 PRESENT
#   linux/arm64  8.0 8.7 8.9 9.0 10.0 11.0 12.0   <- SM 7.5 ABSENT
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
VLLM_PATCHED_IMAGE=vllm-openai:v0.28.0-sm75-patched

# Headroom under Turing's hard 65,536 B per block. The tile arithmetic in the
# patch does not account for the kernel's accumulators, so budgeting the full
# limit still overflows. This is the value the G5g sibling ran with.
TURING_SMEM_BUDGET=60000

# TORCH_CUDA_ARCH_LIST, VLLM_REF and CUDA_TOOLKIT_PACKAGE are GONE, not blank.
# Nothing here compiles, so an arch list, a source ref and a toolkit package
# would be inert settings that look meaningful. Do not reintroduce them without
# a build to feed -- and note that the PATCH is not a build: it edits one file in
# a published image.

# --- Root volume -------------------------------------------------------------
# Three multi-GB reads land here: the image pull, the derived build, and the
# 10.2 GB checkpoint the loader then reads back. Throughput is set EXPLICITLY
# because gp3 defaults to 125 MiB/s.
#
# PORTED FROM `gpu-jax-g5g-2b`, where it is MEASURED: two unrelated load stages
# both landed on ~125 MB/s, the signature of a volume ceiling rather than CPU or
# network, and raising it took that rig's read_shards 73.5s -> 24.7s (3.0x).
# UNMEASURED HERE.
#
# gp3 requires throughput <= IOPS * 0.25, and that rule is enforced at
# run-instances time -- violating it fails a LAUNCH, not just a disk.
ROOT_VOLUME_GB=100
ROOT_VOLUME_THROUGHPUT_MBPS=500
ROOT_VOLUME_IOPS=6000

# --- AMI ---------------------------------------------------------------------
# x86_64 GPU DLAMI. The architecture requirement is the axis that separates this
# rig from `gpu-vllm-g5g-2b`: an arm64 image cannot boot a G4dn, and an x86_64
# image cannot boot a G5g.
#
# BASE, not PyTorch: this rig serves from a docker image carrying its own CUDA
# and torch, so a PyTorch DLAMI is GBs of unused image. The DLAMI supplies the
# NVIDIA driver and docker, nothing else.
#
# `/latest/` in a DLAMI path is only the newest build WITHIN one PyTorch-and-
# Ubuntu line, and AWS stops rebuilding a line -- the G5g rig pinned
# `pytorch-2.7-ubuntu-22.04`, which froze at a 2026-05-02 image while reading as
# "track latest". This exact path was VERIFIED ON HARDWARE by `gpu-jax-g6-2b` on
# 2026-08-28 (driver 595.91.07, Ubuntu 26.04) -- on a G6, NOT on a G4dn.
DLAMI_SSM_PARAMETER=/aws/service/deeplearning/ami/x86_64/base-oss-nvidia-driver-gpu-ubuntu-26.04/latest/ami-id

# Fallback for describe-images. It must NOT require "ARM64 AMI" contiguously the
# way the G5g rig's pattern does: the base images are named "Deep Learning Base
# OSS Nvidia Driver GPU AMI (Ubuntu 26.04)". Changing the SSM path without
# changing this filter in the same commit is a revert that reports success --
# the fallback quietly resolves the old image.
DLAMI_NAME=Deep Learning Base OSS Nvidia Driver GPU*Ubuntu*
