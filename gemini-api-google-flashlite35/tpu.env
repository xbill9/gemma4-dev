# gemini-api-google-flashlite35 — Gemini 3.5 Flash-Lite through the Gemini API, a comparison sibling for the Gemma rigs.
#
# Nothing here provisions anything: the Gemini API is Google's hosted service. This file names the
# endpoint and the model; the key is read from ~/gemini.key (or GEMINI_API_KEY_FILE). A real
# environment variable wins over this file.
#
# Read 2026-11-13 from GET /v1beta/models/gemini-3.5-flash-lite and one probe request:
#   displayName          Gemini 3.5 Flash-Lite
#   inputTokenLimit      1048576
#   outputTokenLimit     65536
#   thinking             true
#   lowest thinking level accepted by reasoning_effort: minimal
#   serving stack        not disclosed  -> slot 2 is api
#   hardware             not disclosed  -> slot 3 is google
# Thinking tokens are not in the endpoint's completion_tokens; they appear only in total_tokens.

GEMINI_OPENAI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_API_KEY_FILE=~/gemini.key
MODEL_NAME=gemini-3.5-flash-lite
LOWEST_REASONING_EFFORT=minimal
CONTEXT_LENGTH=1048576
MAX_OUTPUT_TOKENS=65536
PLATFORM_NOTE=Gemini API (hosted, OpenAI-compatible endpoint)
RUNTIME_NOTE=not disclosed
HARDWARE_NOTE=not disclosed
